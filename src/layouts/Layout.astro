---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Jolotundo Glamping & Edupark - Dian Group",
	description = "Pionir destinasi ekowisata terpadu di lereng Gunung Wilis, Bajulan, Nganjuk. Menghadirkan kemewahan glamping tematik, outbound korporat, eduwisata, dan nuansa hutan pinus berkabut."
} = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono (GoUncharted Editorial Typography) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#0b130e] text-[#f3ede2] antialiased selection:bg-emerald-500 selection:text-white font-sans overflow-x-hidden">
		<slot />

		<!-- Lenis Ultra-Smooth Scroll Engine -->
		<script>
			import Lenis from 'lenis';
			import 'lenis/dist/lenis.css';

			// Konfigurasi "Butter Smooth" (Lerp interpolation ala studio kreatif Awwwards)
			const lenis = new Lenis({
				lerp: 0.065,         // Nilai lerp semakin kecil = semakin halus dan mengapung (floaty luxury glide)
				wheelMultiplier: 0.85, // Menghilangkan loncatan kasar saat roda mouse diputar cepat
				touchMultiplier: 1.4,
				infinite: false,
			});

			// Simpan ke window agar sinkron frame-by-frame dengan animasi parallax
			// @ts-ignore
			window.__lenis = lenis;

			function raf(time: number) {
				lenis.raf(time);
				requestAnimationFrame(raf);
			}
			requestAnimationFrame(raf);

			// Handle klik tombol anchor (#akomodasi, dll) agar meluncur sangat mulus
			document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
				anchor.addEventListener('click', function (e) {
					const href = this.getAttribute('href');
					if (href && href !== '#') {
						e.preventDefault();
						lenis.scrollTo(href, { offset: -20, duration: 1.8 });
					}
				});
			});
		</script>
	</body>
</html>

<style is:global>
	:root {
		--font-sans: 'Plus Jakarta Sans', sans-serif;
		--font-mono: 'JetBrains Mono', monospace;
	}
	body {
		font-family: var(--font-sans);
	}
	.font-mono-tag {
		font-family: var(--font-mono);
	}

	/* Wajib untuk Lenis: matikan native scroll-behavior agar tidak bertabrakan */
	html, body {
		scroll-behavior: auto !important;
	}
	html.lenis, html.lenis body {
		height: auto;
	}
	.lenis.lenis-smooth {
		scroll-behavior: auto !important;
	}
	.lenis.lenis-smooth [data-lenis-prevent] {
		overscroll-behavior: contain;
	}
	.lenis.lenis-stopped {
		overflow: hidden;
	}
	.lenis.lenis-smooth iframe {
		pointer-events: none;
	}
</style>
