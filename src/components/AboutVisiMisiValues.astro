        </div>
      </div>

      <!-- Samping Kanan: Elegant Pagination with Progress & Navigation Controls -->
      <div class="flex items-center gap-4 sm:gap-6 self-start lg:self-end">
        
        <!-- 4 Clickable Slide Number Pills -->
        <div class="flex items-center gap-2 sm:gap-3 text-xs font-mono-tag">
          {valuesSlides.map((slide, idx) => (
            <button 
              type="button"
              class={`values-pg-btn px-1.5 py-0.5 transition-all duration-200 cursor-pointer ${idx === 0 ? 'text-white font-bold text-sm border-b border-white' : 'text-white/40 hover:text-white/80 border-b border-transparent'}`}
