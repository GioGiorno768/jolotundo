<!-- STYLES: MISI TIMELINE SPREAD & PROGRESS TRANSITIONS                       -->
<!-- ========================================================================= -->
<style>
  /* 1:1 GoUncharted Timeline Spread Animation */
  #mission-timeline-wrapper .mission-ruler-line {
    transform: scaleX(0);
    opacity: 0;
    transform-origin: center center;
    transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease-out;
  }

  #mission-timeline-wrapper .mission-tick {
    opacity: 0;
    transform: scaleY(0);
    transform-origin: center center;
    transition: transform 0.45s ease-out 0.25s, opacity 0.45s ease-out 0.25s;
  }

  #mission-timeline-wrapper .mission-col {
    opacity: 0;
    will-change: transform, opacity;
    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease-out;
  }

  /* Desktop spread-out effect */
  @media (min-width: 1024px) {
    #mission-timeline-wrapper .mission-col-1 {
      transform: translate3d(75px, 0, 0);
      transition-delay: 0.15s;
    }
    #mission-timeline-wrapper .mission-col-2 {
      transform: translate3d(25px, 0, 0);
      transition-delay: 0.22s;
    }
    #mission-timeline-wrapper .mission-col-3 {
      transform: translate3d(-25px, 0, 0);
      transition-delay: 0.3s;
    }
    #mission-timeline-wrapper .mission-col-4 {
      transform: translate3d(-75px, 0, 0);
      transition-delay: 0.38s;
    }
  }

  /* Mobile/Tablet slide-up effect */
  @media (max-width: 1023px) {
    #mission-timeline-wrapper .mission-col {
      transform: translate3d(0, 30px, 0);
    }
    #mission-timeline-wrapper .mission-col-1 { transition-delay: 0.1s; }
    #mission-timeline-wrapper .mission-col-2 { transition-delay: 0.2s; }
    #mission-timeline-wrapper .mission-col-3 { transition-delay: 0.3s; }
    #mission-timeline-wrapper .mission-col-4 { transition-delay: 0.4s; }
  }

  /* Triggered State */
  #mission-timeline-wrapper.is-animated .mission-ruler-line {
    transform: scaleX(1);
    opacity: 1;
  }

  #mission-timeline-wrapper.is-animated .mission-tick {
    opacity: 1;
    transform: scaleY(1);
  }

  #mission-timeline-wrapper.is-animated .mission-col {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
</style>

<!-- ========================================================================= -->
<!-- JAVASCRIPT: VISI REVEAL, MISI ANIMATION, & VALUES AUTO PARALLAX SLIDER    -->
<!-- ========================================================================= -->
<script is:inline define:vars={{ valuesSlides }}>
  // 1. Scroll-Driven Visi Text Reveal Engine
  function initVisiScrollTextReveal() {
    const heading = document.getElementById('visi-reveal-heading');
    if (!heading) return;

    const words = heading.querySelectorAll('.visi-reveal-word');
    if (!words || words.length === 0) return;

    const totalWords = words.length;
    let isTicking = false;
    let isVisible = false;

    const updateWords = () => {
      const rect = heading.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      const startTrigger = viewportHeight * 0.85;
      const endTrigger = viewportHeight * 0.32;

      const rawProgress = (startTrigger - rect.top) / (startTrigger - endTrigger);
      const overallProgress = Math.max(0, Math.min(1, rawProgress));

      words.forEach((word, idx) => {
        const wordStart = idx / totalWords;
        const wordEnd = (idx + 1) / totalWords;
        const wordProgress = Math.max(0, Math.min(1, (overallProgress - wordStart) / (wordEnd - wordStart)));
        const opacity = 0.15 + wordProgress * 0.85;
        word.style.opacity = opacity.toFixed(2);
      });

      isTicking = false;
    };

    const onScroll = () => {
      if (!isTicking && isVisible) {
        requestAnimationFrame(updateWords);
        isTicking = true;
      }
    };

    const obs = new IntersectionObserver((entries) => {
      isVisible = entries[0].isIntersecting;
      if (isVisible) updateWords();
    }, { rootMargin: '200px 0px' });
    obs.observe(heading);

    window.addEventListener('scroll', onScroll, { passive: true });
    updateWords();
  }

  // 2. Misi Timeline Spread Animation
  function initMissionTimelineAnimation() {
    const wrapper = document.getElementById('mission-timeline-wrapper');
    if (!wrapper) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          wrapper.classList.add('is-animated');
        }
      });
    }, {
      threshold: 0.15,
      rootMargin: "0px 0px -40px 0px"
    });

    observer.observe(wrapper);
  }

  // 3. 1:1 GoUncharted Values Auto Progress Parallax Slider Engine
  function initValuesParallaxSlider() {
    const section = document.getElementById('our-values-parallax-slider');
    const parallaxLayer = document.getElementById('values-parallax-image-container');
    const slideImages = document.querySelectorAll('.values-bg-slide');
    const progressFill = document.getElementById('values-progress-fill');
    const pgBtns = document.querySelectorAll('.values-pg-btn');
    const prevBtn = document.getElementById('values-prev-btn');
    const nextBtn = document.getElementById('values-next-btn');
    const titleEl = document.getElementById('values-slide-title');
    const descEl = document.getElementById('values-slide-desc');
    const counterEl = document.getElementById('values-counter-current');
    const spec0El = document.getElementById('values-spec-0');
    const spec1El = document.getElementById('values-spec-1');
    const spec2El = document.getElementById('values-spec-2');

    if (!section || !slideImages.length || !valuesSlides.length) return;

    let currentIndex = 0;
    const totalSlides = valuesSlides.length;
    const SLIDE_DURATION = 6000; // 6 seconds per slide
    let slideStartTime = performance.now();
    let isIntersecting = false;
    let animFrameId = null;

    // --- Parallax Translate-Y Engine ---
    function updateValuesParallax() {
      if (!parallaxLayer) return;
      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      if (rect.top <= windowHeight && rect.bottom >= 0) {
        const totalTravel = rect.height + windowHeight;
        const enterProgress = Math.max(0, Math.min(1, (windowHeight - rect.top) / totalTravel));
        // Soft vertical Translate-Y from -60px to +60px
        const translateY = (enterProgress * 120 - 60).toFixed(1);
        parallaxLayer.style.transform = `translate3d(0, ${translateY}px, 0)`;
      }
    }

    // --- Switch Active Slide ---
    function setSlide(newIndex) {
      currentIndex = (newIndex + totalSlides) % totalSlides;
      slideStartTime = performance.now();

      // 1. Cross-fade background images
      slideImages.forEach((img, idx) => {
        if (idx === currentIndex) {
          img.classList.remove('opacity-0');
          img.classList.add('opacity-100');
        } else {
          img.classList.remove('opacity-100');
          img.classList.add('opacity-0');
        }
      });

      // 2. Smooth text swap with subtle transition
      const activeData = valuesSlides[currentIndex];
      if (titleEl && descEl) {
        titleEl.style.opacity = '0';
        descEl.style.opacity = '0';
        setTimeout(() => {
          titleEl.textContent = activeData.title;
          descEl.textContent = activeData.desc;
          titleEl.style.opacity = '1';
          descEl.style.opacity = '1';
        }, 180);
      }

      // 3. Update 3 Specs Bar
      if (spec0El && spec1El && spec2El && activeData.specs) {
        spec0El.textContent = activeData.specs[0].value;
        spec1El.textContent = activeData.specs[1].value;
        spec2El.textContent = activeData.specs[2].value;
      }

      // 4. Update Counter (top)
      if (counterEl) {
        counterEl.textContent = `0${currentIndex + 1}`;
      }

      // 5. Update Right Pagination Numbers
      pgBtns.forEach((btn, idx) => {
        if (idx === currentIndex) {
          btn.className = 'values-pg-btn px-1.5 py-0.5 transition-all duration-200 cursor-pointer text-white font-bold text-sm border-b border-white';
        } else {
          btn.className = 'values-pg-btn px-1.5 py-0.5 transition-all duration-200 cursor-pointer text-white/40 hover:text-white/80 border-b border-transparent';
        }
      });

      // 6. Reset progress bar fill
      if (progressFill) {
        progressFill.style.transform = 'translateX(-100%)';
      }
    }

    // --- Main 60fps Loop: Progress Fill & Auto Advance ---
    function loop(currentTime) {
      if (isIntersecting) {
        const elapsed = currentTime - slideStartTime;
        const progress = Math.max(0, Math.min(1, elapsed / SLIDE_DURATION));

        // Update single smooth progress bar
        if (progressFill) {
          const translateX = (progress - 1) * 100;
          progressFill.style.transform = `translateX(${translateX.toFixed(2)}%)`;
        }

        // Auto Advance when finished
        if (progress >= 1) {
          setSlide(currentIndex + 1);
        }
      }

      animFrameId = requestAnimationFrame(loop);
    }

    // --- Interactive Pagination Number Clicks ---
    pgBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetIdx = parseInt(btn.getAttribute('data-pg-index') || '0', 10);
        setSlide(targetIdx);
      });
    });

    // --- Navigation Arrows ---
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        setSlide(currentIndex - 1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        setSlide(currentIndex + 1);
      });
    }

    // --- IntersectionObserver for Visibility & Parallax Listener ---
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const wasIntersecting = isIntersecting;
        isIntersecting = entry.isIntersecting;
        if (isIntersecting && !wasIntersecting) {
          updateValuesParallax();
        }
      });
    }, { rootMargin: '200px 0px' });

    observer.observe(section);

    window.addEventListener('scroll', () => {
      if (isIntersecting) {
        requestAnimationFrame(updateValuesParallax);
      }
    }, { passive: true });

    // Initial setup
    setSlide(0);
    animFrameId = requestAnimationFrame(loop);
  }

  function setupVisiMisiValues() {
    initVisiScrollTextReveal();
    initMissionTimelineAnimation();
    initValuesParallaxSlider();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupVisiMisiValues);
  } else {
    setupVisiMisiValues();
  }
</script>
