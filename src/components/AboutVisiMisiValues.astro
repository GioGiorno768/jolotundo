        <!-- Far-Right Closing Tick Mark (Aligned exactly with end of Column 4 at 100%) -->
        <div class="mission-tick mission-tick-end absolute top-0 right-0 w-[1.5px] h-[20px] bg-[#141110] hidden lg:block"></div>

        <!-- 4 Columns Grid (Equal 25% sectors with internal padding so ticks sit at 0%, 25%, 50%, 75%, 100%) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-y-10 sm:gap-y-12 lg:gap-0">
          {misiList.map((misi, idx) => (
            <div 
              class={`mission-col mission-col-${idx + 1} relative pt-6 lg:pt-8 flex flex-col group ${
                idx === 0 
                  ? 'lg:pr-8 xl:pr-10 lg:pl-0' 
