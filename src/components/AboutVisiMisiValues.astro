          <span class="text-[10px] sm:text-xs font-mono-tag text-white/50 tracking-widest uppercase block mb-1">
            {valuesSlides[0].specs[2].label}
          </span>
          <span id="values-spec-2" class="text-xs sm:text-sm font-medium text-white font-sans block leading-tight">
            {valuesSlides[0].specs[2].value}
