<!-- ========================================================================= -->
<!-- SECTION 1 & 2: VISI & MISI (GoUncharted Light Stone Canvas)               -->
<!-- ========================================================================= -->
<section id="visi-misi" class="relative z-10 bg-[#f4efe6] text-[#141110] py-24 sm:py-32 px-6 sm:px-10 lg:px-14 xl:px-20 border-b border-[#141110]/15">
  <div class="max-w-[1540px] mx-auto space-y-20 sm:space-y-28">

    <!-- 1. THE VISION STATEMENT (Full-Width Minimalist Centered Typography Banner) -->
    <div class="border-b border-[#141110]/15 pb-16 sm:pb-24 flex flex-col items-center text-center max-w-5xl mx-auto">
      
      <div class="flex items-center justify-center gap-2 text-xs font-mono-tag text-[#141110]/50 tracking-[0.25em] uppercase mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-800"></span>
        <span>VISI KAMI // OUR VISION</span>
      </div>

      <blockquote 
        id="visi-reveal-heading"
        class="text-2xl sm:text-4xl md:text-5xl lg:text-[46px] font-normal tracking-tight text-[#141110] font-sans leading-[1.24] max-w-4xl mx-auto text-center"
      >
        {visiWords.map((word) => (
          <span 
            class="visi-reveal-word inline-block mr-[0.24em] transition-opacity duration-150 ease-out will-change-[opacity]" 
            style="opacity: 0.15;"
          >
            {word}
          </span>
        ))}
      </blockquote>

      <div class="mt-8 flex items-center justify-center gap-4 text-xs font-mono-tag text-[#141110]/60 uppercase tracking-wider">
        <span>— KOMITMEN RESMI DIREKSI DAN GROUP</span>
        <span>•</span>
        <span>EST. 2023</span>
      </div>

    </div>

    <!-- 2. FOUR STRATEGIC MISSIONS (1:1 GoUncharted Timeline / Ruler Architecture with Spread Animation) -->
    <div class="space-y-12 sm:space-y-16">
      
