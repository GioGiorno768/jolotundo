<style>
  @keyframes partnerMarquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: partnerMarquee 50s linear infinite;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  /* Monokrom Muted saat diam, Full Color saat di-hover */
  .logo-item {
    display: flex;
    align-items: center;
    filter: grayscale(100%) opacity(45%) contrast(85%);
    transition: filter 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .logo-item:hover {
    filter: grayscale(0%) opacity(100%) contrast(100%);
    transform: scale(1.08);
  }
</style>
