---
import activities from '../data/activities.json';
import siteData from '../data/siteData.json';

const titleWords = ["AKTIVITAS", "KAMI"];
const introPart1 = "Menembus belantara pinus purba, memacu adrenalin di jalur bebatuan liar,".split(" ");
const introPart2 = "dan merayakan kebebasan sejati di pelukan Gunung Wilis.".split(" ");
---

<!-- 
  SECTION 03 // WANA WISATA & PETUALANGAN
  - GoUncharted Editorial Infinite Auto-Slide Carousel
  - 1:1 Reference Architecture from GoUncharted Desktop & Mobile
  - Non-Sticky: Normal, natural page scrolling with zero scroll hijacking or sticky traps
  - Infinite Auto-Slide with Smooth Crossfade & Segmented Progress Bar
  - Desktop: Edge-to-edge landscape with 5-column glass bottom metadata bar
  - Mobile: Clean stacked horizontal rows with hairline dividers (1:1 with GoUncharted mobile)
  - Interactive: Clickable segment indicators, prev/next arrows, pause on hover/touch, swipeable on mobile
-->
<section id="wahana" class="relative z-20 w-full min-w-full select-none bg-[#f4efe6]">
  
  <!-- ========================================================================= -->
  <!-- 1. TRANSITION INTRO: Centered Typographic Statement with Word-by-Word Reveal -->
  <!-- ========================================================================= -->
  <div class="relative w-full bg-[#f4efe6] text-[#141110] border-t border-[#141110]/15 py-16 sm:py-24 px-6 sm:px-10 lg:px-16 flex flex-col items-center justify-center text-center overflow-hidden">
    
    <div id="activities-intro-heading" class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
      
      <!-- Top Eyebrow Tag -->
      <div class="flex items-center gap-2.5 text-xs font-mono-tag tracking-widest text-[#141110]/70 uppercase mb-5 sm:mb-6">
        <span class="w-2 h-2 bg-emerald-700 animate-pulse"></span>
        <span>WANA WISATA & PETUALANGAN</span>
      </div>

      <!-- Giant Centered Title "AKTIVITAS KAMI" -->
      <h2 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold uppercase tracking-tight text-[#141110] mb-5 sm:mb-6 leading-none font-sans">
        {titleWords.map((word) => (
          <span 
            class="activity-reveal-word inline-block mx-2 sm:mx-3 transition-opacity duration-150 ease-out will-change-[opacity]"
            style="opacity: 0.18;"
          >
            {word}
          </span>
        ))}
      </h2>

      <!-- Narrative Statement with Word-by-Word Scroll Reveal -->
      <p class="text-base sm:text-xl md:text-2xl lg:text-[1.65rem] leading-relaxed max-w-3xl mx-auto font-light tracking-normal text-[#141110]">
        <span class="text-[#141110]/90">
          {introPart1.map((word) => (
            <span 
              class="activity-reveal-word inline-block mr-[0.24em] transition-opacity duration-150 ease-out will-change-[opacity]"
              style="opacity: 0.18;"
            >
              {word}
            </span>
          ))}
        </span>
        <span class="text-emerald-950 font-medium">
          {introPart2.map((word) => (
            <span 
              class="activity-reveal-word inline-block mr-[0.24em] transition-opacity duration-150 ease-out will-change-[opacity]"
              style="opacity: 0.18;"
            >
              {word}
            </span>
          ))}
        </span>
      </p>

    </div>

  </div>

  <!-- ========================================================================= -->
  <!-- 2. GOUNCHARTED INFINITE AUTO-SLIDE CAROUSEL (1:1 Desktop & Mobile Match) -->
  <!-- ========================================================================= -->
  <div 
    id="activities-carousel" 
    class="relative w-full overflow-hidden bg-[#0b130e] text-[#f4efe6] select-none h-[600px] sm:h-[660px] lg:h-[700px] xl:h-[740px]"
  >
    <!-- TOP FLOATING CONTROLS (Index Badge + 6 Segmented Progress Bars + Prev/Next Arrows) -->
    <div class="absolute top-5 left-5 right-5 sm:top-7 sm:left-10 sm:right-10 z-30 flex items-center justify-between pointer-events-auto">
      
      <!-- Left: Slide Index Badge & Activity Name -->
      <div class="flex items-center gap-2 sm:gap-3">
        <span id="carousel-badge-index" class="px-2.5 py-1 bg-[#d8c39e] text-black font-mono-tag text-[11px] sm:text-xs font-bold tracking-widest uppercase transition-all duration-300">
          01 / {String(activities.length).padStart(2, '0')}
        </span>
        <span id="carousel-badge-name" class="text-xs sm:text-sm font-mono-tag tracking-[0.18em] text-[#d8c39e] uppercase font-bold drop-shadow transition-opacity duration-300">
          {activities[0].name}
        </span>
      </div>

      <!-- Right: Segmented Progress Bars & Arrows -->
      <div class="flex items-center gap-2.5 sm:gap-4">
        <!-- 6 Segmented Progress Bars (Clickable to Jump Directly!) -->
        <div class="flex items-center gap-1 sm:gap-1.5 w-24 sm:w-40 h-1">
          {activities.map((_, i) => (
            <button 
              type="button" 
              class="carousel-segment-btn relative flex-1 h-[2px] sm:h-[2.5px] bg-white/25 overflow-hidden hover:h-[3.5px] transition-all cursor-pointer focus:outline-none"
              data-target-index={i}
              title={`Ke aktivitas ${i + 1}`}
              aria-label={`Ke aktivitas ${i + 1}`}
            >
              <div 
                class="carousel-progress-fill h-full bg-[#d8c39e]" 
                style={i === 0 ? "width: 0%;" : "width: 0%;"}
              ></div>
            </button>
          ))}
        </div>

        <!-- Prev & Next Arrows -->
        <div class="flex items-center gap-1">
          <button 
            id="carousel-prev-btn" 
            type="button" 
            aria-label="Aktivitas Sebelumnya"
            class="w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center bg-black/60 hover:bg-black/90 text-white border border-white/20 transition-all cursor-pointer hover:border-white/50 active:scale-95"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button 
            id="carousel-next-btn" 
            type="button" 
            aria-label="Aktivitas Selanjutnya"
            class="w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center bg-black/60 hover:bg-black/90 text-white border border-white/20 transition-all cursor-pointer hover:border-white/50 active:scale-95"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>

    </div>

    <!-- CAROUSEL SLIDES STACK -->
    <div id="carousel-slides-container" class="relative w-full h-full">
      {activities.map((act, idx) => (
        <article 
          class={`activity-slide absolute inset-0 w-full h-full transition-opacity duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] ${
            idx === 0 ? "opacity-100 z-10 pointer-events-auto" : "opacity-0 z-0 pointer-events-none"
          }`}
          data-slide-index={idx}
        >
          <!-- Background Image -->
          <div class="absolute inset-0 w-full h-full overflow-hidden">
            <img 
              src={act.image} 
              alt={act.name + " - Wana Wisata Jolotundo Glamping & Edupark"} 
              class="w-full h-full object-cover object-center transform scale-100 transition-transform duration-1000 ease-out"
              loading={idx === 0 ? "eager" : "lazy"}
              decoding="async"
            />
            
            <!-- Atmospheric Dark Overlays (Transparent GoUncharted Contrast Model) -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent pointer-events-none"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-black/45 via-transparent to-transparent pointer-events-none"></div>
          </div>

          <!-- Slide Content Layer Docked at Bottom -->
          <div class="relative z-20 w-full h-full flex flex-col justify-end">
            
            <!-- Headline: Light, Crisp, Large (Exact 1:1 Match to GoUncharted "When the granite turns red") -->
            <div class="px-5 sm:px-10 lg:px-14 xl:px-16 pb-3 sm:pb-6 max-w-4xl">
              <h3 class="text-2xl sm:text-4xl lg:text-[3rem] xl:text-[3.3rem] font-light tracking-tight text-white uppercase leading-[1.04] font-sans drop-shadow-md">
                {act.headline}
              </h3>
            </div>

            <!-- ============================================================== -->
            <!-- DESKTOP METADATA BAR (1:1 with GoUncharted: Pure Transparent)   -->
            <!-- ============================================================== -->
            <div class="hidden lg:grid grid-cols-12 divide-x divide-white/20 bg-transparent border-t border-white/20 select-none">
              
              <!-- Column 1: MEDAN JALUR -->
              <div class="col-span-2 p-4 xl:p-5 flex flex-col justify-between">
                <span class="text-[10px] font-mono-tag text-white/50 tracking-widest uppercase block mb-1">
                  {act.metrics[0].label}
                </span>
                <div class="text-[13px] xl:text-sm font-normal text-white/95 leading-snug truncate">
                  {act.metrics[0].value}
                </div>
              </div>

              <!-- Column 2: DURASI TRIP -->
              <div class="col-span-2 p-4 xl:p-5 flex flex-col justify-between">
                <span class="text-[10px] font-mono-tag text-white/50 tracking-widest uppercase block mb-1">
                  {act.metrics[1].label}
                </span>
                <div class="text-[13px] xl:text-sm font-normal text-white/95 leading-snug truncate">
                  {act.metrics[1].value}
                </div>
              </div>

              <!-- Column 3: KAPASITAS -->
              <div class="col-span-2 p-4 xl:p-5 flex flex-col justify-between">
                <span class="text-[10px] font-mono-tag text-white/50 tracking-widest uppercase block mb-1">
                  {act.metrics[2].label}
                </span>
                <div class="text-[13px] xl:text-sm font-normal text-white/95 leading-snug truncate">
                  {act.metrics[2].value}
                </div>
              </div>

              <!-- Column 4: LEVEL TANTANGAN -->
              <div class="col-span-2 p-4 xl:p-5 flex flex-col justify-between">
                <span class="text-[10px] font-mono-tag text-white/50 tracking-widest uppercase block mb-1">
                  {act.metrics[3].label}
                </span>
                <div class="text-[13px] xl:text-sm font-normal text-white/95 leading-snug truncate">
                  {act.metrics[3].value}
                </div>
              </div>

              <!-- Column 5: DETAIL WAHANA (matching WHY THIS WEEK in GoUncharted) + CTA -->
              <div class="col-span-4 p-4 xl:p-5 flex items-center justify-between gap-4">
                <div class="flex flex-col justify-center min-w-0 pr-2">
                  <span class="text-[10px] font-mono-tag text-white/50 tracking-widest uppercase block mb-1">
                    DETAIL WAHANA
                  </span>
                  <p class="text-xs text-white/85 font-light leading-relaxed line-clamp-2">
                    {act.tagline}
                  </p>
                </div>
                
                <a
                  href={`https://wa.me/${siteData.brand.whatsapp}?text=${encodeURIComponent(`Halo Admin Jolotundo, saya ingin reservasi & tahu detail aktivitas *${act.name}*.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="shrink-0 px-4 py-2.5 bg-white hover:bg-[#d8c39e] text-[#141110] font-mono-tag text-xs font-bold uppercase tracking-wider transition-all duration-200 border border-white inline-flex items-center gap-1.5 shadow-md active:scale-95"
                >
                  <span>Detail</span>
                  <span>↗</span>
                </a>
              </div>

            </div>

            <!-- ============================================================== -->
            <!-- MOBILE METADATA BAR (1:1 with GoUncharted: Pure Transparent)    -->
            <!-- ============================================================== -->
            <div class="lg:hidden flex flex-col divide-y divide-white/15 bg-transparent border-t border-white/20 select-none">
              
              <!-- Row 1 -->
              <div class="px-5 py-2 flex flex-col">
                <span class="text-[8.5px] font-mono-tag text-white/50 tracking-widest uppercase block mb-0.5 leading-none">
                  {act.metrics[0].label}
                </span>
                <span class="text-[11.5px] font-normal text-white/95 leading-tight">
                  {act.metrics[0].value}
                </span>
              </div>

              <!-- Row 2 -->
              <div class="px-5 py-2 flex flex-col">
                <span class="text-[8.5px] font-mono-tag text-white/50 tracking-widest uppercase block mb-0.5 leading-none">
                  {act.metrics[1].label}
                </span>
                <span class="text-[11.5px] font-normal text-white/95 leading-tight">
                  {act.metrics[1].value}
                </span>
              </div>

              <!-- Row 3 -->
              <div class="px-5 py-2 flex flex-col">
                <span class="text-[8.5px] font-mono-tag text-white/50 tracking-widest uppercase block mb-0.5 leading-none">
                  {act.metrics[2].label}
                </span>
                <span class="text-[11.5px] font-normal text-white/95 leading-tight">
                  {act.metrics[2].value}
                </span>
              </div>

              <!-- Row 4: DETAIL WAHANA (matching WHY THIS WEEK in GoUncharted Screenshot 2) -->
              <div class="px-5 py-2 flex flex-col">
                <span class="text-[8.5px] font-mono-tag text-white/50 tracking-widest uppercase block mb-0.5 leading-none">
                  DETAIL WAHANA
                </span>
                <p class="text-[11px] text-white/85 font-light leading-snug line-clamp-2">
                  {act.tagline}
                </p>
              </div>

              <!-- Row 5: Action Link -->
              <div class="px-5 py-2.5 flex items-center justify-between">
                <span class="text-[10px] font-mono-tag text-[#d8c39e] uppercase tracking-wider font-semibold">
                  {act.name}
                </span>
                <a
                  href={`https://wa.me/${siteData.brand.whatsapp}?text=${encodeURIComponent(`Halo Admin Jolotundo, saya ingin tahu informasi & reservasi untuk aktivitas *${act.name}*.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-3.5 py-1.5 bg-[#f4efe6] hover:bg-white text-black font-mono-tag text-[10.5px] font-bold uppercase tracking-wider transition-colors inline-flex items-center gap-1 active:scale-95"
                >
                  <span>Reservasi</span>
                  <span>↗</span>
                </a>
              </div>

            </div>

          </div>
        </article>
      ))}
    </div>

  </div>

</section>

<!-- ========================================================================= -->
<!-- JAVASCRIPT: Auto-Slide Infinite Engine + Intro Word Reveal                -->
<!-- ========================================================================= -->
<script is:inline define:vars={{ activitiesData: activities, brandWa: siteData.brand.whatsapp }}>
  // 1. Word-by-Word Scroll Reveal for "AKTIVITAS KAMI" Intro
  function initActivitiesReveal() {
    const container = document.getElementById('activities-intro-heading');
    if (!container) return;

    const words = container.querySelectorAll('.activity-reveal-word');
    if (!words || words.length === 0) return;

    const totalWords = words.length;
    let isTicking = false;
    let isVisible = false;

    const updateWords = () => {
      const rect = container.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      const startTrigger = viewportHeight * 0.85;
      const endTrigger = viewportHeight * 0.35;

      const rawProgress = (startTrigger - rect.top) / (startTrigger - endTrigger);
      const overallProgress = Math.max(0, Math.min(1, rawProgress));

      words.forEach((word, idx) => {
        const wordStart = idx / totalWords;
        const wordEnd = (idx + 1) / totalWords;
        const wordProgress = Math.max(0, Math.min(1, (overallProgress - wordStart) / (wordEnd - wordStart)));
        const opacity = 0.18 + wordProgress * 0.82;
        word.style.opacity = opacity.toFixed(2);
      });
      isTicking = false;
    };

    const onScroll = () => {
      if (!isTicking && isVisible) {
        requestAnimationFrame(updateWords);
        isTicking = true;
      }
    };

    const obs = new IntersectionObserver((entries) => {
      isVisible = entries[0].isIntersecting;
      if (isVisible) updateWords();
    }, { rootMargin: '150px 0px' });
    obs.observe(container);

    window.addEventListener('scroll', onScroll, { passive: true });
    updateWords();
  }

  // 2. GoUncharted Infinite Auto-Slide Carousel Engine
  function initActivitiesCarousel() {
    const carousel = document.getElementById('activities-carousel');
    if (!carousel) return;

    const slides = carousel.querySelectorAll('.activity-slide');
    const segmentButtons = carousel.querySelectorAll('.carousel-segment-btn');
    const progressFills = carousel.querySelectorAll('.carousel-progress-fill');
    const badgeIndex = document.getElementById('carousel-badge-index');
    const badgeName = document.getElementById('carousel-badge-name');
    const prevBtn = document.getElementById('carousel-prev-btn');
    const nextBtn = document.getElementById('carousel-next-btn');

    const totalSlides = slides.length;
    if (totalSlides === 0) return;

    const SLIDE_DURATION = 5500; // 5.5 seconds per activity slide
    let currentIndex = 0;
    let autoSlideTimer = null;
    let isHovered = false;
    let isIntersecting = false;

    // Switch to active slide with butter-smooth crossfade
    function goToSlide(targetIdx) {
      currentIndex = (targetIdx + totalSlides) % totalSlides;
      const act = activitiesData[currentIndex];

      // 1. Crossfade slides
      slides.forEach((slide, i) => {
        if (i === currentIndex) {
          slide.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
          slide.classList.add('opacity-100', 'z-10', 'pointer-events-auto');
        } else {
          slide.classList.remove('opacity-100', 'z-10', 'pointer-events-auto');
          slide.classList.add('opacity-0', 'z-0', 'pointer-events-none');
        }
      });

      // 2. Update Badge & Name
      if (badgeIndex) {
        badgeIndex.innerText = `${act.index} / ${String(totalSlides).padStart(2, '0')}`;
      }
      if (badgeName) {
        badgeName.innerText = act.name;
      }

      // 3. Update & Animate 6 Segment Progress Bars
      progressFills.forEach((fill, i) => {
        if (i < currentIndex) {
          fill.style.transition = 'none';
          fill.style.width = '100%';
        } else if (i === currentIndex) {
          fill.style.transition = 'none';
          fill.style.width = '0%';
          // Trigger smooth filling over SLIDE_DURATION
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              if (!isHovered && isIntersecting) {
                fill.style.transition = `width ${SLIDE_DURATION}ms linear`;
                fill.style.width = '100%';
              }
            });
          });
        } else {
          fill.style.transition = 'none';
          fill.style.width = '0%';
        }
      });

      // 4. Schedule next auto slide
      clearTimeout(autoSlideTimer);
      if (!isHovered && isIntersecting) {
        autoSlideTimer = setTimeout(() => {
          goToSlide(currentIndex + 1);
        }, SLIDE_DURATION);
      }
    }

    // Prev / Next button listeners
    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        goToSlide(currentIndex - 1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        goToSlide(currentIndex + 1);
      });
    }

    // Segment direct jump listeners
    segmentButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const target = parseInt(btn.getAttribute('data-target-index') || '0', 10);
        goToSlide(target);
      });
    });

    // Pause on Hover (Desktop)
    carousel.addEventListener('mouseenter', () => {
      isHovered = true;
      clearTimeout(autoSlideTimer);
      // Freeze active progress fill
      const activeFill = progressFills[currentIndex];
      if (activeFill) {
        const computedWidth = window.getComputedStyle(activeFill).width;
        activeFill.style.transition = 'none';
        activeFill.style.width = computedWidth;
      }
    });

    carousel.addEventListener('mouseleave', () => {
      isHovered = false;
      goToSlide(currentIndex); // resume slide
    });

    // Swipe Support on Mobile Touch
    let touchStartX = 0;
    let touchEndX = 0;

    carousel.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      isHovered = true;
      clearTimeout(autoSlideTimer);
    }, { passive: true });

    carousel.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      isHovered = false;
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > 40) {
        if (diff < 0) {
          goToSlide(currentIndex + 1); // Swiped Left -> Next
        } else {
          goToSlide(currentIndex - 1); // Swiped Right -> Prev
        }
      } else {
        goToSlide(currentIndex);
      }
    }, { passive: true });

    // IntersectionObserver: Only run auto-slide when carousel is visible
    const carouselObs = new IntersectionObserver((entries) => {
      isIntersecting = entries[0].isIntersecting;
      if (isIntersecting) {
        goToSlide(currentIndex);
      } else {
        clearTimeout(autoSlideTimer);
        const activeFill = progressFills[currentIndex];
        if (activeFill) {
          activeFill.style.transition = 'none';
        }
      }
    }, { rootMargin: '100px 0px' });

    carouselObs.observe(carousel);

    // Initial Start
    goToSlide(0);
  }

  // Initialize modules
  function initAll() {
    initActivitiesReveal();
    initActivitiesCarousel();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
</script>
