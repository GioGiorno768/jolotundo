    </div>

    <!-- Editorial Key Metrics / Clean Stats Strip (Clean GoUncharted Architecture) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 pt-12 border-t border-[#141110]/15">
      {editorialStats.map((stat) => (
        <div class="stat-card flex flex-col justify-between group cursor-pointer">
          <div>
            <div class="text-[11px] font-mono-tag text-[#141110]/50 uppercase tracking-widest mb-4">
              [ {stat.code} // {stat.tag} ]
            </div>
            
            <div class="flex items-baseline gap-2 mb-2">
              <span 
                class="scramble-stat text-4xl sm:text-5xl lg:text-6xl font-light tracking-tight text-[#141110] font-sans group-hover:text-emerald-950 transition-colors inline-block tabular-nums min-w-[2ch]"
                data-scramble={stat.value}
              >
                {stat.value}
              </span>
              {stat.unit && (
                <span class="text-xs font-mono-tag text-[#141110]/60 uppercase tracking-wider font-semibold">
                  {stat.unit}
                </span>
              )}
            </div>

            <h3 class="text-xs font-mono-tag font-semibold text-[#141110] uppercase tracking-wider mb-2">
              {stat.label}
            </h3>

            <p class="text-xs sm:text-sm text-[#141110]/70 leading-relaxed font-light">
              {stat.desc}
            </p>
          </div>

          <div class="mt-6 pt-3 border-t border-[#141110]/10 flex items-center justify-between text-[11px] font-mono-tag text-[#141110]/40">
            <span>OFFICIAL DATA</span>
            <span class="group-hover:text-emerald-800 group-hover:translate-x-0.5 transition-transform">→</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Partner Rail Marquee (Koleksi 100+ Klien BUMN & Korporat dari Slide 20) -->
    <div class="pt-8 border-t border-[#141110]/15 flex flex-col gap-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs font-mono-tag text-[#141110]/70 tracking-wider uppercase gap-2">
        <span class="font-semibold text-[#141110]">
          [ DIPERCAYA OLEH 100+ INSTANSI BUMN, PERBANKAN & KORPORASI NASIONAL ]
        </span>
        <span class="text-[#141110]/50">OFFICIAL GATHERING & OUTBOUND PARTNER</span>
      </div>

      <!-- Vector SVG Logo Marquee Component -->
      <PartnerMarquee />
    </div>

  </div>
</section>

<!-- Scrollytelling Script: Word-by-Word Smooth Opacity Reveal synced with Lenis -->
<script>
  function initScrollTextReveal() {
    const heading = document.getElementById('manifesto-reveal-heading');
    if (!heading) return;

    const words = heading.querySelectorAll<HTMLElement>('.reveal-word');
    if (!words || words.length === 0) return;

    const totalWords = words.length;
    let isTicking = false;
    let isVisible = false;

    const updateWords = () => {
      const rect = heading.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      const startTrigger = viewportHeight * 0.82;
      const endTrigger = viewportHeight * 0.36;

      const rawProgress = (startTrigger - rect.top) / (startTrigger - endTrigger);
      const overallProgress = Math.max(0, Math.min(1, rawProgress));

      words.forEach((word, idx) => {
        const wordStart = idx / totalWords;
        const wordEnd = (idx + 1) / totalWords;
        const wordProgress = Math.max(0, Math.min(1, (overallProgress - wordStart) / (wordEnd - wordStart)));
        const opacity = 0.18 + wordProgress * 0.82;
        word.style.opacity = opacity.toFixed(2);
      });
      isTicking = false;
    };

    const onScroll = () => {
      if (!isTicking && isVisible) {
        requestAnimationFrame(updateWords);
        isTicking = true;
      }
    };

    const obs = new IntersectionObserver((entries) => {
      isVisible = entries[0].isIntersecting;
      if (isVisible) updateWords();
    }, { rootMargin: '150px 0px' });
    obs.observe(heading);

    window.addEventListener('scroll', onScroll, { passive: true });
    updateWords();
  }

  // --- Scramble Text Decryption Effect untuk Stats Angka ---
  function initScrambleStats() {
    const statElements = document.querySelectorAll<HTMLElement>('.scramble-stat');
    if (!statElements || statElements.length === 0) return;

    const chars = "0123456789#%*+=-";

    function scramble(el: HTMLElement, duration = 750) {
      const target = el.dataset.scramble || el.textContent || "";
      if (!target) return;

      const length = target.length;
      const fps = 30;
      const totalFrames = Math.max(12, Math.round((duration / 1000) * fps));
      let frame = 0;

      // Hentikan timer sebelumnya jika ada
      const activeTimer = (el as any).__scrambleTimer;
      if (activeTimer) {
        clearInterval(activeTimer);
      }

      const timer = setInterval(() => {
        frame++;
        const progress = frame / totalFrames;

        let result = "";
        for (let i = 0; i < length; i++) {
          // Ambang batas kapan karakter asli mengunci (lock-in)
          const charThreshold = (i + 1) / (length + 0.4);
          if (progress >= charThreshold) {
            result += target[i];
          } else {
            result += chars[Math.floor(Math.random() * chars.length)];
          }
        }

        el.textContent = result;

        if (frame >= totalFrames) {
          clearInterval(timer);
          (el as any).__scrambleTimer = null;
          el.textContent = target;
        }
      }, 1000 / fps);

      (el as any).__scrambleTimer = timer;
    }

    // Observer saat elemen masuk ke layar (enter screen)
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          scramble(el, 800);
          observer.unobserve(el);
        }
      });
    }, {
      threshold: 0.3,
      rootMargin: "0px 0px -40px 0px"
    });

    statElements.forEach((el) => {
      observer.observe(el);

      // Re-trigger scramble saat kolom di-hover pengunjung
      const parentCard = el.closest<HTMLElement>('.stat-card');
      if (parentCard) {
        parentCard.addEventListener('mouseenter', () => {
          scramble(el, 480);
        });
      }
    });
  }

  function setupAboutManifesto() {
    initScrollTextReveal();
    initScrambleStats();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAboutManifesto);
  } else {
    setupAboutManifesto();
  }
</script>


