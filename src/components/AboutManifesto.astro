---
import siteData from '../data/siteData.json';

const pillars = [
  {
    code: "01",
    name: "Sustainability",
    title: "Kelestarian Ekosistem",
    desc: "Menjaga keasrian hutan pinus dan kejernihan mata air lereng Gunung Wilis dengan praktik ramah lingkungan."
  },
  {
    code: "02",
    name: "Empowerment",
    title: "Pemberdayaan Desa",
    desc: "Membuka lapangan kerja dan memajukan perekonomian warga lokal Desa Bajulan secara inklusif."
  },
  {
    code: "03",
    name: "Education",
    title: "Ekowisata & Karakter",
    desc: "Mengintegrasikan liburan alam dengan modul edukasi interaktif, outbound, dan pelestarian flora-fauna."
  },
  {
    code: "04",
    name: "Hospitality",
    title: "Kebaruan Layanan",
    desc: "Standarisasi kenyamanan akomodasi modern setara resor bintang lima di tengah ketenangan alam bebas."
  }
];

const partners = [
  "PERTAMINA",
  "PT KERETA API INDONESIA",
  "BANK MANDIRI",
  "SEMEN INDONESIA (SIG)",
  "PT INKA",
  "PERUM BULOG",
  "PEGADAIAN",
  "BANK JATIM",
  "YAMAHA MOTOR",
  "RSUD DR. SOEGIRI",
  "BKD TULUNGAGUNG"
];
---

<!-- 
  SECTION 02: ABOUT & MANIFESTO (GoUncharted Editorial Style)
  - Transisi dari Dark Hero menuju Warm Stone Canvas (#F5F1EA / #FAF7F0)
  - Tipografi raksasa font-light dengan kontras charcoal (#141110)
  - Partner Rail Marquee di bagian bawah
-->
<section id="tentang" class="relative z-20 bg-[#f5f1ea] text-[#141110] py-24 sm:py-32 px-6 sm:px-10 lg:px-14 xl:px-20 transition-colors duration-300">
  <div class="max-w-[1680px] mx-auto flex flex-col gap-20 sm:gap-28">

    <!-- Top Eyebrow Tag -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-8 border-b border-[#141110]/15 gap-4">
      <div class="flex items-center gap-2.5 text-xs font-mono-tag text-[#141110]/70 tracking-widest uppercase">
        <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
        <span>[ 01 // OUR MANIFESTO & PHILOSOPHY ]</span>
      </div>
      <div class="text-xs font-mono-tag text-[#141110]/60 uppercase tracking-wider">
        DANGROUP ECOSYSTEM • BAJULAN, NGANJUK
      </div>
    </div>

    <!-- Main Statement Grid (Besar, Bold/Light, Editorial Lookbook) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Left Column: Big Lit Statement -->
      <div class="lg:col-span-8 flex flex-col">
        <h2 class="text-3xl sm:text-5xl md:text-6xl lg:text-[4rem] xl:text-[4.6rem] font-light tracking-[-0.03em] leading-[1.08] text-[#141110]">
          Ketika gemercik air sungai alami, sejuknya pinus lereng Wilis, dan keheningan menyatu — <span class="font-bold text-emerald-950">di sanalah istirahat menemukan makna sesungguhnya.</span>
        </h2>
      </div>

      <!-- Right Column: Narrative Story & Transformation -->
      <div class="lg:col-span-4 flex flex-col justify-between h-full pt-2">
        <div class="space-y-5 text-sm sm:text-base text-[#141110]/80 font-light leading-relaxed">
          <p>
            Banyak destinasi menawarkan sekadar tenda untuk bermalam. Di <strong>Jolotundo Glamping & Edupark</strong>, kami membangun ekosistem ekowisata terpadu yang dirancang dari hati.
          </p>
          <p>
            Berawal dari 4 tenda konsolidasi internal <strong>DANGROUP</strong> untuk gathering privat, kawasan ini resmi bertransformasi pada 2023 menjadi pusat ekowisata alam, outbound korporat, edupark interaktif, serta penginapan tematik berkonsep keberlanjutan.
          </p>
        </div>

        <!-- Read More Action / WA Link -->
        <div class="pt-8">
          <a
            href={"https://wa.me/" + siteData.brand.whatsapp + "?text=Halo%20Admin%20Jolotundo,%20saya%20ingin%20tanya%20profil%20dan%20kunjungan."}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 text-xs sm:text-sm font-mono-tag font-semibold text-[#141110] hover:text-emerald-800 tracking-wider uppercase border-b-2 border-[#141110] pb-1 transition-all group"
          >
            <span>Pelajari Selengkapnya</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Four Pillars Grid (GoUncharted Feature Stack) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 pt-4 border-t border-[#141110]/15">
      {pillars.map((pillar) => (
        <div class="flex flex-col justify-between p-6 sm:p-7 rounded-2xl bg-white/60 border border-[#141110]/10 hover:border-[#141110]/30 transition-all duration-300 hover:shadow-lg group">
          <div>
            <div class="flex items-center justify-between text-xs font-mono-tag text-[#141110]/60 mb-6">
              <span>[ {pillar.code} ]</span>
              <span class="text-[10px] uppercase tracking-widest text-emerald-800 font-semibold">{pillar.name}</span>
            </div>
            <h3 class="text-xl font-bold text-[#141110] mb-2.5 tracking-tight group-hover:text-emerald-900 transition-colors">
              {pillar.title}
            </h3>
            <p class="text-xs sm:text-sm text-[#141110]/70 leading-relaxed font-light">
              {pillar.desc}
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-[#141110]/10 flex justify-end">
            <span class="text-xs font-mono-tag text-[#141110]/40 group-hover:text-[#141110] transition-colors">↗</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Partner Rail Marquee (Koleksi 50+ Klien BUMN & Korporat) -->
    <div class="pt-8 border-t border-[#141110]/15 flex flex-col gap-6">
      <div class="flex items-center justify-between text-xs font-mono-tag text-[#141110]/60 tracking-wider uppercase">
        <span>[ DIPERCAYA OLEH 50+ INSTANSI BUMN & KORPORAT NASIONAL ]</span>
        <span class="hidden sm:inline">OFFICIAL GATHERING PARTNER</span>
      </div>

      <!-- Marquee Strip with Vanilla CSS infinite scroll -->
      <div class="relative w-full overflow-hidden py-4 border-y border-[#141110]/10">
        <div class="marquee-track flex items-center gap-12 whitespace-nowrap">
          {partners.concat(partners).map((partner) => (
            <div class="flex items-center gap-12">
              <span class="text-base sm:text-lg font-bold font-mono-tag tracking-wider text-[#141110]/80 hover:text-[#141110] transition-colors">
                {partner}
              </span>
              <span class="text-[#141110]/30 text-xs">•</span>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 35s linear infinite;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }
</style>
