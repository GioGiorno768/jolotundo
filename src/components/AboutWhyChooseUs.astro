<!-- 
  =============================================================================
  SECTION: NILAI JUAL UNIK (Text-First Stacking Cards Deck)
  - Pure GoUncharted Brutalist-Luxury Typography (No Background Images)
  - Sticky Stacking Physical Paper Cards Deck with Tactile Depth Scaling
  - Crisp Hairline Divider Separating Massive Title from Description & Specs
  =============================================================================
-->
<section id="keunggulan" class="relative z-10 bg-[#f4efe6] text-[#141110] py-14 sm:py-24 lg:py-32 px-3.5 sm:px-8 lg:px-14 xl:px-20 border-b border-[#141110]/15">
  <div class="max-w-[1540px] mx-auto space-y-10 sm:space-y-16 lg:space-y-20">

    <!-- Section Header (Editorial Monospace Kicker + Big Headline) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between pb-6 sm:pb-8 border-b border-[#141110]/15 gap-4 sm:gap-6">
      <div class="space-y-2 sm:space-y-3 max-w-3xl">
        <span class="text-[11px] sm:text-sm font-mono-tag text-[#141110]/50 tracking-[0.22em] sm:tracking-[0.28em] uppercase block">
          — NILAI JUAL UNIK // VALUE PROPOSITION
        </span>
        <h2 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-normal tracking-tight text-[#141110] font-sans leading-[1.08]">
          Mengapa Memilih Jolotundo Glamping & Edupark?
        </h2>
      </div>
      <div class="text-[10px] sm:text-xs font-mono-tag text-[#141110]/60 uppercase tracking-widest flex items-center gap-2 shrink-0 self-start md:self-auto">
        <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-emerald-800 animate-pulse"></span>
        <span>04 KEUNGGULAN UTAMA • GULIR KE BAWAH</span>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TEXT-FIRST STACKING CARDS DECK CONTAINER                                  -->
    <!-- ========================================================================= -->
    <div id="usp-stack-container" class="relative w-full flex flex-col pb-8 sm:pb-12">
      {advantages.map((item, idx) => (
        <div 
          id={`usp-card-wrapper-${idx}`}
          class="usp-card-wrapper sticky will-change-transform"
          style={`--card-idx: ${idx}; z-index: ${10 + idx * 5};`}
          data-index={idx}
        >
          <!-- Paper Card Container (Clean, Minimalist, Elegant Hairline Borders) -->
          <article 
            id={`usp-card-${idx}`}
            class="usp-card relative w-full bg-[#fdfbf7] text-[#141110] border border-[#141110]/20 p-4 sm:p-8 md:p-10 lg:p-14 xl:p-16 shadow-[0_-8px_24px_rgba(20,17,16,0.04)] sm:shadow-[0_-12px_36px_rgba(20,17,16,0.05)] transition-all duration-300 ease-out origin-top flex flex-col justify-between group hover:border-[#141110] select-none"
          >
            
            <div>
              <!-- 1. Top Card Bar: Index & Category Pill -->
              <div class="flex items-center justify-between pb-3 sm:pb-5 border-b border-[#141110]/10 text-xs font-mono-tag">
                <div class="flex items-center gap-2 sm:gap-3">
                  <span class="text-sm sm:text-lg font-bold text-[#141110]">{item.num}</span>
                  <span class="text-[#141110]/30">•</span>
                  <span class="text-[10px] sm:text-xs uppercase tracking-[0.16em] sm:tracking-[0.2em] text-[#141110]/60 font-medium">
                    {item.tag}
                  </span>
                </div>
              </div>

              <!-- 2. Massive Editorial Title & Lead -->
              <div class="mt-3.5 sm:mt-6 lg:mt-8 space-y-1 sm:space-y-2">
                <span class="text-[10px] sm:text-xs lg:text-sm font-mono-tag text-[#141110]/55 uppercase tracking-[0.18em] sm:tracking-[0.22em] block">
                  {item.lead}
                </span>
                <h3 class="text-2xl sm:text-4xl md:text-5xl lg:text-[56px] font-normal tracking-tight text-[#141110] font-sans leading-[1.08] sm:leading-[1.04]">
                  {item.title}
                </h3>
              </div>
            </div>

            <!-- 3. Crisp Hairline Divider (Pemisah Antara Title & Deskripsi) -->
            <div class="w-full border-t border-[#141110]/15 my-3.5 sm:my-6 lg:my-8"></div>

            <!-- 4. Bottom Content: 2-Column Responsive Layout (Narrative + Specs) -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-3.5 sm:gap-6 lg:gap-14 items-start">
              
              <!-- Left: Narrative Body Paragraph -->
              <div class="lg:col-span-7">
                <p class="text-xs sm:text-base lg:text-[18px] text-[#141110]/80 font-sans leading-relaxed font-light">
                  {item.desc}
                </p>
              </div>

              <!-- Right: Monospaced Highlights / Specifications Grid -->
              <div class="lg:col-span-5 flex flex-col space-y-2 sm:space-y-3">
                <span class="text-[9px] sm:text-[11px] font-mono-tag text-[#141110]/50 tracking-[0.2em] uppercase block">
                  SPESIFIKASI UNGGULAN:
                </span>
                <div class="grid grid-cols-2 gap-1.5 sm:gap-2.5">
                  {item.specs.map((spec) => (
                    <div class="min-w-0 flex items-center gap-1.5 sm:gap-2 px-2.5 py-1.5 sm:px-3 sm:py-2.5 bg-[#f4efe6] border border-[#141110]/12 text-[10px] sm:text-xs font-mono-tag text-[#141110]">
                      <span class="text-emerald-800 font-bold text-[11px] sm:text-xs shrink-0">✓</span>
                      <span class="truncate">{spec}</span>
                    </div>
                  ))}
                </div>
              </div>

            </div>

          </article>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- ========================================================================= -->
<!-- CSS: RESPONSIVE STICKY OFFSET & TRAVEL MARGIN                             -->
<!-- ========================================================================= -->
<style>
  .usp-card-wrapper {
    top: calc(3.85rem + var(--card-idx) * 0.65rem);
    margin-bottom: 16vh;
  }
  .usp-card-wrapper:last-child {
    margin-bottom: 1.5rem;
  }
  @media (min-width: 640px) {
    .usp-card-wrapper {
      top: calc(4.75rem + var(--card-idx) * 1.15rem);
      margin-bottom: 20vh;
    }
    .usp-card-wrapper:last-child {
      margin-bottom: 2rem;
    }
  }
  @media (min-width: 1024px) {
    .usp-card-wrapper {
      top: calc(5.5rem + var(--card-idx) * 1.85rem);
      margin-bottom: 24vh;
    }
    .usp-card-wrapper:last-child {
      margin-bottom: 2.5rem;
    }
  }
</style>

<!-- ========================================================================= -->
<!-- JAVASCRIPT: TACTILE STACK SCALING ENGINE                                  -->
<!-- ========================================================================= -->
<script is:inline>
  function initUspStack() {
    const section = document.getElementById('keunggulan');
    const wrappers = document.querySelectorAll('.usp-card-wrapper');
    if (!section || !wrappers.length) return;

    // Handle smooth clicking on card headers
    wrappers.forEach((wrapper, idx) => {
      wrapper.addEventListener('click', (e) => {
        const isLink = e.target.closest('a');
        if (isLink) return;

        // @ts-ignore
        const lenis = window.__lenis;
        const isMobile = window.innerWidth < 640;
        const offsetVal = isMobile ? (idx * 10) + 60 : (idx * 30) + 80;
        const targetTop = wrapper.offsetTop - offsetVal;
        
        if (lenis) {
          lenis.scrollTo(wrapper, { offset: -offsetVal, duration: 0.8 });
        } else {
          window.scrollTo({
            top: targetTop,
            behavior: 'smooth'
          });
        }
      });
    });

    // Tactile depth scroll handler: subtle scale down on buried cards
    function onScrollStack() {
      wrappers.forEach((wrapper, idx) => {
        if (idx === wrappers.length - 1) return; // Don't scale last card

        const nextWrapper = wrappers[idx + 1];
        if (!nextWrapper) return;

        const nextRect = nextWrapper.getBoundingClientRect();
        const wrapperRect = wrapper.getBoundingClientRect();
        
        const cardInner = wrapper.querySelector('.usp-card');
        if (!cardInner) return;

        // When next card approaches or overlaps, scale down slightly & shift shadow
        if (nextRect.top <= wrapperRect.bottom) {
          const overlap = wrapperRect.bottom - nextRect.top;
          const maxOverlap = wrapperRect.height;
          const progress = Math.max(0, Math.min(1, overlap / (maxOverlap * 0.75)));

          const scale = 1 - progress * 0.035; // 1.0 -> 0.965
          const opacity = 1 - progress * 0.15; // 1.0 -> 0.85
          
          cardInner.style.transform = `scale(${scale.toFixed(4)})`;
          cardInner.style.opacity = `${opacity.toFixed(3)}`;
        } else {
          cardInner.style.transform = 'scale(1)';
          cardInner.style.opacity = '1';
        }
      });
    }

    let isTicking = false;
    let isIntersecting = false;

    function handleScroll() {
      if (!isTicking && isIntersecting) {
        requestAnimationFrame(() => {
          onScrollStack();
          isTicking = false;
        });
        isTicking = true;
      }
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        isIntersecting = entry.isIntersecting;
        if (isIntersecting) {
          onScrollStack();
        }
      });
    }, {
      root: null,
      threshold: 0,
      rootMargin: "200px 0px"
    });

    observer.observe(section);

    window.addEventListener('scroll', handleScroll, { passive: true });
    
    // Initial run
    onScrollStack();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initUspStack);
  } else {
    initUspStack();
  }
</script>

