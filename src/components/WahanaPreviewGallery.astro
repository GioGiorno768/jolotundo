---
import siteData from '../data/siteData.json';

interface Props {
  activity: {
    id: string;
    index: string;
    name: string;
    tier: string;
    setting: string;
    elevation: string;
    priceStarting: string;
    contactType: string;
    gallery: Array<{ src: string; caption: string; subtitle: string }>;
  };
}

const { activity } = Astro.props;
const galleryImages = activity.gallery || [];

// Destination WhatsApp Concierge
const waPhone = activity.contactType === "corporate" ? "6282249829998" : (siteData.brand.whatsapp || "6282249828998");
const waUrl = `https://wa.me/${waPhone.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Halo Admin Jolotundo Edupark, saya tertarik reservasi dan info ketersediaan untuk *${activity.name}*.`)}`;
---

<!-- 
  =============================================================================
  SECTION: STICKY HORIZONTAL SCROLL PREVIEW GALLERY (1:1 GOUNCHARTED REFERENCE)
  - Outer Container: Tall vertical scroll distance (280vh)
  - Sticky Viewport: Pins at top of screen (h-screen)
  - Horizontal Track: Translates -X on vertical scroll
  - Bottom Bar: 1:1 with GoUncharted (Title, Specs, Progress Line, Price, CTA)
  =============================================================================
-->
<section 
  id="wahana-preview-gallery" 
  class="relative bg-[#f4efe6] text-[#141110] border-t border-[#141110]/15 select-none"
  style="height: 280vh;"
>
  
  <!-- Sticky Viewport Frame (Pins at top of screen) -->
  <div 
    id="wahana-gallery-sticky-viewport" 
    class="sticky top-0 h-screen w-full overflow-hidden flex flex-col justify-between py-5 sm:py-7 lg:py-8 px-4 sm:px-8 lg:px-14 xl:px-20 select-none z-10"
  >
    
    <!-- Top Bar: Kicker + Status -->
    <div class="flex items-center justify-between pb-3 sm:pb-4 border-b border-[#141110]/15 w-full max-w-[1680px] mx-auto shrink-0">
      <div class="flex items-center gap-2.5 text-xs font-mono-tag text-[#141110]/70 tracking-widest uppercase">
        <span class="w-1.5 h-1.5 bg-[#141110]"></span>
        <span>PREVIEW GALLERY // SUASANA & MEDAN JALUR</span>
      </div>
      <div class="flex items-center gap-2 text-[11px] font-mono-tag text-[#141110]/60 uppercase tracking-widest">
        <span class="inline-block w-1.5 h-1.5 bg-emerald-700 animate-pulse"></span>
        <span class="hidden sm:inline">Scroll ke bawah untuk menjelajahi visual aktivitas</span>
        <span class="sm:hidden">Scroll untuk foto aktivitas</span>
      </div>
    </div>

    <!-- Middle: Horizontal Sliding Image Track -->
    <div id="wahana-slider-window" class="relative w-full my-auto overflow-hidden py-2 sm:py-4">
      <div 
        id="wahana-slider-track" 
        class="flex items-center gap-4 sm:gap-6 lg:gap-8 will-change-transform"
        style="transform: translate3d(0, 0px, 0);"
      >
        {galleryImages.map((img, i) => (
          <div class="gallery-card shrink-0 relative h-[48vh] sm:h-[54vh] lg:h-[58vh] aspect-[3/4] sm:aspect-[4/5] overflow-hidden bg-[#141110] border border-[#141110]/20 shadow-2xl group cursor-pointer transition-shadow duration-300 hover:shadow-[0_20px_50px_rgba(0,0,0,0.4)]">
            
            <!-- Image with Smooth Hover Zoom -->
            <img 
              src={img.src} 
              alt={img.caption} 
              class="w-full h-full object-cover object-center transform scale-100 group-hover:scale-105 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
              loading="lazy"
              decoding="async"
            />

            <!-- Soft Vignette Gradient -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-black/20 pointer-events-none"></div>

            <!-- Top Index Tag -->
            <div class="absolute top-4 left-4 z-10 pointer-events-none">
              <span class="text-[10px] font-mono-tag tracking-widest text-[#d8c39e] uppercase px-2.5 py-1 bg-black/75 backdrop-blur-md border border-white/10 font-bold">
                0{i + 1} // 0{galleryImages.length}
              </span>
            </div>

            <!-- Bottom Floating Caption -->
            <div class="absolute bottom-4 sm:bottom-5 left-4 sm:left-5 right-4 sm:right-5 z-10 pointer-events-none">
              <span class="text-xs sm:text-sm font-bold font-sans text-white uppercase tracking-tight block drop-shadow leading-snug">
                {img.caption}
              </span>
              <span class="text-[10px] font-mono-tag text-[#d8c39e] uppercase tracking-wider block mt-0.5">
                {img.subtitle}
              </span>
            </div>

          </div>
        ))}
      </div>
    </div>

    <!-- Bottom: 1:1 GoUncharted Bottom Sub-Bar -->
    <div class="w-full max-w-[1680px] mx-auto shrink-0 flex flex-col gap-3 pt-1">
      
      <!-- Hairline Divider with Dynamic Sliding Progress Bar Line -->
      <div class="relative w-full h-[2px] bg-[#141110]/15 overflow-hidden">
        <div 
          id="wahana-gallery-progress-bar" 
          class="absolute top-0 left-0 h-full bg-[#141110] transition-all duration-75 will-change-[width]"
          style="width: 15%;"
        ></div>
      </div>

      <!-- 1:1 GoUncharted Metadata Row Below Divider -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-1">
        
        <!-- Left: Activity Title + Setting + 3 Metadata Specs -->
        <div class="flex flex-wrap items-center gap-4 sm:gap-8">
          
          <div>
            <h4 class="text-base sm:text-lg lg:text-xl font-bold tracking-tight text-[#141110] uppercase font-sans leading-none">
              {activity.name}
            </h4>
            <span class="text-[10px] font-mono-tag text-[#141110]/60 uppercase tracking-widest block mt-0.5">
              {activity.setting}
            </span>
          </div>

          <div class="hidden sm:block h-8 w-[1px] bg-[#141110]/15"></div>

          <div class="flex items-center gap-4 sm:gap-6 text-xs font-mono-tag text-[#141110]">
            <div>
              <span class="text-xs sm:text-sm font-bold block">{activity.elevation || "±800 MDPL"}</span>
              <span class="text-[9px] text-[#141110]/50 uppercase tracking-widest block">ELEVASI</span>
            </div>
            
            <div class="h-6 w-[1px] bg-[#141110]/15"></div>

            <div>
              <span class="text-xs sm:text-sm font-bold block">ALL SEASONS</span>
              <span class="text-[9px] text-[#141110]/50 uppercase tracking-widest block">OPERASIONAL</span>
            </div>

            <div class="h-6 w-[1px] bg-[#141110]/15 hidden xs:block"></div>

            <div class="hidden xs:block">
              <span class="text-xs sm:text-sm font-bold block">VERIFIED</span>
              <span class="text-[9px] text-[#141110]/50 uppercase tracking-widest block">SAFETY GEAR</span>
            </div>
          </div>

        </div>

        <!-- Right: Starting Price + CTA Booking WhatsApp -->
        <div class="flex items-center justify-between sm:justify-end gap-5">
          <div class="text-right">
            <span class="text-[10px] font-mono-tag text-[#141110]/50 uppercase tracking-widest block">Mulai Dari</span>
            <span class="text-lg sm:text-xl font-bold font-mono-tag text-[#141110] leading-none">
              {activity.priceStarting}
            </span>
          </div>

          <a 
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-[#141110] text-[#f4efe6] text-xs font-mono-tag font-bold uppercase tracking-wider hover:bg-black transition-colors"
          >
            <span>Reservasi Slot</span>
            <span>↗</span>
          </a>
        </div>

      </div>

    </div>

  </div>

</section>

<!-- ========================================================================= -->
<!-- JAVASCRIPT: STICKY HORIZONTAL SCROLL CONTROLLER SCRIPT                    -->
<!-- ========================================================================= -->
<script is:inline>
  function initWahanaGallery() {
    const section = document.getElementById('wahana-preview-gallery');
    const track = document.getElementById('wahana-slider-track');
    const progressBar = document.getElementById('wahana-gallery-progress-bar');
    const sliderWindow = document.getElementById('wahana-slider-window');

    if (!section || !track || !progressBar || !sliderWindow) return;

    let isTicking = false;

    function updateScroll() {
      const rect = section.getBoundingClientRect();
      const sectionHeight = section.offsetHeight;
      const windowHeight = window.innerHeight;

      // Calculate vertical scroll progress through the section [0, 1]
      const totalScrollableDistance = sectionHeight - windowHeight;
      const scrolledDistance = -rect.top;

      let progress = 0;
      if (scrolledDistance > 0) {
        progress = Math.min(1, Math.max(0, scrolledDistance / totalScrollableDistance));
      }

      // Horizontal track dimensions
      const trackWidth = track.scrollWidth;
      const windowWidth = sliderWindow.offsetWidth;
      const maxHorizontalScroll = Math.max(0, trackWidth - windowWidth + 40);

      // Interpolate horizontal translation using smooth GPU transform
      const currentTranslateX = progress * maxHorizontalScroll;
      track.style.transform = `translate3d(-${currentTranslateX.toFixed(1)}px, 0, 0)`;

      // Update progress bar width
      const barPercentage = Math.max(12, Math.min(100, (progress * 88) + 12));
      progressBar.style.width = `${barPercentage.toFixed(1)}%`;
    }

    function handleScroll() {
      if (!isTicking) {
        requestAnimationFrame(() => {
          updateScroll();
          isTicking = false;
        });
        isTicking = true;
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('resize', handleScroll, { passive: true });
    updateScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWahanaGallery);
  } else {
    initWahanaGallery();
  }
</script>

