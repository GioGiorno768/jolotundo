}

const { activity } = Astro.props;

// Mapping activity ID to folder name in public/images/activities/
const activityFolderMap: Record<string, string> = {
  "atv-adventure": "atv",
  "atv": "atv",
  "jeep-offroad": "jeep",
  "jeep": "jeep",
  "wisata-berkuda": "horse",
  "horse-riding": "horse",
  "horse": "horse",
  "mini-zoo": "zoo",
  "mini-zoo-edupark": "zoo",
  "zoo": "zoo",
  "forest-spa": "spa",
  "spa": "spa",
  "outbound-gathering": "outbond",
  "outbound": "outbond",
  "outbond": "outbond"
