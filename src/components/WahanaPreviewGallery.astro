---
import fs from 'node:fs';
import path from 'node:path';
import siteData from '../data/siteData.json';

interface Props {
  activity: {
    id: string;
    index: string;
    name: string;
    tier: string;
    setting: string;
    elevation: string;
    priceStarting: string;
    contactType: string;
    gallery?: Array<{ src: string; caption: string; subtitle: string }>;
