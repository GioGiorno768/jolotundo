---
// CLIENTELE & SOCIAL PROOF (Compro Hal. 19 & 20)
// 100+ BUMN & Corporate Partners + Official Client Quotes
import PartnerMarquee from './PartnerMarquee.astro';

const testimonials = [
  {
    client: "Team RSUD Dr. Soegiri, Lamongan",
    role: "INSTITUSI KESEHATAN // OUTBOUND & GATHERING",
    quote: "Sangat puas, tenda nyaman bersih, toilet banyak bersih akses dari parkiran ke tenda dekat, pegawai ramah dan tanggap terhadap pengunjung.",
    rating: "5.0",
    date: "Corporate Gathering"
  },
  {
    client: "Team KKG Kecamatan Tulungagung",
    role: "KORPS PENDIDIKAN // CAPACITY BUILDING",
    quote: "Saya merasa puas karena suasana memang tenang, udara disana sangat sejuk dan bisa me-refresh otak, pelayanan juga baik, petugasnya juga ramah, kebersihan sangat terjaga dan itu membuat pengunjung merasa nyaman.",
    rating: "5.0",
    date: "Team Consolidation"
  }
];

const clientCategories = [
  { label: "BUMN & ENERGI", examples: "Pertamina, PLN, Semen Indonesia, KAI, Bulog, Jasa Marga" },
  { label: "PERBANKAN & KEUANGAN", examples: "Bank Mandiri, BRI, Bank Jatim, BJB, CIMB Niaga, Pegadaian" },
  { label: "KORPORAT & OTOMOTIF", examples: "Yamaha, Astra Daihatsu, Adira Finance, FIFGROUP, Indomarco" },
  { label: "PEMERINTAH & KESEHATAN", examples: "RSUD Dr. Soegiri, KKG Jawa Timur, Dinas & Pemkab" }
];
---

<section id="klien-testimoni" class="relative z-10 bg-[#f4efe6] text-[#141110] py-24 sm:py-32 px-6 sm:px-10 lg:px-14 xl:px-20 border-b border-[#141110]/15">
  <div class="max-w-[1540px] mx-auto space-y-20 sm:space-y-24">

    <!-- 1. OUR CLIENTELE HEADER -->
    <div class="space-y-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between pb-8 border-b border-[#141110]/15 gap-6">
        <div class="space-y-3 max-w-3xl">
          <span class="text-xs font-mono-tag text-[#141110]/50 tracking-[0.28em] uppercase block">
            — PORTOFOLIO B2B // OUR CLIENTELE
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-normal tracking-tight text-[#141110] font-sans leading-tight">
            100+ Corporate & Institutions Enjoy Their Time in Jolotundo.
          </h2>
        </div>
        <div class="text-xs font-mono-tag text-[#141110]/60 uppercase tracking-wider">
          [ TRUSTED NATIONWIDE ]
        </div>
      </div>

      <!-- Partner Logo Marquee Rail (16 Vector BUMN & Corporate Logos) -->
      <PartnerMarquee />

      <!-- Client Category Breakdown Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-4">
        {clientCategories.map((cat, idx) => (
          <div class="p-5 bg-white/60 border border-[#141110]/10 text-xs font-mono-tag space-y-1.5">
            <span class="text-[#141110]/40 uppercase tracking-wider block">0{idx + 1} // {cat.label}</span>
            <p class="text-[#141110]/80 font-sans font-normal leading-relaxed">{cat.examples}</p>
          </div>
        ))}
      </div>

    </div>

    <!-- 2. KATA MEREKA TENTANG KAMI (Compro Hal. 19 Quotes) -->
    <div class="pt-8 border-t border-[#141110]/15 space-y-12">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <span class="text-xs font-mono-tag text-[#141110]/50 tracking-[0.25em] uppercase block mb-2">
            — TESTIMONI RESMI KORPORASI
          </span>
          <h3 class="text-2xl sm:text-3xl lg:text-4xl font-normal tracking-tight text-[#141110] font-sans">
            Kata Mereka Tentang Pengalaman di Jolotundo
          </h3>
        </div>
        <span class="text-xs font-mono-tag text-[#141110]/50 uppercase">
          [ VERIFIED GATHERING EXPERIENCE ]
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {testimonials.map((item) => (
          <div class="p-8 sm:p-10 bg-white/80 hover:bg-white border border-[#141110]/15 hover:border-[#141110] transition-all duration-300 flex flex-col justify-between group shadow-[0_4px_24px_rgba(20,17,16,0.03)] hover:shadow-[0_12px_36px_rgba(20,17,16,0.08)]">
            
            <div>
              <!-- Rating & Type -->
              <div class="flex items-center justify-between pb-6 border-b border-[#141110]/10 text-xs font-mono-tag">
                <span class="text-emerald-900 font-bold tracking-widest">★★★★★ {item.rating}</span>
                <span class="text-[#141110]/50 uppercase">{item.date}</span>
              </div>

              <!-- Quote Body -->
              <blockquote class="mt-6 text-lg sm:text-xl font-sans font-light text-[#141110] leading-relaxed italic">
                “{item.quote}”
              </blockquote>
            </div>

            <!-- Client Info -->
            <div class="mt-8 pt-5 border-t border-[#141110]/10 space-y-1">
              <h4 class="text-base font-semibold tracking-tight text-[#141110] font-sans">
                {item.client}
              </h4>
              <p class="text-xs font-mono-tag text-[#141110]/50 uppercase tracking-wider">
                {item.role}
              </p>
            </div>

          </div>
        ))}
      </div>

    </div>

    <!-- 3. LOKASI & KONTAK RESMI ENTITAS (Compro Hal. 21) -->
    <div class="p-8 sm:p-12 bg-white/80 border border-[#141110]/20 space-y-8">
      
      <div class="flex flex-col lg:flex-row lg:items-center justify-between pb-8 border-b border-[#141110]/15 gap-6">
        <div>
          <span class="text-xs font-mono-tag text-[#141110]/50 tracking-[0.25em] uppercase block mb-1">
            ENTITAS & BADAN USAHA RESMI
          </span>
          <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#141110] font-sans">
            Jolotundo Glamping & Edupark
          </h3>
          <p class="text-xs font-mono-tag text-emerald-900 uppercase tracking-widest mt-1">
            BAGIAN DARI EKOSISTEM BISNIS DAN GROUP
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a 
            href="https://wa.me/6282249829998?text=Halo%20Admin%20Dan%20Group%20Jolotundo,%20saya%20ingin%20konsultasi%20program%20gathering%20dan%20kemitraan." 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-6 py-3 bg-[#141110] hover:bg-black text-[#f4efe6] font-mono-tag text-xs font-bold uppercase tracking-wider transition-all"
          >
            Konsultasi Gathering & MICE ↗
          </a>
          <a 
            href="/lokasi" 
            class="px-5 py-3 border border-[#141110]/20 hover:border-[#141110] font-mono-tag text-xs font-semibold uppercase tracking-wider transition-all"
          >
            Lihat Denah & Rute →
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs font-mono-tag">
        <div class="space-y-1.5">
          <span class="text-[#141110]/40 uppercase block">ALAMAT KAWASAN:</span>
          <p class="text-[#141110] font-sans text-sm leading-relaxed">
            Dusun Plakat, Desa Bajulan, Kec. Loceret, Kab. Nganjuk, Jawa Timur, Indonesia 64471
          </p>
        </div>
        <div class="space-y-1.5">
          <span class="text-[#141110]/40 uppercase block">HOTLINE & WHATSAPP:</span>
          <p class="text-[#141110] font-sans text-sm font-semibold">
            +62 822-4982-9998
          </p>
          <span class="text-[11px] text-[#141110]/50 block">Layanan Tamu & Reservasi 24 Jam</span>
        </div>
        <div class="space-y-1.5">
          <span class="text-[#141110]/40 uppercase block">SURAT ELEKTRONIK / EMAIL:</span>
          <p class="text-[#141110] font-sans text-sm font-semibold">
            jolotundoedupark@gmail.com
          </p>
          <span class="text-[11px] text-[#141110]/50 block">Kerjasama Korporat & B2B Inquiries</span>
        </div>
      </div>

    </div>

  </div>
</section>

