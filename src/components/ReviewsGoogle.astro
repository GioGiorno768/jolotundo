  <!-- Bottom Elegant Call-to-Action Bar -->
  <div class="max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-14 xl:px-20 mt-10 sm:mt-14">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-5 pt-6 sm:pt-8 border-t border-white/10 text-center sm:text-left">
      <div class="flex items-center gap-2.5 text-[11px] sm:text-xs font-mono-tag text-white/60 uppercase tracking-widest">
        <span class="w-1.5 h-1.5 bg-emerald-500 animate-pulse"></span>
