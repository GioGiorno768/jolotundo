---
import reviews from '../data/reviews.json';
import siteData from '../data/siteData.json';

const googleMapsUrl = "https://maps.google.com/?q=Jolotundo+Glamping+and+Edupark+Bajulan+Nganjuk";

// Split reviews into two distinct sets
const row1 = reviews.slice(0, 4);
const row2 = reviews.slice(4, 8);
---

<!-- 
  SECTION 05 // ULASAN PENGUNJUNG (Interactive Draggable Marquee Architecture)
  - Dark Mode Luxury Obsidian Background (#12100e)
  - Interactive Grabbable & Swipeable Infinite Marquee (Drag Left/Right with Mouse or Touch)
  - Resumes auto-scrolling automatically when unhovered / untouched
  - Mobile Optimized: Generous top clearance, responsive card width, zero text-wrapping glitches
  - Official Google Maps Verified Rating (4.9 / 5.0 from 1.450+ Reviews)
-->
<section id="ulasan" class="relative z-20 bg-[#12100e] text-[#f5f1ea] border-t border-white/10 pt-28 pb-20 sm:pt-32 sm:pb-28 overflow-hidden select-none">
  
