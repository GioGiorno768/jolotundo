                {rev.quote}
              </blockquote>
            </div>

            <!-- Bottom Reviewer Credit (Zero Text-Wrapping Glitch) -->
            <div class="flex items-center justify-between gap-2 pt-3 border-t border-white/10">
              <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-7 h-7 sm:w-8 sm:h-8 bg-white/10 text-white font-mono-tag font-bold text-xs flex items-center justify-center shrink-0 border border-white/20">
