        <a 
          href={`https://wa.me/${siteData.brand.whatsapp}?text=${encodeURIComponent("Halo Admin Jolotundo, saya ingin reservasi glamping.")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 sm:flex-initial px-4 sm:px-5 py-2.5 bg-transparent hover:bg-white/10 text-white font-mono-tag text-xs font-bold uppercase tracking-wider transition-all duration-300 border border-white/20 inline-flex items-center justify-center gap-1.5 cursor-pointer"
        >
          <span>Booking Glamping</span>
          <span>↗</span>
        </a>
      </div>
    </div>
  </div>

</section>

<!-- Interactive Draggable Marquee Engine Script -->
<script is:inline>
  function initDraggableMarquee() {
    const track1 = document.getElementById('marquee-track-1');
    const track2 = document.getElementById('marquee-track-2');
    if (!track1 || !track2) return;

    // Helper to setup a draggable + auto-scrolling marquee track
    function setupTrack(track, baseSpeed, initialOffsetRatio = 0) {
      let currentX = 0;
      let isDragging = false;
      let isHovered = false;
      let startX = 0;
      let dragStartX = 0;
      let animationFrameId = null;

      // Calculate unit width (the repeated sequence is repeated 3 times)
      function getUnitWidth() {
        return track.scrollWidth / 3;
      }

      // Initialize offset
      const unit = getUnitWidth();
      if (initialOffsetRatio !== 0) {
        currentX = -unit * initialOffsetRatio;
      }

      function loop() {
        const currentUnitWidth = getUnitWidth();

        if (!isDragging && !isHovered) {
          currentX += baseSpeed;
        }

        // Infinite wrap logic
        if (baseSpeed < 0) {
          // Moving Left
          if (currentX <= -currentUnitWidth) {
            currentX += currentUnitWidth;
          }
          if (currentX > 0) {
            currentX -= currentUnitWidth;
          }
        } else {
          // Moving Right
          if (currentX >= 0) {
            currentX -= currentUnitWidth;
          }
          if (currentX < -currentUnitWidth) {
            currentX += currentUnitWidth;
          }
        }

        track.style.transform = `translate3d(${currentX.toFixed(2)}px, 0, 0)`;
        animationFrameId = requestAnimationFrame(loop);
      }

      // Pointer & Mouse interactions
      const wrapper = track.parentElement;

      // Hover triggers pause on desktop
      wrapper.addEventListener('mouseenter', () => {
        isHovered = true;
      });

      wrapper.addEventListener('mouseleave', () => {
        isHovered = false;
        if (isDragging) {
          isDragging = false;
          wrapper.style.cursor = 'grab';
        }
      });

      // Pointer down (Mouse drag)
      track.addEventListener('mousedown', (e) => {
        e.preventDefault();
        isDragging = true;
        isHovered = true;
        startX = e.clientX;
        dragStartX = currentX;
        wrapper.style.cursor = 'grabbing';
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const delta = e.clientX - startX;
        currentX = dragStartX + delta;
      });

      window.addEventListener('mouseup', () => {
        if (!isDragging) return;
        isDragging = false;
        wrapper.style.cursor = 'grab';
        // If cursor is still over wrapper, remains paused; otherwise resumes
        const isStillOver = wrapper.matches(':hover');
        if (!isStillOver) {
          isHovered = false;
        }
      });

      // Touch interactions (Mobile Swipe / Drag)
      track.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          isDragging = true;
          isHovered = true;
          startX = e.touches[0].clientX;
          dragStartX = currentX;
        }
      }, { passive: true });

      track.addEventListener('touchmove', (e) => {
        if (!isDragging || e.touches.length !== 1) return;
        const delta = e.touches[0].clientX - startX;
        currentX = dragStartX + delta;
      }, { passive: true });

      track.addEventListener('touchend', () => {
        if (!isDragging) return;
        isDragging = false;
        // Resume auto-scroll after a pleasant brief pause
        setTimeout(() => {
          isHovered = false;
        }, 500);
      });

      track.addEventListener('touchcancel', () => {
        isDragging = false;
        isHovered = false;
      });

      // Start rAF loop
      animationFrameId = requestAnimationFrame(loop);
    }

    // Setup Row 1: Slides Left (-0.65px per frame)
    setupTrack(track1, -0.65, 0);

    // Setup Row 2: Slides Right (+0.65px per frame), initial offset half unit
    setupTrack(track2, 0.65, 0.5);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDraggableMarquee);
  } else {
    initDraggableMarquee();
  }
</script>
