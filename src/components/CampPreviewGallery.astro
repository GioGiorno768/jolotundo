---
import fs from 'node:fs';
import path from 'node:path';
import siteData from '../data/siteData.json';

interface Props {
  camp: {
    id: string;
    index: string;
    name: string;
    tier: string;
    setting: string;
    elevation?: string;
    capacity: string;
    priceWeekday: string;
    priceWeekend: string;
    image: string;
    editorialImage?: string;
    editorialTagline?: string;
    tagline?: string;
    headline?: string;
  };
}

const { camp } = Astro.props;

// Metadata map for deluxe camp images to provide curated captions & logical narrative sequence
const deluxeMetaMap: Record<string, { caption: string; subtitle: string; order: number }> = {
  "front2.avif": { caption: "Tampak Depan & Lanskap", subtitle: "Keasrian Alami Pepohonan", order: 1 },
  "1000396148.avif": { caption: "Kabin Deluxe Jolotundo", subtitle: "Unit Eksklusif & Privat", order: 2 },
  "bed.avif": { caption: "King Size Master Bed", subtitle: "Kenyamanan Istirahat Maksimal", order: 3 },
  "room.avif": { caption: "Interior Kamar & Smart TV", subtitle: "Fasilitas Hiburan Lengkap & AC", order: 4 },
  "ruang-kerja.avif": { caption: "Meja Kerja & Coffee Corner", subtitle: "Workation Nyaman di Alam", order: 5 },
  "teras-baru-landscape.avif": { caption: "Panorama Teras Tepi Air", subtitle: "Balkon Menghadap Lanskap Asri", order: 6 },
  "teras-baru.avif": { caption: "Balkon Kayu Luas", subtitle: "Area Bersantai & Menikmati Udara", order: 7 },
  "teras.avif": { caption: "Teras Santai Kabin", subtitle: "Suasana Teduh & Tenang", order: 8 },
  "toilet.avif": { caption: "Kamar Mandi Modern", subtitle: "Water Heater & Shower Bersih", order: 9 },
  "toilet2.avif": { caption: "Fasilitas Kamar Mandi", subtitle: "Amenities Lengkap & Nyaman", order: 10 },
};

// Excluded images that should not appear in the gallery
const excludedDeluxeFiles = new Set(['front.avif', 'preview.avif']);

// Dynamically read ALL images from public/images/accommodations/deluxe folder
function getDeluxeCampImages(): Array<{ src: string; caption: string; subtitle: string }> {
  try {
    const dirPath = path.join(process.cwd(), 'public', 'images', 'accommodations', 'deluxe');
    if (fs.existsSync(dirPath)) {
      const files = fs.readdirSync(dirPath).filter(file => {
        const isImage = /\.(avif|webp|jpe?g|png)$/i.test(file);
        const isExcluded = excludedDeluxeFiles.has(file.toLowerCase());
        return isImage && !isExcluded;
      });
      files.sort((a, b) => {
        const orderA = deluxeMetaMap[a]?.order ?? 99;
        const orderB = deluxeMetaMap[b]?.order ?? 99;
        return orderA - orderB || a.localeCompare(b);
      });
      return files.map(file => {
        const meta = deluxeMetaMap[file] || {
          caption: file.replace(/\.[^/.]+$/, '').replace(/[-_]/g, ' ').toUpperCase(),
          subtitle: "Deluxe Camp Jolotundo"
        };
        return {
          src: `/images/accommodations/deluxe/${file}`,
          caption: meta.caption,
          subtitle: meta.subtitle
        };
      });
    }
  } catch (err) {
    console.error("Error reading deluxe camp images:", err);
  }
  return [];
}

