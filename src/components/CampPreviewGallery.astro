---

<!-- 
  =============================================================================
  SECTION: STICKY HORIZONTAL SCROLL PREVIEW GALLERY (1:1 GOUNCHARTED REFERENCE)
  - Outer Container: Tall vertical scroll distance (280vh)
  - Sticky Viewport: Pins at top of screen (h-screen)
  - Horizontal Track: Translates -X on vertical scroll
  - Bottom Bar: 1:1 with GoUncharted (Title, Specs, Progress Line, Price, CTA)
  =============================================================================
-->
<section 
  id="camp-preview-gallery" 
  class="relative bg-[#f4efe6] text-[#141110] border-t border-[#141110]/15 select-none"
  style="height: 280vh;"
>
  
  <!-- Sticky Viewport Frame (Pins at top of screen) -->
  <div 
    id="gallery-sticky-viewport" 
    class="sticky top-0 h-screen w-full overflow-hidden flex flex-col justify-between py-5 sm:py-7 lg:py-8 px-4 sm:px-8 lg:px-14 xl:px-20 select-none z-10"
  >
    
    <!-- Top Bar: Kicker + Status -->
    <div class="flex items-center justify-between pb-3 sm:pb-4 border-b border-[#141110]/15 w-full max-w-[1680px] mx-auto shrink-0">
      <div class="flex items-center gap-2.5 text-xs font-mono-tag text-[#141110]/70 tracking-widest uppercase">
        <span class="w-1.5 h-1.5 bg-[#141110]"></span>
        <span>PREVIEW GALLERY // SUASANA & DETAIL</span>
      </div>
      <div class="flex items-center gap-2 text-[11px] font-mono-tag text-[#141110]/60 uppercase tracking-widest">
        <span class="inline-block w-1.5 h-1.5 bg-emerald-700 animate-pulse"></span>
        <span class="hidden sm:inline">Gulir ke bawah untuk menjelajahi foto preview</span>
        <span class="sm:hidden">Scroll untuk eksplorasi foto</span>
      </div>
    </div>

    <!-- Middle: Horizontal Sliding Image Track -->
    <div id="gallery-slider-window" class="relative w-full my-auto overflow-hidden py-2 sm:py-4">
      <div 
        id="gallery-slider-track" 
        class="flex items-center gap-4 sm:gap-6 lg:gap-8 will-change-transform"
        style="transform: translate3d(0, 0px, 0);"
      >
        {galleryImages.map((img, i) => (
          <div class="gallery-card shrink-0 relative h-[48vh] sm:h-[54vh] lg:h-[58vh] aspect-[3/4] sm:aspect-[4/5] overflow-hidden bg-[#141110] border border-[#141110]/20 shadow-2xl group cursor-pointer transition-shadow duration-300 hover:shadow-[0_20px_50px_rgba(0,0,0,0.4)]">
            
            <!-- Image with Smooth Hover Zoom -->
            <img 
              src={img.src} 
              alt={img.caption} 
              class="w-full h-full object-cover object-center transform scale-100 group-hover:scale-105 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
              loading="lazy"
              decoding="async"
            />

            <!-- Soft Vignette Gradient -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-black/20 pointer-events-none"></div>

            <!-- Top Index Tag -->
            <div class="absolute top-4 left-4 z-10 pointer-events-none">
              <span class="text-[10px] font-mono-tag tracking-widest text-[#d8c39e] uppercase px-2.5 py-1 bg-black/75 backdrop-blur-md border border-white/10 font-bold">
                0{i + 1} // 0{galleryImages.length}
              </span>
            </div>

            <!-- Bottom Floating Caption -->
            <div class="absolute bottom-4 sm:bottom-5 left-4 sm:left-5 right-4 sm:right-5 z-10 pointer-events-none">
              <span class="text-xs sm:text-sm font-bold font-sans text-white uppercase tracking-tight block drop-shadow leading-snug">
                {img.caption}
              </span>
              <span class="text-[10px] font-mono-tag text-[#d8c39e] uppercase tracking-wider block mt-0.5">
                {img.subtitle}
              </span>
            </div>

          </div>
        ))}
      </div>
    </div>

    <!-- Bottom: 1:1 GoUncharted Bottom Sub-Bar (FAROE ISLANDS Style) -->
    <div class="w-full max-w-[1680px] mx-auto shrink-0 flex flex-col gap-3 pt-1">
      
      <!-- Hairline Divider with Dynamic Sliding Progress Bar Line -->
      <div class="relative w-full h-[2px] bg-[#141110]/15 overflow-hidden">
        <div 
          id="gallery-progress-bar" 
          class="absolute top-0 left-0 h-full bg-[#141110] transition-all duration-75 will-change-[width]"
          style="width: 15%;"
        ></div>
      </div>

      <!-- 1:1 GoUncharted Metadata Row Below Divider -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-1">
        
        <!-- Left: Camp Title + Setting + 3 Metadata Specs -->
        <div class="flex flex-wrap items-center gap-4 sm:gap-8">
          
          <!-- Camp Title & Setting Kicker -->
          <div>
            <h4 class="text-base sm:text-lg lg:text-xl font-bold tracking-tight text-[#141110] uppercase font-sans leading-none">
              {camp.name}
            </h4>
            <span class="text-[10px] font-mono-tag text-[#141110]/60 uppercase tracking-widest block mt-0.5">
              {camp.setting}
            </span>
          </div>

          <!-- Vertical Divider -->
          <div class="hidden sm:block h-8 w-[1px] bg-[#141110]/15"></div>

          <!-- 3 Columns Metadata Specs (1:1 with NIGHTS / GROUP / WINDOW) -->
          <div class="flex items-center gap-4 sm:gap-6 text-xs font-mono-tag text-[#141110]">
            <div>
              <span class="text-xs sm:text-sm font-bold block">{camp.capacity}</span>
              <span class="text-[9px] text-[#141110]/50 uppercase tracking-widest block">KAPASITAS</span>
            </div>
            
            <div class="h-6 w-[1px] bg-[#141110]/15"></div>

            <div>
              <span class="text-xs sm:text-sm font-bold block">{camp.elevation || "±800 MDPL"}</span>
              <span class="text-[9px] text-[#141110]/50 uppercase tracking-widest block">ELEVASI</span>
            </div>

            <div class="h-6 w-[1px] bg-[#141110]/15 hidden xs:block"></div>

            <div class="hidden xs:block">
              <span class="text-xs sm:text-sm font-bold block">ALL YEAR</span>
              <span class="text-[9px] text-[#141110]/50 uppercase tracking-widest block">SEASON</span>
            </div>
          </div>

        </div>

        <!-- Right: Pricing & Check Availability Action Button -->
        <div class="flex items-center justify-between sm:justify-end gap-4 shrink-0">
          <div class="text-left sm:text-right">
            <span class="text-sm sm:text-base lg:text-lg font-bold font-mono-tag text-[#141110] block tracking-tight">
              Mulai {camp.priceWeekday}
            </span>
            <span class="text-[9px] font-mono-tag text-[#141110]/50 uppercase tracking-wider block">
              TARIF RESMI PER MALAM
            </span>
          </div>

          <a 
            href={`https://wa.me/${siteData.brand.whatsapp}?text=${encodeURIComponent(`Halo Admin Jolotundo, saya ingin cek ketersediaan dan booking untuk *${camp.name}*.`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 sm:px-6 py-2.5 sm:py-3 bg-[#141110] hover:bg-black text-[#f4efe6] font-mono-tag text-xs font-bold uppercase tracking-wider transition-all duration-200 border border-[#141110] hover:shadow-[0_8px_20px_rgba(20,17,16,0.3)] shrink-0"
          >
            <span>Reservasi</span>
            <span>↗</span>
          </a>
        </div>

      </div>

    </div>

  </div>
</section>

<!-- ========================================================================= -->
<!-- STICKY HORIZONTAL SCROLL CONTROLLER SCRIPT (Natural Vertical to Horizontal)-->
<!-- ========================================================================= -->
<script is:inline>
  function initCampPreviewGallery() {
    const section = document.getElementById('camp-preview-gallery');
    const track = document.getElementById('gallery-slider-track');
    const progressBar = document.getElementById('gallery-progress-bar');
    const sliderWindow = document.getElementById('gallery-slider-window');
    if (!section || !track || !progressBar || !sliderWindow) return;

    let isTicking = false;
    let isIntersecting = false;

    function onScrollGallery() {
      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const totalDistance = section.offsetHeight - windowHeight;

      if (totalDistance <= 0) return;

      // Progress from 0 (when top enters/hits 0) to 1 (when bottom hits window bottom)
      const scrolled = -rect.top;
      const progress = Math.max(0, Math.min(1, scrolled / totalDistance));

      // Calculate total horizontal overflow distance of cards
      const trackWidth = track.scrollWidth;
      const windowWidth = sliderWindow.offsetWidth;
      const maxScrollX = Math.max(0, trackWidth - windowWidth + 48); // 48px padding buffer

      // Hardware-accelerated translate-3d
      const translateX = progress * maxScrollX;
      track.style.transform = `translate3d(-${translateX.toFixed(1)}px, 0, 0)`;

      // Dynamic progress bar width (from 15% to 100%)
      const barWidth = 15 + progress * 85;
      progressBar.style.width = `${barWidth.toFixed(1)}%`;
    }

    function handleScroll() {
      if (!isTicking && isIntersecting) {
        requestAnimationFrame(() => {
          onScrollGallery();
          isTicking = false;
        });
        isTicking = true;
      }
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        isIntersecting = entry.isIntersecting;
        if (isIntersecting) {
          onScrollGallery();
        }
      });
    }, {
      root: null,
      threshold: 0,
      rootMargin: "200px 0px"
    });

    observer.observe(section);

    window.addEventListener('scroll', handleScroll, { passive: true });
    
    let resizeTimer = null;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        onScrollGallery();
      }, 100);
    }, { passive: true });

    // Initial check
    onScrollGallery();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCampPreviewGallery);
  } else {
    initCampPreviewGallery();
  }
</script>

