  "deluxecamp": deluxeGalleryImages,
  "river-camp": riverGalleryImages,
  "rivercamp": riverGalleryImages,
  "river": riverGalleryImages,
  "korean-glamping": koreanGalleryImages,
  "koreanglamping": koreanGalleryImages,
  "korean": koreanGalleryImages,
  "indian-camp": indianGalleryImages,
