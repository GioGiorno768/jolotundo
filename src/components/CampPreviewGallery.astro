---
import siteData from '../data/siteData.json';

interface Props {
  camp: {
    id: string;
    index: string;
    name: string;
    tier: string;
    setting: string;
    elevation?: string;
    capacity: string;
    priceWeekday: string;
    priceWeekend: string;
    image: string;
