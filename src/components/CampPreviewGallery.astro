<!-- STICKY HORIZONTAL SCROLL CONTROLLER SCRIPT (Natural Vertical to Horizontal)-->
<!-- ========================================================================= -->
<script is:inline>
  function initCampPreviewGallery() {
    const section = document.getElementById('camp-preview-gallery');
    const track = document.getElementById('gallery-slider-track');
    const progressBar = document.getElementById('gallery-progress-bar');
    const sliderWindow = document.getElementById('gallery-slider-window');
    if (!section || !track || !progressBar || !sliderWindow) return;

    // Cached metrics to avoid forced layout reflow during scroll
    let sectionTop = 0;
    let sectionHeight = 0;
    let windowHeight = 0;
    let totalDistance = 0;
    let maxScrollX = 0;
    let isTicking = false;

    function updateMetrics() {
      const rect = section.getBoundingClientRect();
      windowHeight = window.innerHeight;
      sectionTop = window.scrollY + rect.top;
      sectionHeight = section.offsetHeight;
      totalDistance = Math.max(1, sectionHeight - windowHeight);

      const trackWidth = track.scrollWidth;
      const windowWidth = sliderWindow.offsetWidth;
      maxScrollX = Math.max(0, trackWidth - windowWidth + 64);
    }

    function renderGallery(currentScroll) {
      const scrolled = currentScroll - sectionTop;

      // Skip off-screen rendering
      if (scrolled < -windowHeight || scrolled > totalDistance + windowHeight) {
        return;
      }

      const progress = Math.max(0, Math.min(1, scrolled / totalDistance));
      const translateX = progress * maxScrollX;

      // Pure GPU transform: 0 layout reflows!
      track.style.transform = `translate3d(-${translateX.toFixed(1)}px, 0, 0)`;
      progressBar.style.transform = `scaleX(${(0.15 + progress * 0.85).toFixed(4)})`;
    }

    function onScrollNative() {
      if (!isTicking) {
        requestAnimationFrame(() => {
          const currentScroll = window.__lenis ? window.__lenis.scroll : window.scrollY;
          renderGallery(currentScroll);
          isTicking = false;
        });
        isTicking = true;
      }
    }

    // Direct frame-by-frame synchronization with Lenis smooth scroll
    if (window.__lenis) {
      window.__lenis.on('scroll', (e) => {
        renderGallery(typeof e.scroll === 'number' ? e.scroll : window.scrollY);
      });
    } else {
      window.addEventListener('scroll', onScrollNative, { passive: true });
      const checkLenis = setInterval(() => {
        if (window.__lenis) {
          window.removeEventListener('scroll', onScrollNative);
          window.__lenis.on('scroll', (e) => {
            renderGallery(typeof e.scroll === 'number' ? e.scroll : window.scrollY);
          });
          clearInterval(checkLenis);
        }
      }, 150);
      setTimeout(() => clearInterval(checkLenis), 3000);
    }

    // Refresh metrics on resize
    let resizeTimer = null;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        updateMetrics();
        const currentScroll = window.__lenis ? window.__lenis.scroll : window.scrollY;
        renderGallery(currentScroll);
      }, 100);
    }, { passive: true });

    // Initial setup
    updateMetrics();
    const initialScroll = window.__lenis ? window.__lenis.scroll : window.scrollY;
    renderGallery(initialScroll);

    // Re-verify metrics once all images have laid out
    window.addEventListener('load', () => {
      updateMetrics();
      const currentScroll = window.__lenis ? window.__lenis.scroll : window.scrollY;
      renderGallery(currentScroll);
    }, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCampPreviewGallery);
  } else {
    initCampPreviewGallery();
  }
</script>

