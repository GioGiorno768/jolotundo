const isRiver = camp.id === 'river-camp' || camp.id === 'rivercamp' || camp.id.includes('river');
const isKorean = camp.id === 'korean-glamping' || camp.id === 'koreanglamping' || camp.id.includes('korean');
const isIndian = camp.id === 'indian-camp' || camp.id === 'indian' || camp.id.includes('indian');
const isSuperior = camp.id === 'superior-camp' || camp.id === 'superior' || camp.id.includes('superior');
const isPinus = camp.id === 'pinus-camp' || camp.id === 'pinus-camp-plus' || camp.id.includes('pinus');
const isGround = camp.id === 'camping-ground' || camp.id === 'ground' || camp.id.includes('ground');

const galleryImages = (isDeluxe && deluxeGalleryImages.length > 0)
  ? deluxeGalleryImages
  : (isRiver && riverGalleryImages.length > 0)
  ? riverGalleryImages
  : (isKorean && koreanGalleryImages.length > 0)
  ? koreanGalleryImages
  : (isIndian && indianGalleryImages.length > 0)
  ? indianGalleryImages
  : (isSuperior && superiorGalleryImages.length > 0)
  ? superiorGalleryImages
  : (isPinus && pinusGalleryImages.length > 0)
  ? pinusGalleryImages
  : (isGround && groundGalleryImages.length > 0)
  ? groundGalleryImages
  : (campGalleries[camp.id] || [
      { src: camp.editorialImage || camp.image, caption: camp.name, subtitle: camp.setting },
      { src: "/images/accommodations/deluxe-camp-new.jpg", caption: "Kabin & Tenda Kayu", subtitle: "Arsitektur Alami Pegunungan" },
      { src: "/images/accommodations/river-camp-editorial.jpg", caption: "Aliran Sungai Alami", subtitle: "Kesejukan Air Lereng Wilis" },
