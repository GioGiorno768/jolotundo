<!-- 
  SECTION: RENTAL CAMPING GEAR (PERALATAN)
  - Design Philosophy: Minimalist Luxury & Brutalist Clean Elegance
  - Typography: Editorial Sans + Monospace Tag System (Identik GoUncharted)
  - Responsive: 2-Column Split on Desktop, Stacked on Mobile
  - Zero Rounded Corners: Sharp, Pure Architectural Lines
-->
<section id="rental-gear" class="relative z-20 bg-[#f4efe6] text-[#141110] border-t border-[#141110]/15 py-16 sm:py-24 px-6 sm:px-10 lg:px-14 xl:px-20 transition-colors duration-300">
  <div class="max-w-[1680px] mx-auto flex flex-col gap-10 sm:gap-14">

    <!-- Section Header (Editorial Monospace Tag + Bold Title) -->
