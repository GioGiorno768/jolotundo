        </div>

        <!-- Inventory Rows -->
        <div class="flex flex-col divide-y divide-[#141110]/15">
          {rentalGears.map((item) => (
            <div class="group py-4 sm:py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-6 hover:bg-[#141110]/[0.03] px-2 sm:px-3 transition-colors duration-200">
              
              <!-- Left side: Number + Title + Details -->
              <div class="flex items-start gap-3 sm:gap-4 flex-1">
                <span class="text-xs font-mono-tag font-bold text-[#141110]/40 group-hover:text-[#141110] transition-colors mt-0.5 shrink-0">
                  {item.index}
                </span>

                <div class="flex flex-col gap-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="text-base sm:text-lg font-bold font-sans text-[#141110] tracking-tight group-hover:text-black">
                      {item.name}
                    </h3>
                    {item.badge && (
                      <span class="text-[9px] font-mono-tag font-bold uppercase tracking-widest px-2 py-0.5 bg-[#141110] text-[#f4efe6] border border-[#141110]">
                        {item.badge}
                      </span>
                    )}
                  </div>
                  <p class="text-xs text-[#141110]/65 leading-relaxed font-sans max-w-xl">
                    {item.detail}
                  </p>
                </div>
              </div>

              <!-- Right side: Price + Quick WhatsApp Link -->
              <div class="flex sm:flex-col items-center sm:items-end justify-between sm:justify-center gap-2 pl-7 sm:pl-0 shrink-0">
                <span class="text-base sm:text-lg font-bold font-mono-tag text-[#141110] tracking-tight">
                  {item.price}
                </span>
                
                <a 
                  href={`https://wa.me/${siteData.brand.whatsapp}?text=${encodeURIComponent(`Halo Admin Jolotundo, saya ingin menyewa: *${item.waItem}*. Apakah unit tersedia?`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-[11px] font-mono-tag text-[#141110]/60 hover:text-[#141110] underline underline-offset-4 font-semibold uppercase tracking-wider transition-colors"
                  aria-label={`Sewa ${item.name}`}
