      <div>
        <div class="flex items-center gap-2.5 text-xs font-mono-tag text-[#141110]/70 tracking-widest uppercase mb-3">
          <span class="w-1.5 h-1.5 bg-[#141110]"></span>
          <span>PERLENGKAPAN CAMPING // RENTAL GEAR</span>
        </div>
        <h2 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#141110] uppercase leading-none font-sans">
          Rental Camping Gear
        </h2>
      </div>

      <div class="text-[11px] font-mono-tag text-[#141110]/60 uppercase tracking-widest flex items-center gap-2 self-start sm:self-auto">
        <span class="inline-block w-1.5 h-1.5 bg-emerald-700 animate-pulse"></span>
        <span>BERSIH • HIGIENIS • DIANTAR KE TENDA</span>
      </div>
    </div>

    <!-- Main Content: Split Layout (Left Editorial Showcase, Right Inventory Price List) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 xl:gap-20 items-start">

      <!-- LEFT COLUMN: Gear Visual & Concierge Guarantees (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col gap-6 lg:sticky lg:top-28">
        
        <!-- Gear Showcase Photo Frame with Pure Hardware-Accelerated Parallax Engine -->
        <div class="relative w-full aspect-[4/3] sm:aspect-[16/11] overflow-hidden bg-[#141110] border border-[#141110]/20 shadow-xl group">
          
          <!-- Inner Parallax Layer (Taller than container: 140% height with -20% offset, translates along Y on scroll) -->
          <div 
            id="rental-gear-parallax" 
            class="absolute inset-x-0 w-full h-[140%] -top-[20%] will-change-transform"
            style="transform: translate3d(0, 0px, 0);"
