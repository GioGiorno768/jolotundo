<!-- 
  =============================================================================
  SECTION: PAKET UPGRADE JOURNEY CAMP (1:1 GoUncharted Clean Editorial Card)
  - Mobile Optimized: Button sits cleanly to the right of title (no awkward stacking)
  - Zero Awkward Wrapping: Concise kicker, compact tags & clean quantity formatting
  - FAB WhatsApp Clearance: Safe right-side breathing room to prevent overlap
  =============================================================================
-->
<section id="paket-upgrade" class="relative z-20 bg-[#f4efe6] text-[#141110] border-t border-[#141110]/15 py-14 sm:py-20 px-4 sm:px-8 lg:px-14 xl:px-20 transition-colors duration-300">
  <div class="max-w-[1600px] mx-auto flex flex-col gap-8 sm:gap-12">

    <!-- Section Header (Clean Editorial Monospace Tag + Title) -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-5 border-b border-[#141110]/15">
      <div>
        <div class="flex items-center gap-2 text-xs font-mono-tag text-[#141110]/70 tracking-widest uppercase mb-2">
          <span class="w-1.5 h-1.5 bg-[#141110]"></span>
          <span>UPGRADE JOURNEY CAMP // LEVEL-UP</span>
        </div>
        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#141110] uppercase leading-none font-sans">
          Paket Upgrade Journey Camp
        </h2>
        <p class="text-xs sm:text-sm text-[#141110]/75 font-sans mt-2 max-w-2xl leading-relaxed">
          Tingkatkan kenyamanan tenda reguler Anda dengan paket upgrade perlengkapan tidur, hiburan, dan aktivitas outdoor:
        </p>
      </div>

      <div class="text-[11px] font-mono-tag text-[#141110]/60 uppercase tracking-widest flex items-center gap-2 self-start sm:self-auto shrink-0">
        <span class="inline-block w-1.5 h-1.5 bg-amber-600 animate-pulse"></span>
        <span>04 PAKET • GULIR UNTUK MELIHAT</span>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- STACKING CARDS DECK CONTAINER                                             -->
    <!-- ========================================================================= -->
    <div id="upgrade-stack-container" class="relative w-full flex flex-col pb-8">
      {upgradePackages.map((pkg, idx) => (
        <div 
          id={`upgrade-card-wrapper-${idx}`}
          class="upgrade-card-wrapper w-full sticky will-change-transform"
          style={`top: calc(6.5rem + ${idx * 2}rem); z-index: ${10 + idx * 5}; margin-bottom: ${idx === upgradePackages.length - 1 ? '1.5rem' : '28vh'};`}
          data-index={idx}
        >
          <!-- 1:1 GoUncharted Physical Card Frame (Full-Bleed, Minimalist, Ultra-Clean Mobile) -->
          <article 
            id={`upgrade-card-${idx}`}
            class="upgrade-card relative w-full min-h-[350px] sm:min-h-[400px] lg:h-[460px] bg-[#141110] text-[#f4efe6] border border-white/15 overflow-hidden shadow-[0_-15px_40px_rgba(0,0,0,0.5)] transition-all duration-300 ease-out origin-top flex flex-col justify-between p-4 sm:p-7 lg:p-9 select-none group"
          >
            
            <!-- Full-Bleed Background Image (With Smooth Zoom on Hover) -->
            <img 
              src={pkg.image} 
              alt={`${pkg.code} - ${pkg.title}`}
              class="absolute inset-0 w-full h-full object-cover object-center transform scale-100 group-hover:scale-105 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
              loading="lazy"
              decoding="async"
            />

            <!-- Soft Contrast Vignette Gradient (Identical to GoUncharted: Clear upper image, razor-sharp bottom text) -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/60 to-black/30 pointer-events-none"></div>

            <!-- TOP BAR: 100% Single-Line Clean Kicker (No Awkward Line Wrapping) -->
            <div class="relative z-10 flex items-center justify-between gap-2 select-none">
              <div class="flex items-center gap-1.5 sm:gap-2 text-xs font-mono-tag tracking-wider text-white/90 uppercase whitespace-nowrap">
                <span class="text-[#d8c39e] font-bold">—</span>
                <span class="font-bold tracking-widest">{pkg.code}</span>
                <span class="text-white/30 hidden xs:inline">•</span>
                <span class="text-[10px] text-[#d8c39e] font-medium hidden sm:inline tracking-wider">{pkg.badge}</span>
              </div>

              <!-- Top Right Price Pill -->
              <div class="flex items-center shrink-0">
                <span class="text-xs sm:text-sm font-mono-tag font-bold text-[#d8c39e] tracking-tight bg-black/75 backdrop-blur-md px-2.5 sm:px-3 py-1 border border-white/15 whitespace-nowrap">
                  {pkg.price}
                </span>
              </div>
            </div>

            <!-- BOTTOM CONTENT: Title + Right Button + Hairline Divider + 4 Complete Specs -->
            <div class="relative z-10 flex flex-col gap-3 sm:gap-4 mt-auto">
              
              <!-- Title & Right Button Row (Directly Side-by-Side: No Giant Stacked White Block) -->
