                  href={`https://wa.me/${siteData.brand.whatsapp}?text=${encodeURIComponent(pkg.waText)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-5 py-2 sm:py-2.5 bg-[#f4efe6] hover:bg-white text-[#141110] font-mono-tag text-[11px] sm:text-xs font-bold uppercase tracking-wider transition-all duration-200 border border-[#f4efe6] hover:shadow-[0_0_20px_rgba(255,255,255,0.35)] shrink-0 whitespace-nowrap"
                >
                  <span>Pesan {pkg.code}</span>
                  <span>↗</span>
                </a>
              </div>

              <!-- Thin Hairline Divider Line (1:1 with GoUncharted) -->
              <div class="w-full border-t border-white/20"></div>

              <!-- 4-Column Metadata Grid (With WhatsApp FAB Clearance pr-14 on mobile) -->
              <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-5 pr-12 sm:pr-0">
                <div>
                  <span class="text-[9px] sm:text-[10px] font-mono-tag text-white/50 tracking-widest uppercase block mb-0.5">
                    <span class="sm:hidden">TIDUR</span>
                    <span class="hidden sm:inline">PERLENGKAPAN TIDUR</span>
                  </span>
                  <span class="text-[11px] sm:text-[13px] font-medium text-white font-sans block leading-tight">
                    {pkg.bedding}
                  </span>
                </div>

                <div>
                  <span class="text-[9px] sm:text-[10px] font-mono-tag text-white/50 tracking-widest uppercase block mb-0.5">
                    <span class="sm:hidden">SANTAI</span>
                    <span class="hidden sm:inline">AREA SANTAI</span>
                  </span>
                  <span class="text-[11px] sm:text-[13px] font-medium text-white font-sans block leading-tight">
                    {pkg.seating}
                  </span>
                </div>

                <div>
                  <span class="text-[9px] sm:text-[10px] font-mono-tag text-white/50 tracking-widest uppercase block mb-0.5">
                    <span class="sm:hidden">KULINER</span>
                    <span class="hidden sm:inline">KULINER & BBQ</span>
                  </span>
                  <span class="text-[11px] sm:text-[13px] font-medium text-white font-sans block leading-tight">
                    {pkg.culinary}
                  </span>
                </div>

                <div>
                  <span class="text-[9px] sm:text-[10px] font-mono-tag text-white/50 tracking-widest uppercase block mb-0.5">
                    <span class="sm:hidden">AKTIVITAS</span>
                    <span class="hidden sm:inline">AKTIVITAS & WAHANA</span>
                  </span>
                  <span class="text-[11px] sm:text-[13px] font-medium text-white font-sans block leading-tight">
                    {pkg.activity}
                  </span>
                </div>
              </div>

            </div>

          </article>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- ========================================================================= -->
<!-- STACKING SCRIPT: DEPTH ILLUSION & CLICK TO EXPAND                         -->
<!-- ========================================================================= -->
<script is:inline>
  function initUpgradeStack() {
    const section = document.getElementById('paket-upgrade');
    const wrappers = document.querySelectorAll('.upgrade-card-wrapper');
    if (!section || !wrappers.length) return;

    // Handle smooth clicking on card headers
    wrappers.forEach((wrapper, idx) => {
      wrapper.addEventListener('click', (e) => {
        const isLink = e.target.closest('a');
        if (isLink) return;

        // @ts-ignore
        const lenis = window.__lenis;
        const targetTop = wrapper.offsetTop - (idx * 32) - 80;
        
        if (lenis) {
          lenis.scrollTo(wrapper, { offset: -(idx * 32) - 80, duration: 0.8 });
        } else {
          window.scrollTo({
            top: targetTop,
            behavior: 'smooth'
          });
        }
      });
    });

    // Tactile depth scroll handler: subtle scale down on buried cards
    function onScrollStack() {
      wrappers.forEach((wrapper, idx) => {
        if (idx === wrappers.length - 1) return; // Don't scale last card

        const nextWrapper = wrappers[idx + 1];
        if (!nextWrapper) return;

        const nextRect = nextWrapper.getBoundingClientRect();
        const wrapperRect = wrapper.getBoundingClientRect();
        
        const cardInner = wrapper.querySelector('.upgrade-card');
        if (!cardInner) return;

        // When next card approaches or overlaps, scale down slightly & dim
        if (nextRect.top <= wrapperRect.bottom) {
          const overlap = wrapperRect.bottom - nextRect.top;
          const maxOverlap = wrapperRect.height;
          const progress = Math.max(0, Math.min(1, overlap / (maxOverlap * 0.75)));

          const scale = 1 - progress * 0.035; // 1.0 -> 0.965
          const brightness = 1 - progress * 0.22; // 1.0 -> 0.78
          
          cardInner.style.transform = `scale(${scale.toFixed(4)})`;
          cardInner.style.filter = `brightness(${brightness.toFixed(3)})`;
        } else {
          cardInner.style.transform = 'scale(1)';
          cardInner.style.filter = 'brightness(1)';
        }
      });
    }

    let isTicking = false;
    let isIntersecting = false;

    function handleScroll() {
      if (!isTicking && isIntersecting) {
        requestAnimationFrame(() => {
          onScrollStack();
          isTicking = false;
        });
        isTicking = true;
      }
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        isIntersecting = entry.isIntersecting;
        if (isIntersecting) {
          onScrollStack();
        }
      });
    }, {
      root: null,
      threshold: 0,
      rootMargin: "200px 0px"
    });

    observer.observe(section);

    window.addEventListener('scroll', handleScroll, { passive: true });
    
    // Initial run
    onScrollStack();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initUpgradeStack);
  } else {
    initUpgradeStack();
  }
</script>
