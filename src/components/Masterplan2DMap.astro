// Masterplan2DMap.astro — High-Precision 1:1 Vector SVG Masterplan of Jolotundo Glamping & Edupark
// Every road vertex, river curve, creek bend, grass parcel, and all 100 tent coordinates (01–100)
// have been measured directly from the 1200x1650 coordinate grid overlaid on the official Denah Lokasi.

interface TentPlot {
  num: string;
  x: number;
  y: number;
  zone: string;
  desc: string;
}

function linePlots(
  nums: number[],
  x1: number,
  y1: number,
  x2: number,
  y2: number,
  zone: string,
  descTemplate: string
): TentPlot[] {
  const count = nums.length;
  return nums.map((n, idx) => {
    const t = count === 1 ? 0 : idx / (count - 1);
    const numStr = n < 10 ? `0${n}` : `${n}`;
    return {
      num: numStr,
      x: Math.round(x1 + (x2 - x1) * t),
      y: Math.round(y1 + (y2 - y1) * t),
      zone,
      desc: descTemplate.replace('{NUM}', numStr)
    };
  });
}

function customPlots(
  coords: Array<{ n: number; x: number; y: number }>,
  zone: string,
  descTemplate: string
): TentPlot[] {
  return coords.map(({ n, x, y }) => {
    const numStr = n < 10 ? `0${n}` : `${n}`;
    return {
      num: numStr,
      x,
      y,
      zone,
      desc: descTemplate.replace('{NUM}', numStr)
    };
  });
}

