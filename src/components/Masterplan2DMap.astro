<section id="masterplan-2d-section" class="relative w-full bg-[#f4efe6] text-[#141110] pt-8 sm:pt-12 pb-20">
  <div class="max-w-[1680px] mx-auto px-4 sm:px-8 lg:px-14 xl:px-20">

    <!-- ========================================================================= -->
    <!-- 1. INTERACTIVE TOOLBAR: FILTER ZONA, PENCARIAN NOMOR TENDA & KONTROL ZOOM -->
    <!-- ========================================================================= -->
    <div class="border border-[#141110]/20 bg-transparent p-4 sm:p-6 mb-6 flex flex-col gap-4">
      
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-[#141110]/15 pb-4">
        
        <!-- Filter Category Pills -->
        <div class="flex flex-wrap items-center gap-2" id="map-filter-group">
          <button type="button" data-filter="all" class="map-filter-btn active px-3.5 py-2 text-xs font-mono-tag uppercase tracking-wider bg-[#141110] text-[#f4efe6] border border-[#141110] font-bold cursor-pointer transition-all">
            Semua Zona
          </button>
          <button type="button" data-filter="camping" class="map-filter-btn px-3.5 py-2 text-xs font-mono-tag uppercase tracking-wider bg-transparent text-[#141110] border border-[#141110]/25 hover:border-[#141110] cursor-pointer transition-all">
            Tenda Camp (01–100)
          </button>
          <button type="button" data-filter="glamping" class="map-filter-btn px-3.5 py-2 text-xs font-mono-tag uppercase tracking-wider bg-transparent text-[#141110] border border-[#141110]/25 hover:border-[#141110] cursor-pointer transition-all">
            Korean Glamping &amp; Cabin
          </button>
          <button type="button" data-filter="wahana" class="map-filter-btn px-3.5 py-2 text-xs font-mono-tag uppercase tracking-wider bg-transparent text-[#141110] border border-[#141110]/25 hover:border-[#141110] cursor-pointer transition-all">
            Stable Kuda &amp; Outbound
          </button>
          <button type="button" data-filter="kuliner" class="map-filter-btn px-3.5 py-2 text-xs font-mono-tag uppercase tracking-wider bg-transparent text-[#141110] border border-[#141110]/25 hover:border-[#141110] cursor-pointer transition-all">
            River Breeze &amp; Cafe
          </button>
          <button type="button" data-filter="fasilitas" class="map-filter-btn px-3.5 py-2 text-xs font-mono-tag uppercase tracking-wider bg-transparent text-[#141110] border border-[#141110]/25 hover:border-[#141110] cursor-pointer transition-all">
            Aula, Mushola &amp; Parkir
          </button>
        </div>

        <!-- Search Tent Number / Facility -->
        <div class="flex items-center gap-2 shrink-0">
          <div class="relative flex-1 sm:w-64">
            <input 
              id="map-search-input"
              type="text" 
              placeholder="Ketik No. Tenda (01-100) / Area..." 
              class="w-full px-3.5 py-2 text-xs font-mono-tag bg-[#f4efe6] border border-[#141110]/30 text-[#141110] placeholder:text-[#141110]/45 focus:outline-none focus:border-[#141110]"
            />
          </div>
          <button 
            id="map-search-btn"
            type="button"
            class="px-4 py-2 bg-[#141110] text-[#f4efe6] text-xs font-mono-tag font-bold uppercase tracking-wider hover:bg-black cursor-pointer shrink-0"
          >
            Cari ↗
          </button>
        </div>

      </div>

      <!-- Bottom Sub-bar: Interactive Instructions & Zoom Controls -->
      <div class="flex flex-wrap items-center justify-between gap-4 text-xs font-mono-tag">
        <div class="flex items-center gap-3">
          <span class="inline-block w-2 h-2 bg-emerald-700"></span>
          <span class="text-[#141110]/70 uppercase tracking-wider">
            100% INTERACTIVE SVG MASTERPLAN — KLIK TENDA / ZONA UNTUK DESKRIPSI POPUP • DRAG UNTUK GESER AREA
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="text-[#141110]/60 uppercase mr-1 hidden sm:inline">ZOOM PETA:</span>
          <button id="zoom-out-btn" type="button" class="w-8 h-8 border border-[#141110]/30 bg-transparent hover:bg-[#141110] hover:text-[#f4efe6] font-bold cursor-pointer flex items-center justify-center" title="Perkecil">−</button>
          <span id="zoom-level-indicator" class="px-3 h-8 border border-[#141110]/20 flex items-center justify-center font-bold text-[#141110] min-w-[60px]">100%</span>
          <button id="zoom-in-btn" type="button" class="w-8 h-8 border border-[#141110]/30 bg-transparent hover:bg-[#141110] hover:text-[#f4efe6] font-bold cursor-pointer flex items-center justify-center" title="Perbesar">+</button>
          <button id="zoom-reset-btn" type="button" class="px-3 h-8 border border-[#141110]/30 bg-transparent hover:bg-[#141110] hover:text-[#f4efe6] uppercase cursor-pointer">Reset</button>
        </div>
      </div>

    </div>

