            <button type="button" data-quick-zone="Area Outbound" class="quick-zone-btn flex items-center justify-between p-2.5 border border-[#141110]/15 hover:border-[#141110] text-left transition-colors cursor-pointer">
              <div class="flex items-center gap-2.5">
                <span class="w-3 h-3 bg-[#699e2c] inline-block shrink-0"></span>
                <span class="font-bold text-[#141110]">Lapangan Area Outbound</span>
              </div>
              <span class="text-[10px] font-mono-tag text-[#141110]/55">Sektor Timur →</span>
            </button>

            <button type="button" data-quick-zone="River Breeze" class="quick-zone-btn flex items-center justify-between p-2.5 border border-[#141110]/15 hover:border-[#141110] text-left transition-colors cursor-pointer">
              <div class="flex items-center gap-2.5">
                <span class="w-3 h-3 bg-[#6d6e71] inline-block shrink-0"></span>
                <span class="font-bold text-[#141110]">River Breeze &amp; Indoor Cafe</span>
              </div>
              <span class="text-[10px] font-mono-tag text-[#141110]/55">Tepi Sungai →</span>
            </button>

            <button type="button" data-quick-zone="Aula Kaca" class="quick-zone-btn flex items-center justify-between p-2.5 border border-[#141110]/15 hover:border-[#141110] text-left transition-colors cursor-pointer">
              <div class="flex items-center gap-2.5">
                <span class="w-3 h-3 bg-[#d9b382] border border-[#4a3520] inline-block shrink-0"></span>
                <span class="font-bold text-[#141110]">Aula, Resepsionis &amp; Mushola</span>
              </div>
              <span class="text-[10px] font-mono-tag text-[#141110]/55">Pintu Masuk →</span>
            </button>

            <button type="button" data-quick-zone="Deluxe Riverside Cabin #01" class="quick-zone-btn flex items-center justify-between p-2.5 border border-[#141110]/15 hover:border-[#141110] text-left transition-colors cursor-pointer">
              <div class="flex items-center gap-2.5">
                <span class="w-3 h-3 bg-[#8c5327] inline-block shrink-0"></span>
                <span class="font-bold text-[#141110]">10 Unit Deluxe Wooden Cabin</span>
              </div>
              <span class="text-[10px] font-mono-tag text-[#141110]/55">Tenggara →</span>
            </button>
          </div>

          <div class="pt-2 text-[11px] font-mono-tag text-[#141110]/60 leading-relaxed">
            • <strong>Sektor Barat (Kiri Sungai):</strong> Kavling Tenda 01–100, Area Komunal, Taman Anggrek &amp; 3 Kamar Mandi.<br/>
            • <strong>Sektor Timur (Kanan Sungai):</strong> Indian Camp, Camping Ground 1–100, Korean Glamping 1–13, River Lounge, Stable Kuda, Outbound, Aula, Cafe &amp; Parkir.
          </div>
        </div>

      </aside>

    </div>

  </div>
</section>

<style>
  .font-mono-tag {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  }
  .map-interactive-zone.is-dimmed {
    opacity: 0.18;
    transition: opacity 0.25s ease;
  }
  .map-interactive-zone.is-highlighted {
    opacity: 1;
    filter: drop-shadow(0 0 8px rgba(20, 17, 16, 0.45));
  }
</style>

<script is:inline>
  function initMasterplan2DMap() {
    const viewport = document.getElementById('map-pan-zoom-viewport');
    const svgMap = document.getElementById('interactive-svg-map');
    const highlightGroup = document.getElementById('map-highlight-group');
    const highlightOuter = document.getElementById('map-highlight-ring-outer');
    const highlightInner = document.getElementById('map-highlight-ring-inner');

    const callout = document.getElementById('map-floating-callout');
    const calloutBadge = document.getElementById('callout-badge');
    const calloutSub = document.getElementById('callout-sub');
    const calloutTitle = document.getElementById('callout-title');
    const calloutDesc = document.getElementById('callout-desc');
    const calloutLink = document.getElementById('callout-link');
    const calloutLinkText = document.getElementById('callout-link-text');
    const calloutCloseBtn = document.getElementById('callout-close-btn');

    const zoomInBtn = document.getElementById('zoom-in-btn');
    const zoomOutBtn = document.getElementById('zoom-out-btn');
    const zoomResetBtn = document.getElementById('zoom-reset-btn');
    const zoomIndicator = document.getElementById('zoom-level-indicator');
    const canvasZoomIn = document.getElementById('canvas-zoom-in');
    const canvasZoomOut = document.getElementById('canvas-zoom-out');
    const canvasZoomReset = document.getElementById('canvas-zoom-reset');

    const searchInput = document.getElementById('map-search-input');
    const searchBtn = document.getElementById('map-search-btn');
    const filterBtns = document.querySelectorAll('.map-filter-btn');
    const zones = document.querySelectorAll('.map-interactive-zone');
    const quickBtns = document.querySelectorAll('.quick-zone-btn');

    const titleEl = document.getElementById('inspector-title');
    const subEl = document.getElementById('inspector-sub');
    const descEl = document.getElementById('inspector-desc');
    const linkEl = document.getElementById('inspector-link');
    const linkLabelEl = document.getElementById('inspector-link-label');
    const badgeEl = document.getElementById('inspector-badge');

    if (!viewport || !svgMap) return;

    const MAP_W = 1200;
    const MAP_H = 1650;
    const MIN_ZOOM = 1.0;
    const MAX_ZOOM = 3.5;

    let zoom = 1.0;
    let vx = 0;
    let vy = 0;
    let vw = MAP_W;
    let vh = MAP_H;

    let activeAnchorX = null;
    let activeAnchorY = null;

    function clampViewBox() {
      vw = MAP_W / zoom;
      vh = MAP_H / zoom;
      const maxVx = Math.max(0, MAP_W - vw);
      const maxVy = Math.max(0, MAP_H - vh);
      vx = Math.max(0, Math.min(maxVx, vx));
      vy = Math.max(0, Math.min(maxVy, vy));
    }

    function updateCalloutPosition() {
      if (!callout || activeAnchorX === null || activeAnchorY === null) return;
      if (callout.classList.contains('hidden')) return;

      const rect = viewport.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      const relX = (activeAnchorX - vx) / vw;
      const relY = (activeAnchorY - vy) / vh;

      const pixelX = Math.max(155, Math.min(rect.width - 155, relX * rect.width));
      const pixelY = Math.max(185, Math.min(rect.height - 24, relY * rect.height));

      callout.style.left = `${pixelX.toFixed(1)}px`;
      callout.style.top = `${pixelY.toFixed(1)}px`;
    }

    function applyViewBox() {
      clampViewBox();
      svgMap.setAttribute('viewBox', `${vx.toFixed(1)} ${vy.toFixed(1)} ${vw.toFixed(1)} ${vh.toFixed(1)}`);
      if (zoomIndicator) {
        zoomIndicator.textContent = `${Math.round(zoom * 100)}%`;
      }
      updateCalloutPosition();
    }

    function zoomToPoint(newZoom, focusSvgX, focusSvgY) {
      const clampedZoom = Math.max(MIN_ZOOM, Math.min(MAX_ZOOM, newZoom));
      const cx = focusSvgX !== undefined ? focusSvgX : vx + vw / 2;
      const cy = focusSvgY !== undefined ? focusSvgY : vy + vh / 2;

      const relX = (cx - vx) / vw;
      const relY = (cy - vy) / vh;

      zoom = clampedZoom;
      vw = MAP_W / zoom;
      vh = MAP_H / zoom;

      vx = cx - relX * vw;
      vy = cy - relY * vh;

      applyViewBox();
    }

    function centerOnSvgPoint(targetX, targetY, targetZoom) {
      if (targetZoom && targetZoom > zoom) {
        zoom = Math.min(MAX_ZOOM, targetZoom);
      }
      vw = MAP_W / zoom;
      vh = MAP_H / zoom;
      vx = targetX - vw / 2;
      vy = targetY - vh / 2;
      applyViewBox();
    }

    function handleZoomIn() {
      zoomToPoint(zoom + 0.4, activeAnchorX ?? (vx + vw / 2), activeAnchorY ?? (vy + vh / 2));
    }
    function handleZoomOut() {
      zoomToPoint(zoom - 0.4, activeAnchorX ?? (vx + vw / 2), activeAnchorY ?? (vy + vh / 2));
    }
    function handleZoomReset() {
      zoom = 1.0;
      vx = 0;
      vy = 0;
      applyViewBox();
    }

    zoomInBtn?.addEventListener('click', handleZoomIn);
    canvasZoomIn?.addEventListener('click', handleZoomIn);
    zoomOutBtn?.addEventListener('click', handleZoomOut);
    canvasZoomOut?.addEventListener('click', handleZoomOut);
    zoomResetBtn?.addEventListener('click', handleZoomReset);
    canvasZoomReset?.addEventListener('click', handleZoomReset);

    viewport.addEventListener('wheel', (e) => {
      e.preventDefault();
      const rect = viewport.getBoundingClientRect();
      const mouseRelX = (e.clientX - rect.left) / rect.width;
      const mouseRelY = (e.clientY - rect.top) / rect.height;
      const focusX = vx + mouseRelX * vw;
      const focusY = vy + mouseRelY * vh;

      const delta = e.deltaY < 0 ? 0.28 : -0.28;
      zoomToPoint(zoom + delta, focusX, focusY);
    }, { passive: false });

    let isDragging = false;
    let dragMoved = false;
    let startClientX = 0;
    let startClientY = 0;
    let startVx = 0;
    let startVy = 0;

    viewport.addEventListener('mousedown', (e) => {
      if (callout && callout.contains(e.target)) return;
      isDragging = true;
      dragMoved = false;
      startClientX = e.clientX;
      startClientY = e.clientY;
      startVx = vx;
      startVy = vy;
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - startClientX;
      const dy = e.clientY - startClientY;
      if (Math.abs(dx) > 4 || Math.abs(dy) > 4) {
        dragMoved = true;
      }

      const rect = viewport.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      if (zoom <= 1.01 && dragMoved) {
        zoom = 1.35;
        vw = MAP_W / zoom;
        vh = MAP_H / zoom;
        startVx = (MAP_W - vw) / 2;
        startVy = (MAP_H - vh) / 2;
      }

      const svgDx = (dx / rect.width) * vw;
      const svgDy = (dy / rect.height) * vh;

      vx = startVx - svgDx;
      vy = startVy - svgDy;
      applyViewBox();
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
    });

    viewport.addEventListener('touchstart', (e) => {
      if (callout && callout.contains(e.target)) return;
      if (e.touches.length === 1) {
        isDragging = true;
        dragMoved = false;
        startClientX = e.touches[0].clientX;
        startClientY = e.touches[0].clientY;
        startVx = vx;
        startVy = vy;
      }
    }, { passive: true });

    viewport.addEventListener('touchmove', (e) => {
      if (!isDragging || e.touches.length !== 1) return;
      const dx = e.touches[0].clientX - startClientX;
      const dy = e.touches[0].clientY - startClientY;
      if (Math.abs(dx) > 4 || Math.abs(dy) > 4) {
        dragMoved = true;
      }
      const rect = viewport.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      const svgDx = (dx / rect.width) * vw;
      const svgDy = (dy / rect.height) * vh;

      vx = startVx - svgDx;
      vy = startVy - svgDy;
      applyViewBox();
    }, { passive: true });

    viewport.addEventListener('touchend', () => {
      isDragging = false;
    });

    calloutCloseBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      callout?.classList.add('hidden');
      highlightGroup?.classList.add('hidden');
      activeAnchorX = null;
      activeAnchorY = null;
    });

    function selectZoneElement(el, autoZoomIn = false) {
      const title = el.getAttribute('data-zone-title') || 'Zona Jolotundo';
      const sub = el.getAttribute('data-zone-sub') || 'KAWASAN UTAMA';
      const desc = el.getAttribute('data-zone-desc') || '';
      const link = el.getAttribute('data-zone-link') || '/akomodasi';
      const cat = (el.getAttribute('data-zone-category') || 'ZONA').toUpperCase();

      const actionLabel = link.includes('wahana')
        ? 'Lihat Detail Wahana'
        : link.includes('event')
        ? 'Lihat Detail Venue & Event'
        : 'Lihat Detail & Reservasi';

      if (titleEl) titleEl.textContent = title;
      if (subEl) subEl.textContent = sub;
      if (descEl) descEl.textContent = desc;
      if (badgeEl) badgeEl.textContent = cat;
      if (linkEl) linkEl.setAttribute('href', link);
      if (linkLabelEl) linkLabelEl.textContent = actionLabel;

      let ax = parseFloat(el.getAttribute('data-anchor-x') || '');
      let ay = parseFloat(el.getAttribute('data-anchor-y') || '');

      if (isNaN(ax) || isNaN(ay)) {
        const transformAttr = el.getAttribute('transform') || '';
        const match = transformAttr.match(/translate\(([-0-9.]+),\s*([-0-9.]+)\)/);
        if (match) {
          ax = parseFloat(match[1]);
          ay = parseFloat(match[2]);
        } else {
          ax = 600;
          ay = 820;
        }
      }

      activeAnchorX = ax;
      activeAnchorY = ay;

      if (highlightGroup && highlightOuter && highlightInner) {
        highlightOuter.setAttribute('cx', String(ax));
        highlightOuter.setAttribute('cy', String(ay));
        highlightInner.setAttribute('cx', String(ax));
        highlightInner.setAttribute('cy', String(ay));
        highlightGroup.classList.remove('hidden');
      }

      if (callout) {
        if (calloutBadge) calloutBadge.textContent = cat;
        if (calloutSub) calloutSub.textContent = sub;
        if (calloutTitle) calloutTitle.textContent = title;
        if (calloutDesc) calloutDesc.textContent = desc;
        if (calloutLink) calloutLink.setAttribute('href', link);
        if (calloutLinkText) calloutLinkText.textContent = actionLabel;
        callout.classList.remove('hidden');
      }

      if (autoZoomIn) {
        centerOnSvgPoint(ax, ay, Math.max(zoom, 1.85));
      } else {
        updateCalloutPosition();
      }
    }

    zones.forEach((zone) => {
      zone.addEventListener('click', (e) => {
        e.stopPropagation();
        if (dragMoved) return;
        selectZoneElement(zone, false);
      });
    });

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        filterBtns.forEach((b) => {
          b.className = 'map-filter-btn px-3.5 py-2 text-xs font-mono-tag uppercase tracking-wider bg-transparent text-[#141110] border border-[#141110]/25 hover:border-[#141110] cursor-pointer transition-all';
        });
        btn.className = 'map-filter-btn active px-3.5 py-2 text-xs font-mono-tag uppercase tracking-wider bg-[#141110] text-[#f4efe6] border border-[#141110] font-bold cursor-pointer transition-all';

        zones.forEach((z) => {
          const zCat = z.getAttribute('data-zone-category');
          if (filter === 'all' || zCat === filter) {
            z.classList.remove('is-dimmed');
            z.classList.add('is-highlighted');
          } else {
            z.classList.add('is-dimmed');
            z.classList.remove('is-highlighted');
          }
        });
      });
    });

    quickBtns.forEach((qBtn) => {
      qBtn.addEventListener('click', () => {
        const query = qBtn.getAttribute('data-quick-zone') || '';
        const target = Array.from(zones).find((z) =>
          (z.getAttribute('data-zone-title') || '').toLowerCase().includes(query.toLowerCase())
        );
        if (target) {
          selectZoneElement(target, true);
        }
      });
    });

    function handleSearch() {
      if (!searchInput) return;
      const raw = searchInput.value.trim();
      if (!raw) return;

      const numMatch = raw.match(/^\d+$/);
      if (numMatch) {
        const numInt = parseInt(raw, 10);
        const plotEl = document.getElementById(`tent-plot-${numInt}`);
        if (plotEl) {
          selectZoneElement(plotEl, true);
          return;
        }
      }

      const found = Array.from(zones).find((z) =>
        (z.getAttribute('data-zone-title') || '').toLowerCase().includes(raw.toLowerCase())
      );
      if (found) {
        selectZoneElement(found, true);
      }
    }

    searchBtn?.addEventListener('click', handleSearch);
    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') handleSearch();
    });

    window.addEventListener('resize', updateCalloutPosition);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMasterplan2DMap);
  } else {
    initMasterplan2DMap();
  }
</script>
