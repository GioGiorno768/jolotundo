---
import accommodations from '../data/accommodations.json';
import siteData from '../data/siteData.json';

// Curated 4 featured stays with asymmetrical layout configuration
const staysConfig = [
  {
    id: "deluxe-camp",
    gridClass: "col-span-12 lg:col-span-7 h-[540px] sm:h-[620px] lg:h-[660px]",
    featuredStay: accommodations.find((s) => s.id === "deluxe-camp")
  },
  {
    id: "river-camp",
    gridClass: "col-span-12 lg:col-span-5 h-[540px] sm:h-[620px] lg:h-[660px]",
    featuredStay: accommodations.find((s) => s.id === "river-camp")
  },
  {
    id: "korean-glamping",
    gridClass: "col-span-12 lg:col-span-5 h-[480px] sm:h-[540px] lg:h-[580px]",
    featuredStay: accommodations.find((s) => s.id === "korean-glamping")
  },
  {
    id: "pinus-camp",
    gridClass: "col-span-12 lg:col-span-7 h-[480px] sm:h-[540px] lg:h-[580px]",
    featuredStay: accommodations.find((s) => s.id === "pinus-camp")
  }
];
---

<!-- 
  SECTION 02 // SELEKSI AKOMODASI (Asymmetrical Editorial Architecture)
  - Layout Grid Dinamis: 7-5 & 5-7 Asymmetric Spans (Besar-Kecil Tidak Monoton)
  - Zero Rounded (Strictly Sharp Brutalist-Luxury Lines, no border-radius)
  - Keterangan & Detail berada di dalam gambar (In-Image Overlay)
  - Idle: Hanya menampilkan nama glamping
  - Hover: Image auto-scale, nama translate ke atas, muncul keterangan, tarif, dan tombol "Lihat Detail"
-->
<section id="akomodasi" class="relative z-20 bg-[#f4efe6] text-[#141110] border-t border-[#141110]/15 py-24 sm:py-32 px-6 sm:px-10 lg:px-14 xl:px-20 transition-colors duration-300">
  <div class="max-w-[1680px] mx-auto flex flex-col gap-10 sm:gap-14">

    <!-- Section Header (Sharp, Bold Editorial Typo) -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pb-6 border-b border-[#141110]/15">
      <div>
        <div class="flex items-center gap-2.5 text-xs font-mono-tag text-[#141110]/70 tracking-widest uppercase mb-3">
          <span class="w-1.5 h-1.5 bg-[#141110]"></span>
          <span>SELEKSI AKOMODASI</span>
        </div>
        <h2 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#141110] uppercase leading-none font-sans">
          Koleksi Menginap
        </h2>
      </div>

    </div>

    <!-- Asymmetrical Grid (Row 1: 7/5 | Row 2: 5/7) with Cinematic Focus Spotlight -->
    <div id="accommodation-grid" class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">
      {staysConfig.map((item) => {
        const stay = item.featuredStay;
        if (!stay) return null;

        return (
          <article 
            class={`camp-card group relative overflow-hidden bg-[#141110] border border-[#141110]/20 select-none cursor-pointer ${item.gridClass}`}
            tabindex="0"
            role="button"
            aria-label={`Lihat detail ${stay.name}`}
          >
            
            <!-- Background Image with Butter-Smooth Scale on Hover/Active (Zero CSS filter overhead) -->
            <img 
              src={stay.editorialImage || stay.image} 
              alt={stay.name + " - Jolotundo Glamping & Edupark"}
              class="camp-img w-full h-full object-cover object-center transform scale-100 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
              loading="lazy"
              decoding="async"
            />

            <!-- Dark Gradient Layer (Soft on Idle, Deepens on Hover for Razor-Sharp Text Contrast) -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-transparent opacity-85 group-hover:opacity-95 transition-opacity duration-500 pointer-events-none"></div>

            <!-- Top Sharp Meta Badges (Index & Setting) -->
            <div class="absolute top-5 left-5 right-5 flex items-center justify-between pointer-events-none z-10">
              <span class="text-[10px] font-mono-tag tracking-[0.25em] text-[#d8c39e] uppercase px-3 py-1.5 bg-black/60 backdrop-blur-md border border-white/10 font-bold">
                INDEX // {stay.index}
              </span>
              <span class="text-[10px] font-mono-tag tracking-wider text-white/80 uppercase px-3 py-1.5 bg-black/60 backdrop-blur-md border border-white/10">
                {stay.setting}
              </span>
            </div>

            <!-- In-Image Content Overlay (Docked at Bottom with generous padding to prevent text clipping) -->
            <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8 lg:p-10 pb-8 sm:pb-10 lg:pb-12 flex flex-col justify-end z-10 pointer-events-none">
              
              <!-- Glamping Name (Visible Idle -> Translates Upwards on Hover/Active) -->
              <div class="camp-title-wrap">
                <span class="text-[11px] font-mono-tag text-[#d8c39e] uppercase tracking-widest block mb-1 font-semibold">
                  {stay.tier}
                </span>
                <h3 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white uppercase leading-none font-sans drop-shadow-md">
                  {stay.name}
                </h3>
              </div>

              <!-- Collapsible Reveal Drawer (Hidden on Idle -> Expands & Fades In on Hover/Active) -->
              <div class="camp-drawer">
                <div class="camp-drawer-inner">
                  <div class="camp-drawer-content pt-3.5 pb-2 flex flex-col gap-3.5 pointer-events-auto">
                    
                    <!-- Keterangan / Editorial Tagline -->
                    <p class="text-xs sm:text-sm text-white/85 font-light leading-relaxed max-w-xl">
                      {stay.editorialTagline || stay.tagline}
                    </p>

                    <!-- Feature Pills (Sharp rectangular pills) -->
                    <div class="flex flex-wrap gap-2">
                      {(stay.pills || [stay.setting, stay.capacity, stay.elevation]).map((pill) => (
                        <span class="text-[10px] font-mono-tag text-white/90 bg-white/10 backdrop-blur-sm px-2.5 py-1 border border-white/15">
                          {pill}
                        </span>
                      ))}
                    </div>

                    <!-- Direct Action: Button Lihat Detail (Tanpa Pricelist) -->
                    <div class="pt-3.5 pb-1 border-t border-white/15 flex items-center justify-between gap-3">
                      <div class="flex items-center gap-2">
                        <span class="w-1.5 h-1.5 bg-[#d8c39e] inline-block"></span>
                        <span class="text-[10px] sm:text-[11px] font-mono-tag text-white/70 uppercase tracking-wider">
                          Ketersediaan & Fasilitas
                        </span>
                      </div>

                      <div class="flex items-center gap-2">
                        <!-- Direct Link to Camp Detail Page -->
                        <a
                          href={`/akomodasi/${stay.id}`}
                          class="inline-flex items-center gap-1.5 px-3.5 sm:px-4 py-2 bg-white/15 hover:bg-white text-white hover:text-black font-mono-tag text-xs font-bold uppercase tracking-wider transition-all duration-200 border border-white/20 shrink-0"
                        >
                          <span>Detail</span>
                          <span>↗</span>
                        </a>

                        <!-- Direct Booking Button to https://jolotundo.netlify.app/ -->
                        <a
                          href="https://jolotundo.netlify.app/"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 px-3.5 sm:px-4 py-2 bg-[#f4efe6] hover:bg-white text-[#141110] font-mono-tag text-xs font-bold uppercase tracking-wider transition-all duration-200 border border-[#f4efe6] hover:shadow-[0_0_20px_rgba(255,255,255,0.35)] shrink-0"
                        >
                          <span>Pesan Tenda</span>
                          <span>↗</span>
                        </a>
                      </div>
                    </div>

                  </div>
                </div>
              </div>

            </div>

          </article>
        );
      })}
    </div>

    <!-- Centered Action Under Content (Sharp, Zero Rounded) -->
    <div class="pt-6 sm:pt-10 flex flex-col items-center justify-center gap-3 text-center">
      <a 
        href="/akomodasi"
        class="group inline-flex items-center gap-3 px-8 py-4 bg-[#141110] hover:bg-black text-[#f4efe6] font-mono-tag text-xs sm:text-sm font-bold uppercase tracking-wider transition-all duration-300 border border-[#141110] shadow-sm hover:shadow-[0_8px_30px_rgba(0,0,0,0.18)] cursor-pointer"
      >
        <span>Lihat Selengkapnya</span>
        <span class="w-5 h-5 flex items-center justify-center bg-white/15 group-hover:bg-white text-white group-hover:text-black transition-all duration-300 text-xs">
          ↗
        </span>
      </a>
      <span class="text-[10px] font-mono-tag text-[#141110]/50 uppercase tracking-widest">
        KATALOG LENGKAP 7 KATEGORI AKOMODASI & RESERVASI
      </span>
    </div>

  </div>
</section>

<!-- Cinematic Spotlight Focus & Card Scale Interaction -->
<style>
  /* Desktop spotlight: when any card is hovered, other cards smoothly blur, dim, and scale down */
  @media (hover: hover) and (pointer: fine) {
    #accommodation-grid:has(.camp-card:hover) .camp-card:not(:hover) {
      filter: blur(4px) brightness(0.7);
      opacity: 0.42;
      transform: scale3d(0.985, 0.985, 1);
    }
  }

  /* Card base transition physics */
  .camp-card {
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.65s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.65s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    touch-action: manipulation;
  }

  /* Active or hovered card elevation */
  @media (hover: hover) and (pointer: fine) {
    .camp-card:hover {
      transform: scale3d(1.025, 1.025, 1);
      z-index: 25;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
      border-color: rgba(216, 195, 158, 0.5);
      filter: blur(0) brightness(1);
      opacity: 1;
    }
  }

  .camp-card.is-active {
    border-color: rgba(216, 195, 158, 0.5);
    opacity: 1;
  }

  /* Title upward translation */
  .camp-title-wrap {
    transform: translate3d(0, 0, 0);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .camp-card:hover .camp-title-wrap,
  .camp-card.is-active .camp-title-wrap {
    transform: translate3d(0, -10px, 0);
  }

  /* Drawer base state (Both Desktop & Mobile: collapsible 0fr -> 1fr slide up) */
  .camp-drawer {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.45s ease;
    will-change: grid-template-rows, opacity;
  }

  /* Drawer expansion on hover or tap/active */
  .camp-card:hover .camp-drawer,
  .camp-card.is-active .camp-drawer {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .camp-drawer-inner {
    overflow: hidden;
  }

  /* Drawer content translation: pure GPU translate3d + opacity slide up */
  .camp-drawer-content {
    transform: translate3d(0, 28px, 0);
    opacity: 0;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.5s ease;
    will-change: transform, opacity;
  }

  .camp-card:hover .camp-drawer-content,
  .camp-card.is-active .camp-drawer-content {
    transform: translate3d(0, 0, 0);
    opacity: 1;
  }

  /* Background image scale (pure GPU transform, no CSS filter) */
  .camp-card:hover .camp-img,
  .camp-card.is-active .camp-img {
    transform: scale3d(1.06, 1.06, 1);
  }
</style>

<!-- Mobile On-Screen Auto Reveal & Touch Script -->
<script is:inline>
  function initCampCardInteractions() {
    const grid = document.getElementById('accommodation-grid');
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll('.camp-card'));

    // Check if device is mobile or touchscreen
    const isMobile = window.matchMedia('(max-width: 1023px)').matches || ('ontouchstart' in window);

    // 1. MOBILE ON-SCREEN AUTO REVEAL (IntersectionObserver)
    // As each camp card scrolls into the comfortable viewing center of the screen, it automatically activates!
    if (isMobile && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const card = entry.target;
          if (entry.isIntersecting) {
            card.classList.add('is-active');
          } else {
            card.classList.remove('is-active');
          }
        });
      }, {
        root: null,
        rootMargin: '-8% 0px -12% 0px',
        threshold: 0.18
      });

      cards.forEach((card) => observer.observe(card));
    }

    // 2. TAP / CLICK TOGGLE (Manual override on tap)
    cards.forEach((card) => {
      card.addEventListener('click', (e) => {
        // If clicking directly on a button or link inside the card, allow normal link navigation
        const target = e.target;
        if (target && target.closest && (target.closest('a') || target.closest('button'))) {
          return;
        }

        const isCurrentlyActive = card.classList.contains('is-active');

        // Toggle state for tapped card
        if (isCurrentlyActive) {
          card.classList.remove('is-active');
        } else {
          cards.forEach((c) => c.classList.remove('is-active'));
          card.classList.add('is-active');
        }
      });
    });

    // Close on click outside the accommodation grid
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (target && target.closest && !target.closest('#accommodation-grid')) {
        cards.forEach((c) => c.classList.remove('is-active'));
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCampCardInteractions);
  } else {
    initCampCardInteractions();
  }
</script>
