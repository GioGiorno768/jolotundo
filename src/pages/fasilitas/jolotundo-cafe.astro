---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import FooterCTA from '../../components/FooterCTA.astro';
import siteData from '../../data/siteData.json';

// WhatsApp Order / Reservation URL
const waPhone = siteData.brand.whatsapp || "6282249828998";
const waUrl = `https://wa.me/${waPhone.replace(/[^0-9]/g, '')}?text=${encodeURIComponent("Halo Admin Jolotundo, saya ingin memesan menu Warung Ketan / Kopi di Jolotundo Cafe.")}`;

// Split kata untuk efek Scroll-Driven Word Reveal (1:1 GoUncharted Architecture)
const placeHeadline = "Aroma ketan hangat, seduhan kopi lereng Wilis, dan teduhnya bayang kanopi pinus yang memeluk senja.".split(" ");

// GoUncharted Hairline Metadata Table Rows (1:1 with Reference Design)
const placeTableRows = [
  {
    label: "SETTING",
    title: "Pine Forest Wooden Chalet",
    desc: "Pondok paviliun kayu pinus alami dengan area indoor hangat dan alfresco deck di bawah naungan pohon pinus."
  },
  {
    label: "KAPASITAS",
    title: "200 Kursi Tamu",
    desc: "Kombinasi bangku kayu solid, meja keluarga santai, dan area lesehan yang ramah anak serta nyaman untuk rombongan."
  },
  {
    label: "JAM BUKA",
    title: "07.00 — 22.00 WIB",
    desc: "Buka setiap hari melayani sarapan pagi sejuk berkabut, santap siang santai, hingga nongkrong malam syahdu."
  },
  {
    label: "SUASANA",
    title: "Sejuk Pegunungan (18°–22°C)",
    desc: "Udara murni pegunungan dengan aroma pinus alami dan pencahayaan warm ambient lembut saat petang tiba."
  },
  {
    label: "MENU UTAMA",
    title: "Warung Ketan, Bakso & Kopi",
    desc: "Ketan kelapa kedelai otentik, ketan durian lumer, bakso sapi kuah rempah, mie pedas, aneka Chinese snack & specialty coffee."
  },
  {
    label: "PEMESANAN",
    title: "Scan QR Meja & Kasir",
    desc: "Pemesanan mandiri cepat dan praktis via scan QR di masing-masing meja atau langsung melalui kasir sentral."
  },
  {
    label: "PEMBAYARAN",
    title: "Cashless QRIS & Tunai",
    desc: "Mendukung seluruh aplikasi dompet digital & mobile banking QRIS (BCA, Mandiri, BRI, GoPay, OVO, ShopeePay) serta tunai."
  }
];

// Curated Jolotundo Cafe Preview Gallery Images (Seluruh 4 Gambar dari resto/jolocafe)
const cafeGalleryImages = [
  {
    src: "/images/resto/jolocafe/jolo1.avif",
    caption: "Pondok Chalet Kayu & Warung Ketan",
    subtitle: "PONDOK KAYU HANGAT DI BAWAH KANOPI PINUS"
  },
  {
    src: "/images/resto/jolocafe/jolo2.avif",
    caption: "Ketan Tradisional & Kopi Hangat",
    subtitle: "PULEN HANGAT DENGAN TABURAN KELAPA & KEDELAI"
  },
  {
    src: "/images/resto/jolocafe/jolo3.avif",
    caption: "Area Duduk Alfresco Asri",
    subtitle: "TEMPAT BERSANTAI TEDUH DENGAN UDARA SEGAR"
  },
  {
    src: "/images/resto/jolocafe/jolo4.avif",
    caption: "Kehangatan Nongkrong & Kuliner",
    subtitle: "SAJIAN KHAS PEGUNUNGAN & BAKSO REMPAH"
  }
];

// Dynamic vertical scroll distance based on image count
const scrollHeightVh = Math.max(220, Math.min(320, 180 + cafeGalleryImages.length * 15));

// Daftar Bab Buku Menu Jolotundo Cafe (10 Halaman sesuai Menu PDF Resmi)
const menuChapters = [
  { page: 1, title: "Cover Menu" },
  { page: 2, title: "Panduan Order" },
  { page: 3, title: "Ayam & Nasi" },
  { page: 4, title: "Bakso & Mie" },
  { page: 5, title: "Nusantara Snack" },
  { page: 6, title: "Chinese Snack" },
  { page: 7, title: "Aneka Bapao" },
  { page: 8, title: "Menu Dessert" },
  { page: 9, title: "Kopi & Latte" },
  { page: 10, title: "Jus & Minuman Anak" }
];
---

<Layout
  title="Jolotundo Cafe & Warung Ketan | Kuliner Pinus & Kopi Lereng Wilis"
  description="Pondok cafe kayu pinus & warung ketan legendaris di Jolotundo Edupark Bajulan. Nikmati aneka olahan ketan pulen hangat, bakso kuah rempah, kudapan krispi, dan seduhan kopi lereng Wilis."
  image="/images/facilities/jolotundo-cafe-ketan.jpg"
>
  <!-- Fullscreen Floating Pill Navigation -->
  <Navbar />

  <main class="min-h-screen bg-[#f4efe6] text-[#141110] selection:bg-[#141110] selection:text-white">

    <!-- ========================================================================= -->
    <!-- 1. FULLSCREEN EDITORIAL HERO (PARALLAX + BRUTALIST MONOSPACE METADATA)   -->
    <!-- ========================================================================= -->
    <header class="relative h-screen h-[100dvh] min-h-[100dvh] w-full flex flex-col justify-between overflow-hidden bg-[#141110] select-none">
      
      <!-- Parallax Background Image Layer with Cinematic Darkness -->
      <div 
        id="cafe-hero-parallax-layer"
        class="absolute inset-0 w-full h-[120%] -top-[10%] bg-cover bg-center will-change-transform"
        style="background-image: url('/images/resto/jolocafe/jolo1.avif');"
      >
        <!-- Sophisticated Editorial Film Gradient -->
        <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/45 to-black/90"></div>
        <div class="absolute inset-0 bg-radial-[circle_at_center,_var(--tw-gradient-stops)] from-transparent via-black/30 to-black/85"></div>
      </div>

      <!-- Top Hairline Spacer for Floating Navbar -->
      <div class="h-20 sm:h-28 shrink-0"></div>

      <!-- Center Editorial Display Typography -->
      <div class="relative z-10 w-full max-w-[1680px] mx-auto px-5 sm:px-12 lg:px-16 flex flex-col items-center text-center my-auto py-4 sm:py-8">
        
        <!-- Monospace Kicker Pill -->
        <span class="text-[10px] sm:text-xs font-mono-tag tracking-[0.2em] sm:tracking-[0.28em] uppercase text-[#d8c39e] mb-3 sm:mb-5 block drop-shadow">
          — WARUNG KETAN & KOPI PINUS
        </span>

        <!-- Clean, Powerful & Elegant Title -->
        <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-normal tracking-[-0.03em] text-white leading-[1.02] sm:leading-[0.96] font-sans drop-shadow-lg">
          Jolotundo Cafe.
        </h1>

        <!-- Simple, Clean & Poetic Subtitle -->
        <p class="text-xs sm:text-base md:text-lg font-sans text-white/80 max-w-md sm:max-w-xl mx-auto mt-3 sm:mt-5 drop-shadow leading-relaxed font-light">
          Hangatnya ketan tradisional legendaris dan seduhan kopi lereng Wilis di bawah naungan rimbun kanopi pinus.
        </p>

        <!-- Clean Subtle Action Links -->
        <div class="flex items-center gap-3 sm:gap-6 mt-6 sm:mt-10 text-[11px] sm:text-xs font-mono-tag tracking-wider uppercase">
          <a 
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 sm:px-5 py-2.5 sm:py-3 bg-[#d8c39e] hover:bg-white text-[#141110] font-bold transition-colors shadow-md flex items-center gap-1.5"
          >
            <span>Reservasi / Order</span>
            <span>↗</span>
          </a>
          <a 
            href="#daftar-menu" 
            class="px-3 py-2 text-white/80 hover:text-white transition-colors border-b border-white/40 pb-0.5 flex items-center gap-1"
          >
            <span>Buka Menu</span>
            <span>↓</span>
          </a>
        </div>
      </div>

      <!-- Bottom Metadata Bar: Clean Single Row on Mobile, Full on Desktop -->
      <div class="relative z-10 w-full px-5 sm:px-12 lg:px-16 pb-4 sm:pb-8 pt-3 border-t border-white/15 bg-gradient-to-t from-black/85 via-black/40 to-transparent shrink-0">
        <div class="max-w-[1680px] mx-auto flex items-center justify-between gap-2 text-[10px] sm:text-xs font-mono-tag tracking-wider sm:tracking-widest uppercase text-white/70">
          <div class="flex items-center gap-2 min-w-0">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
            <span class="text-white font-medium truncate">KANOPI PINUS BAJULAN</span>
          </div>
          <div class="flex items-center gap-2 sm:gap-6 text-white/60 shrink-0">
            <span class="hidden sm:inline">200 KURSI TAMU</span>
            <span class="hidden sm:inline">•</span>
            <span>07.00 — 22.00 WIB</span>
            <span>•</span>
            <span class="text-[#d8c39e] font-bold">FREE HTM</span>
          </div>
        </div>
      </div>
    </header>


    <!-- ========================================================================= -->
    <!-- 2. SECTION: — THE PLACE (1:1 GOUNCHARTED EDITORIAL WITH SCROLL REVEAL)   -->
    <!-- ========================================================================= -->
    <section id="the-place" class="py-20 sm:py-28 lg:py-36 px-6 sm:px-10 lg:px-16 xl:px-20 border-b border-[#141110]/15 scroll-mt-12 bg-[#f4efe6]">
      <div class="max-w-[1680px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 xl:gap-24 items-start">
        
        <!-- Left Column: — THE PLACE + Word-by-Word Scroll Reveal Headline + Subtitle -->
        <div class="lg:col-span-7 flex flex-col">
          
          <!-- Monospace Kicker with thin dash -->
          <span class="text-xs font-mono-tag tracking-[0.25em] text-[#141110]/60 uppercase mb-6 sm:mb-8 block">
            — THE PLACE
          </span>

          <!-- Big Typographic Headline with Word-by-Word Scroll Reveal -->
          <h2 
            id="place-reveal-heading"
            class="text-3xl sm:text-5xl md:text-6xl lg:text-[3.6rem] xl:text-[4.2rem] leading-[1.08] tracking-[-0.03em] text-[#141110] font-normal"
          >
            {placeHeadline.map((word) => (
              <span 
                class="reveal-word inline-block mr-[0.22em] transition-opacity duration-150 ease-out will-change-[opacity]" 
                style="opacity: 0.18;"
              >
                {word}
              </span>
            ))}
          </h2>

          <!-- Secondary Subtitle matching GoUncharted -->
          <p class="text-base sm:text-xl lg:text-2xl text-[#141110]/60 font-sans font-light leading-relaxed mt-8 sm:mt-12 max-w-2xl">
            Pondok kayu alami dengan aroma seduhan kopi khas Jawa Timur dan gurihnya ketan bertabur kelapa muda, menghadirkan suasana santai yang menghangatkan tubuh di tengah dinginnya udara lereng Wilis.
          </p>
        </div>

        <!-- Right Column: 1:1 GoUncharted Hairline Metadata Table -->
        <div class="lg:col-span-5 flex flex-col pt-2 lg:pt-4">
          <div class="border-t border-[#141110]/20 divide-y divide-[#141110]/20">
            {placeTableRows.map((row) => (
              <div class="py-5 sm:py-6 flex items-start gap-6 sm:gap-8">
                <!-- Left Tag / Label -->
                <span class="w-24 sm:w-32 shrink-0 text-xs font-mono-tag tracking-widest text-[#141110]/50 uppercase pt-0.5">
                  {row.label}
                </span>

                <!-- Right Spec & Description -->
                <div class="flex-1 flex flex-col gap-1">
                  <span class="text-base sm:text-lg font-bold text-[#141110] font-sans tracking-tight">
                    {row.title}
                  </span>
                  <span class="text-xs sm:text-sm text-[#141110]/65 font-sans font-light leading-relaxed">
                    {row.desc}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>


    <!-- ========================================================================= -->
    <!-- 3. OFFICIAL MENU BOOK PREVIEW (REALISTIC MENU BOOK SPREAD ARCHITECTURE)   -->
    <!-- ========================================================================= -->
    <section id="daftar-menu" class="py-16 sm:py-24 lg:py-32 px-4 sm:px-8 lg:px-14 xl:px-20 border-b border-[#141110]/15 bg-[#f4efe6] scroll-mt-14">
      <div class="max-w-[1680px] mx-auto">
        
        <!-- Typography: Header Kicker + Giant Headline + Editorial Description -->
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 pb-8 sm:pb-10 mb-8 sm:mb-12 border-b border-[#141110]/15">
          <div class="max-w-4xl">
            <!-- Subtle Kicker -->
            <span class="text-xs font-mono-tag tracking-[0.25em] text-[#141110]/60 uppercase mb-3 block">
              — BUKU MENU CAFE
            </span>
            <!-- Bold Display Headline -->
            <h2 class="text-3xl sm:text-5xl lg:text-6xl font-normal tracking-tight text-[#141110] leading-[1.02] font-sans">
              Buku Menu Resmi Jolotundo Cafe.
            </h2>
            <!-- Editorial Description -->
            <p class="text-sm sm:text-base lg:text-lg text-[#141110]/70 font-sans font-light leading-relaxed mt-4 sm:mt-5 max-w-3xl">
              Disajikan dengan format buku menu 3D interaktif layaknya memegang buku menu fisik di atas meja kayu pinus. Jelajahi 10 halaman sajian ketan aneka topping, bakso kuah rempah, mie lezat, aneka Chinese snack, dessert manis, hingga racikan kopi lereng Wilis.
            </p>
          </div>

          <!-- Quick Action Buttons -->
          <div class="flex flex-wrap items-center gap-3 shrink-0 self-start lg:self-end">
            <a 
              href="/docs/menu-jolotundo-cafe.pdf" 
              download="Menu-Jolotundo-Cafe.pdf"
              class="px-4 py-2.5 bg-white border border-[#141110]/20 hover:border-[#141110] text-[#141110] font-mono-tag text-xs font-semibold uppercase tracking-wider transition-colors shadow-sm flex items-center gap-2"
            >
              <span>Unduh PDF Resmi</span>
              <span>↓</span>
            </a>
            <a 
              href="https://heyzine.com/flip-book/642f8c2f3f.html" 
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2.5 bg-[#141110] hover:bg-black text-[#f4efe6] font-mono-tag text-xs font-semibold uppercase tracking-wider transition-colors shadow-sm flex items-center gap-2"
            >
              <span>Buka Tab Baru</span>
              <span>↗</span>
            </a>
          </div>
        </div>

        <!-- Menu Chapter Index Tabs (Protruding Tabs / Pembatas Buku Menu) -->
        <div class="mb-6 sm:mb-8">
          <div class="flex items-center justify-between pb-2 mb-3 text-[11px] font-mono-tag text-[#141110]/60 uppercase tracking-widest">
            <span>[ PEMBATAS BAB BUKU MENU ]</span>
            <span class="hidden sm:inline">KLIK BAB UNTUK MEMBUKA HALAMAN</span>
          </div>
          <div class="flex items-center gap-1.5 sm:gap-2 overflow-x-auto pb-2 no-scrollbar">
            {menuChapters.map((ch) => (
              <button 
                type="button"
                data-jump-page={ch.page}
                class="chapter-jump-btn shrink-0 px-3 py-1.5 bg-white border border-[#141110]/15 hover:border-[#141110] hover:bg-[#141110] hover:text-white transition-all text-xs font-mono-tag tracking-wider text-[#141110]/80 cursor-pointer flex items-center gap-1.5 shadow-sm"
              >
                <span class="font-bold text-[10px] text-[#8c6d37]">{String(ch.page).padStart(2, '0')}.</span>
                <span>{ch.title}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- ======================================================================= -->
        <!-- REALISTIC HEYZINE 3D FLIPBOOK BINDER (HARDCOVER MAT & BRASS CORNERS)    -->
        <!-- ======================================================================= -->
        <div class="relative w-full bg-[#141110] p-3 sm:p-6 lg:p-8 border border-[#141110]/20 shadow-[0_30px_90px_rgba(0,0,0,0.5)] flex flex-col">
          
          <!-- Top Control Toolbar Inside Book Frame -->
          <div class="w-full pb-4 sm:pb-5 mb-4 sm:mb-5 border-b border-white/15 flex flex-wrap items-center justify-between gap-4 text-white select-none">
            
            <!-- Left: Current Title Info -->
            <div class="flex items-center gap-3">
              <span class="text-xs sm:text-sm font-mono-tag tracking-wider uppercase text-[#d8c39e] font-semibold">
                JOLOTUNDO CAFE MENU
              </span>
            </div>

            <!-- Right: Action Buttons -->
            <div class="flex items-center gap-2 sm:gap-3 text-xs font-mono-tag">
              <button 
                id="heyzine-fullscreen-btn" 
                type="button"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white/10 hover:bg-[#d8c39e] hover:text-[#141110] text-white border border-white/20 transition-colors cursor-pointer"
                title="Buka Mode Layar Penuh"
              >
                <span>⛶ Layar Penuh</span>
              </button>

              <a 
                href="https://heyzine.com/flip-book/642f8c2f3f.html" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white/10 hover:bg-white/20 text-[#d8c39e] hover:text-white transition-colors border border-white/20"
                title="Buka Flipbook di Tab Baru"
              >
                <span>Tab Baru</span>
                <span>↗</span>
              </a>

              <a 
                href="/docs/menu-jolotundo-cafe.pdf" 
                download
                class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#d8c39e] hover:bg-white text-[#141110] font-bold transition-colors shadow-sm"
                title="Unduh File PDF Asli"
              >
                <span>Unduh PDF ↓</span>
              </a>
            </div>

          </div>

          <!-- Physical Menu Book Hardcover Leatherette Mat & Heyzine Frame -->
          <div 
            id="book-viewport-container" 
            class="relative w-full p-2 sm:p-4 lg:p-6 bg-[#26201c] border-2 border-[#3d342e] shadow-[0_25px_80px_rgba(0,0,0,0.85)] flex flex-col items-center justify-center overflow-hidden"
          >
            <!-- Subtle Brass Corner Hardware (4 Corners) -->
            <div class="absolute top-1.5 left-1.5 w-4 h-4 border-t-2 border-l-2 border-[#d8c39e]/60 pointer-events-none z-20"></div>
            <div class="absolute top-1.5 right-1.5 w-4 h-4 border-t-2 border-r-2 border-[#d8c39e]/60 pointer-events-none z-20"></div>
            <div class="absolute bottom-1.5 left-1.5 w-4 h-4 border-b-2 border-l-2 border-[#d8c39e]/60 pointer-events-none z-20"></div>
            <div class="absolute bottom-1.5 right-1.5 w-4 h-4 border-b-2 border-r-2 border-[#d8c39e]/60 pointer-events-none z-20"></div>

            <!-- Frame Wrapper with Mobile Scroll Guard (Prevents Iframe Scroll-Lock) -->
            <div class="relative w-full overflow-hidden">
              <!-- Heyzine 3D Interactive Flipbook Iframe -->
              <iframe 
                id="heyzine-menu-frame"
                src="https://heyzine.com/flip-book/642f8c2f3f.html" 
                class="w-full h-[520px] sm:h-[680px] lg:h-[780px] border-0 rounded-none bg-[#141110] shadow-[0_20px_50px_rgba(0,0,0,0.6)] overflow-hidden"
                allowfullscreen="true"
                allow="clipboard-write; fullscreen; autoplay; web-share"
                title="Buku Menu Jolotundo Cafe Heyzine Flipbook"
              ></iframe>

              <!-- Mobile Scroll Guard Overlay: Menjamin jempol HP bisa scroll halaman tanpa tersangkut di iframe -->
              <div 
                id="mobile-scroll-guard"
                class="absolute inset-0 sm:hidden z-10 flex flex-col items-center justify-start p-3 pointer-events-auto"
              >
                
              </div>
            </div>

            <!-- Dedicated Mobile Touch Control Bar (Prominent Prev/Next & Page Counter for Smartphones) -->
            <div class="w-full mt-3 pt-3 border-t border-white/10 flex items-center justify-between gap-2 text-white select-none sm:hidden">
              <button 
                id="mobile-prev-page-btn" 
                type="button" 
                class="flex-1 py-3 px-3 bg-white/10 active:bg-[#d8c39e] active:text-[#141110] text-white border border-white/20 text-xs font-mono-tag font-bold flex items-center justify-center gap-1.5 transition-colors touch-manipulation cursor-pointer"
                title="Halaman Sebelumnya" 
              >
                <span>← prev</span>
              </button>
              
              <div class="px-3 py-2.5 bg-black/50 border border-white/15 text-white font-mono-tag text-xs font-bold shrink-0 text-center">
                <span id="mobile-page-indicator" class="text-[#d8c39e]">Hal 01</span> / 10
              </div>

              <button 
                id="mobile-next-page-btn" 
                type="button" 
                class="flex-1 py-3 px-3 bg-[#d8c39e] active:bg-white text-[#141110] text-xs font-mono-tag font-bold flex items-center justify-center gap-1.5 transition-colors touch-manipulation shadow-sm cursor-pointer"
                title="Halaman Berikutnya"
              >
                <span>next →</span>
              </button>
            </div>

          </div>

          <!-- Bottom Book Footer Bar -->
          <div class="w-full pt-4 sm:pt-6 mt-4 sm:mt-6 border-t border-white/15 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs font-mono-tag text-white/60">
            <div class="flex items-center gap-2">
              <span class="text-[#d8c39e] font-bold">💡 Tips Navigasi:</span>
              <span class="hidden sm:inline">Tarik sudut kertas dengan sentuhan mouse/jari untuk membalik halaman layaknya buku asli.</span>
              <span class="sm:hidden">Gunakan tombol 'Layar Penuh' atau tombol panah bawah untuk membaca dengan leluasa.</span>
            </div>

            <div class="flex items-center gap-4">
              <a 
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-mono-tag font-bold text-[#d8c39e] hover:text-white transition-colors uppercase flex items-center gap-1.5"
              >
                <span>Order Menu / Info via WhatsApp</span>
                <span>↗</span>
              </a>
            </div>
          </div>

        </div>

      </div>
    </section>


    <!-- ========================================================================= -->
    <!-- FULLSCREEN MENU READER MODAL (DEDICATED EXIT BUTTONS FOR MOBILE & DESKTOP) -->
    <!-- ========================================================================= -->
    <div 
      id="menu-fullscreen-modal" 
      class="fixed inset-0 z-[99999] bg-[#141110] hidden flex-col select-none"
      role="dialog"
      aria-modal="true"
      aria-label="Buku Menu Jolotundo Cafe Layar Penuh"
    >
      <!-- Top Navigation & Close Bar -->
      <div class="w-full px-3 sm:px-6 py-2.5 sm:py-3.5 bg-[#1c1815] border-b border-white/15 flex items-center justify-between gap-3 text-white z-50 shrink-0">
        <!-- Left: Badge & Chapter Title -->
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
          <div class="flex flex-col min-w-0">
            <span class="text-[10px] sm:text-xs font-mono-tag text-[#d8c39e] tracking-widest uppercase truncate font-bold">
              JOLOTUNDO CAFE // 3D FLIPBOOK MENU
            </span>
            <span id="modal-chapter-title" class="text-xs sm:text-sm text-white/90 font-sans truncate font-medium">
              Cover Menu
            </span>
          </div>
        </div>

        <!-- Center/Right: Page Indicator & BIG CLOSE BUTTON -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <!-- Page Pill -->
          <div class="px-2.5 py-1 sm:px-3 sm:py-1.5 bg-black/60 border border-white/20 text-[#d8c39e] font-mono-tag text-xs font-bold shrink-0">
