  <FooterCTA />

  <!-- Hero Parallax Script -->
  <script is:inline>
    const heroParallaxLayer = document.getElementById('river-hero-parallax-layer');
    if (heroParallaxLayer) {
      window.addEventListener('scroll', () => {
        const scrolled = window.scrollY;
        if (scrolled < window.innerHeight * 1.5) {
          heroParallaxLayer.style.transform = `translate3d(0, ${scrolled * 0.35}px, 0)`;
        }
      }, { passive: true });
    }
  </script>
