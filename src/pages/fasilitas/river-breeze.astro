  <!-- Scripts: Hero Parallax, Text Reveal, Sticky Horizontal Gallery, and Heyzine 3D Flipbook Integration -->
  <script is:inline>
    // 1. Hero Parallax Translate-Y Engine
    const heroParallaxLayer = document.getElementById('river-hero-parallax-layer');
    if (heroParallaxLayer) {
      window.addEventListener('scroll', () => {
        const scrolled = window.scrollY;
        if (scrolled < window.innerHeight * 1.5) {
          heroParallaxLayer.style.transform = `translate3d(0, ${scrolled * 0.35}px, 0)`;
        }
      }, { passive: true });
    }

    // 2. 1:1 GoUncharted Scroll-Driven Word-by-Word Text Reveal Engine
    function initScrollTextReveal() {
      const heading = document.getElementById('place-reveal-heading');
      if (!heading) return;

      const words = heading.querySelectorAll('.reveal-word');
      if (!words || words.length === 0) return;

      const totalWords = words.length;
      let isTicking = false;
      let isVisible = false;

      const updateWords = () => {
        const rect = heading.getBoundingClientRect();
        const viewportHeight = window.innerHeight;

        const startTrigger = viewportHeight * 0.85;
        const endTrigger = viewportHeight * 0.35;

        const rawProgress = (startTrigger - rect.top) / (startTrigger - endTrigger);
        const overallProgress = Math.max(0, Math.min(1, rawProgress));

        words.forEach((word, idx) => {
          const wordStart = idx / totalWords;
          const wordEnd = (idx + 1) / totalWords;
          const wordProgress = Math.max(0, Math.min(1, (overallProgress - wordStart) / (wordEnd - wordStart)));
          const opacity = 0.18 + wordProgress * 0.82;
          word.style.opacity = opacity.toFixed(2);
        });
        isTicking = false;
      };

      const onScroll = () => {
        if (!isTicking && isVisible) {
          requestAnimationFrame(updateWords);
          isTicking = true;
        }
      };

      const obs = new IntersectionObserver((entries) => {
        isVisible = entries[0].isIntersecting;
        if (isVisible) updateWords();
      }, { rootMargin: '120px 0px' });
      obs.observe(heading);

      window.addEventListener('scroll', onScroll, { passive: true });
      updateWords();
    }

    // 3. Sticky Horizontal Scroll Preview Gallery Engine
    function initRiverPreviewGallery() {
      const section = document.getElementById('river-preview-gallery');
      const track = document.getElementById('river-slider-track');
      const progressBar = document.getElementById('river-progress-bar');
      const sliderWindow = document.getElementById('river-slider-window');
      if (!section || !track || !progressBar || !sliderWindow) return;

      let isTicking = false;

      function onScrollGallery() {
        const rect = section.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        const totalDistance = section.offsetHeight - windowHeight;

        if (totalDistance <= 0) return;

        const scrolled = -rect.top;
        const progress = Math.max(0, Math.min(1, scrolled / totalDistance));

        const trackWidth = track.scrollWidth;
        const windowWidth = sliderWindow.offsetWidth;
        const maxScrollX = Math.max(0, trackWidth - windowWidth + 48);

        const translateX = progress * maxScrollX;
        track.style.transform = `translate3d(-${translateX.toFixed(1)}px, 0, 0)`;

        const barWidth = 15 + progress * 85;
        progressBar.style.width = `${barWidth.toFixed(1)}%`;
      }

      function handleScroll() {
        if (!isTicking) {
          requestAnimationFrame(() => {
            onScrollGallery();
            isTicking = false;
          });
          isTicking = true;
        }
      }

      window.addEventListener('scroll', handleScroll, { passive: true });
      if (window.__lenis) {
        window.__lenis.on('scroll', handleScroll);
      }

      let resizeTimer = null;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          onScrollGallery();
        }, 100);
      }, { passive: true });

      onScrollGallery();
    }

    // 4. Heyzine 3D Interactive Flipbook Engine, Chapter Jumps & Mobile Touch Controls
    function initHeyzineMenuBook() {
      const heyzineFrame = document.getElementById('heyzine-menu-frame');
      const fullscreenBtn = document.getElementById('heyzine-fullscreen-btn');
      const chapterJumpBtns = document.querySelectorAll('.chapter-jump-btn');
      const mobilePrevBtn = document.getElementById('mobile-prev-page-btn');
      const mobileNextBtn = document.getElementById('mobile-next-page-btn');
      const mobilePageIndicator = document.getElementById('mobile-page-indicator');

      let currentBookPage = 1;
      const totalBookPages = 15;

      function updateActivePage(pageNum) {
        currentBookPage = Math.max(1, Math.min(totalBookPages, pageNum));
        if (heyzineFrame) {
          heyzineFrame.src = `https://heyzine.com/flip-book/c71bd63935.html#page/${currentBookPage}`;
        }
        if (mobilePageIndicator) {
          mobilePageIndicator.textContent = `Hal ${String(currentBookPage).padStart(2, '0')}`;
        }

        chapterJumpBtns.forEach((b) => {
          const p = parseInt(b.getAttribute('data-jump-page') || '1', 10);
          if (p === currentBookPage) {
            b.classList.add('bg-[#141110]', 'text-white', 'border-[#141110]');
            b.classList.remove('bg-white', 'text-[#141110]/80');
          } else {
            b.classList.remove('bg-[#141110]', 'text-white', 'border-[#141110]');
            b.classList.add('bg-white', 'text-[#141110]/80');
          }
        });
      }

      // Mobile Prev / Next Buttons
      mobilePrevBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        updateActivePage(currentBookPage - 1);
      });

      mobileNextBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        updateActivePage(currentBookPage + 1);
      });

      // Chapter Jump Buttons with Heyzine #page/{num} Navigation
      chapterJumpBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const pageNum = parseInt(btn.getAttribute('data-jump-page') || '1', 10);
          updateActivePage(pageNum);
          document.getElementById('daftar-menu')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      // Fullscreen Modal Elements
      const fullscreenModal = document.getElementById('menu-fullscreen-modal');
      const modalHeyzineFrame = document.getElementById('modal-heyzine-frame');
      const modalCloseBtn = document.getElementById('modal-close-btn');
      const modalFloatingExitBtn = document.getElementById('modal-floating-exit-btn');
      const modalPrevBtn = document.getElementById('modal-prev-btn');
      const modalNextBtn = document.getElementById('modal-next-btn');
      const modalPageNum = document.getElementById('modal-page-num');
      const modalChapterTitle = document.getElementById('modal-chapter-title');

      const chapterTitles = [
        "Cover Menu",
        "Panduan Pemesanan",
        "Ayam & Bebek",
        "Nasi Goreng & Mie",
        "Seafood & Gurami",
        "Soup & Meatball",
        "Western Steak",
        "Snack & Gorengan",
        "Chinese Snack & Dimsum",
        "Bapao & Onde-Onde",
        "Dessert & Cheesecake",
        "Kids Drink & Salad",
        "Minuman Nusantara",
        "Aneka Jus & Teh",
        "Specialty Coffee"
      ];

      function updateModalState(pageNum) {
        if (modalPageNum) {
          modalPageNum.textContent = `Hal ${String(pageNum).padStart(2, '0')}`;
        }
        if (modalChapterTitle) {
          modalChapterTitle.textContent = chapterTitles[pageNum - 1] || "Buku Menu";
        }
      }

      function openFullscreenModal() {
        if (!fullscreenModal || !modalHeyzineFrame) return;

        // Sync modal frame src with current page
        modalHeyzineFrame.src = `https://heyzine.com/flip-book/c71bd63935.html#page/${currentBookPage}`;
        updateModalState(currentBookPage);

        // Display modal
        fullscreenModal.classList.remove('hidden');
        fullscreenModal.classList.add('flex');

        // Lock background body scroll
        document.body.style.overflow = 'hidden';
        if (window.__lenis) window.__lenis.stop();

        // Optional: request native fullscreen on the modal container itself
        try {
          if (fullscreenModal.requestFullscreen) {
            fullscreenModal.requestFullscreen().catch(() => {});
          } else if (fullscreenModal.webkitRequestFullscreen) {
            fullscreenModal.webkitRequestFullscreen();
          }
        } catch (e) {}
      }

      function closeFullscreenModal() {
        if (!fullscreenModal) return;

        // Exit native fullscreen if active
        try {
          if (document.fullscreenElement || document.webkitFullscreenElement) {
            if (document.exitFullscreen) document.exitFullscreen().catch(() => {});
            else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
          }
        } catch (e) {}

        // Hide modal
        fullscreenModal.classList.remove('flex');
        fullscreenModal.classList.add('hidden');

        // Clear modal iframe
        if (modalHeyzineFrame) {
          modalHeyzineFrame.src = '';
        }

        // Restore body scroll and Lenis
        document.body.style.overflow = '';
        if (window.__lenis) window.__lenis.start();

        // Sync back to inline book
        updateActivePage(currentBookPage);
      }

      // Close modal triggers
      modalCloseBtn?.addEventListener('click', closeFullscreenModal);
      modalFloatingExitBtn?.addEventListener('click', closeFullscreenModal);

      // Modal Prev/Next Navigation
      modalPrevBtn?.addEventListener('click', () => {
        if (currentBookPage > 1) {
          currentBookPage--;
          if (modalHeyzineFrame) {
            modalHeyzineFrame.src = `https://heyzine.com/flip-book/c71bd63935.html#page/${currentBookPage}`;
          }
          updateModalState(currentBookPage);
        }
      });

      modalNextBtn?.addEventListener('click', () => {
        if (currentBookPage < totalBookPages) {
          currentBookPage++;
          if (modalHeyzineFrame) {
            modalHeyzineFrame.src = `https://heyzine.com/flip-book/c71bd63935.html#page/${currentBookPage}`;
          }
          updateModalState(currentBookPage);
        }
      });

      // Escape key listener
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && fullscreenModal && !fullscreenModal.classList.contains('hidden')) {
          closeFullscreenModal();
        }
      });

      // System back / fullscreen change listener
      document.addEventListener('fullscreenchange', () => {
        if (!document.fullscreenElement && fullscreenModal && !fullscreenModal.classList.contains('hidden')) {
          closeFullscreenModal();
        }
      });
      document.addEventListener('webkitfullscreenchange', () => {
        if (!document.webkitFullscreenElement && fullscreenModal && !fullscreenModal.classList.contains('hidden')) {
          closeFullscreenModal();
        }
      });

      // Mobile Scroll Guard & Touch Mode Toggle
      const mobileGuard = document.getElementById('mobile-scroll-guard');
      const mobileToggleTouchBtn = document.getElementById('mobile-toggle-touch-btn');
      const mobileTouchLabel = document.getElementById('mobile-touch-label');
      const mobileOverlayFsBtn = document.getElementById('mobile-overlay-fs-trigger');

      let isDirectTouch = false;

      mobileToggleTouchBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        isDirectTouch = !isDirectTouch;
        if (isDirectTouch) {
          mobileGuard?.classList.remove('pointer-events-auto');
          mobileGuard?.classList.add('pointer-events-none');
          if (mobileTouchLabel) mobileTouchLabel.textContent = '🔒 Kunci Gulir';
          if (mobileToggleTouchBtn) {
            mobileToggleTouchBtn.classList.add('pointer-events-auto', 'bg-[#d8c39e]', 'text-[#141110]');
            mobileToggleTouchBtn.classList.remove('bg-black/80', 'text-white/90');
          }
        } else {
          mobileGuard?.classList.remove('pointer-events-none');
          mobileGuard?.classList.add('pointer-events-auto');
          if (mobileTouchLabel) mobileTouchLabel.textContent = '👆 Buka Sentuh Buku';
          if (mobileToggleTouchBtn) {
            mobileToggleTouchBtn.classList.remove('bg-[#d8c39e]', 'text-[#141110]');
            mobileToggleTouchBtn.classList.add('bg-black/80', 'text-white/90');
          }
        }
      });

      mobileOverlayFsBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        openFullscreenModal();
      });

      // Desktop & Mobile Fullscreen Triggers (Opens our Reader Modal)
      fullscreenBtn?.addEventListener('click', openFullscreenModal);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initScrollTextReveal();
        initRiverPreviewGallery();
        initHeyzineMenuBook();
      });
    } else {
      initScrollTextReveal();
      initRiverPreviewGallery();
      initHeyzineMenuBook();
    }
  </script>
</Layout>
