---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import FooterCTA from '../components/FooterCTA.astro';
import JourneyUpgradeStack from '../components/JourneyUpgradeStack.astro';
import GrillStickyScroll from '../components/GrillStickyScroll.astro';
import RentalGearSection from '../components/RentalGearSection.astro';
import siteData from '../data/siteData.json';

// Data Lengkap 7 Akomodasi Jolotundo (Varied Dynamic Editorial Grid Architecture)
const accommodations = [
  {
    index: "01",
    id: "deluxe-camp",
    name: "Deluxe Camp",
    category: "cabin",
    tier: "Premium Hospitality",
    setting: "Riverside & Pine Canopy",
    capacity: "2 Orang",
    tagline: "Kabin kayu jati berpendingin udara di tepi sungai berbatu, memadukan kenyamanan hotel dengan alunan gemericik air alami.",
    pills: ["Tepi Sungai", "±800 MDPL", "Kabin AC", "Maks 2 Tamu"],
    image: "/images/accommodations/deluxecamp/deluxe1.avif",
    editorialImage: "/images/accommodations/deluxecamp/deluxe1.avif",
    gridClass: "grid-col-7 camp-card-hero"
  },
  {
    index: "02",
    id: "superior-camp",
    name: "Superior Camp",
    category: "cabin",
    tier: "Premium Hospitality",
    setting: "Terraced Pine Hill",
    capacity: "2 Orang",
    tagline: "Kabin berpendingin udara modern dengan fasilitas lengkap, Smart TV, tea maker kit, dan water heater untuk kenyamanan prima.",
    pills: ["Terraced Hill", "Kabin AC", "Smart TV", "Maks 2 Tamu"],
    image: "/images/accommodations/superior/superior.avif",
    editorialImage: "/images/accommodations/superior/superior.avif",
    gridClass: "grid-col-5 camp-card-hero"
  },
  {
    index: "03",
    id: "korean-glamping",
    name: "Korean Glamping",
    category: "forest",
    tier: "Experiential Glamping",
    setting: "Pine Lawn Garden",
    capacity: "3 s/d 6 Orang",
    tagline: "Glamping bergaya Korea yang memadukan keindahan alam dengan suasana hangat, kompor set lengkap, dan pesta BBQ di bawah kabut pinus.",
    pills: ["Taman Pinus", "BBQ Picnic", "Aesthetic Tent", "3–6 Tamu"],
    image: "/images/accommodations/koreanglamping/korean1.avif",
    editorialImage: "/images/accommodations/koreanglamping/korean1.avif",
    gridClass: "grid-col-5 camp-card-hero"
  },
  {
    index: "04",
    id: "river-camp",
    name: "River Camp",
    category: "river",
    tier: "Experiential Glamping",
    setting: "Direct Riverside Deck",
    capacity: "2 Orang",
    tagline: "Terapi alam terbaik dengan alunan simfoni gemericik air sungai alami tepat di depan teras panggung kayu Anda sepanjang malam.",
    pills: ["Dek Sungai", "Gemericik Air", "Double Bed", "Maks 2 Tamu"],
    image: "/images/accommodations/rivercamp/river1.avif",
    editorialImage: "/images/accommodations/rivercamp/river1.avif",
    gridClass: "grid-col-7 camp-card-hero"
  },
  {
    index: "05",
    id: "pinus-camp-plus",
    name: "Pinus Camp Plus",
    category: "river",
    tier: "Experiential Glamping",
    setting: "Pine & Small Creek",
    capacity: "2 Orang",
    tagline: "Tenda panggung kayu di tengah sejuknya ribuan pohon pinus dengan aliran sungai kecil persis di depan tenda (Tenda 40–51).",
    pills: ["Hutan Pinus", "Sungai Kecil", "Dek Panggung", "Maks 2 Tamu"],
    image: "/images/accommodations/pinuscamp/pinus1.avif",
    editorialImage: "/images/accommodations/pinuscamp/pinus1.avif",
    gridClass: "grid-col-half"
  },
  {
    index: "06",
    id: "pinus-camp",
    name: "Pinus Camp",
    category: "forest",
    tier: "Rustic & Nature",
    setting: "Deep Pine Canopy",
    capacity: "2 Orang",
    tagline: "Keteduhan autentik hutan pinus yang menjulang tinggi, menghadirkan privasi istirahat yang sangat tenang, sejuk, dan asri.",
    pills: ["Kanopi Pinus", "Dek Kayu", "Udara Sejuk", "Maks 2 Tamu"],
    image: "/images/accommodations/pinuscamp/pinus2.avif",
    editorialImage: "/images/accommodations/pinuscamp/pinus2.avif",
    gridClass: "grid-col-half"
  },
  {
    index: "07",
    id: "camping-ground",
    name: "Camping Ground",
    category: "ground",
    tier: "Rustic & Nature",
    setting: "Wilderness Pinus Ground",
    capacity: "4 s/d 6 Orang",
    tagline: "Area berkemah luas di bawah langit bertabur bintang untuk petualang sejati yang mendambakan esensi berkemah murni di alam bebas.",
    pills: ["Tenda Dome", "Matras Tidur", "Api Unggun", "4–6 Tamu"],
    image: "/images/accommodations/ground/ground.avif",
