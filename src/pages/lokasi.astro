---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Masterplan2DMap from '../components/Masterplan2DMap.astro';
import FooterCTA from '../components/FooterCTA.astro';

const routeStackItems = [
  {
    index: "01",
    spec: "KORIDOR TOL TRANS-JAWA",
    tag: "±45 MENIT // 26 KM",
    title: "Dari Gerbang Tol Nganjuk menuju Desa Bajulan.",
    desc: "Keluar di Exit Tol Nganjuk menuju arah pusat Kota Nganjuk / Alun-Alun, kemudian arahkan kendaraan ke Selatan menuju Kecamatan Loceret hingga memasuki kawasan wisata Desa Bajulan (searah Air Terjun Roro Kuning). Seluruh jalur beraspal mulus dan nyaman dilalui mobil pribadi, SUV, maupun rombongan HiAce/Elf.",
    pills: ["EXIT TOL NGANJUK", "KECAMATAN LOCERET", "DESA BAJULAN", "ASPAL MULUS"]
  },
  {
    index: "02",
    spec: "KORIDOR SELATAN & BANDARA",
    tag: "±50 MENIT // 28 KM",
    title: "Dari Kediri & Bandara Internasional Dhoho.",
    desc: "Bagi tamu yang berangkat dari arah Kediri atau mendarat di Bandara Dhoho Kediri, ambil jalur Banyakan – Pace – Loceret menyusuri kaki Gunung Wilis menuju Desa Bajulan. Setibanya di simpang wisata Bajulan, ikuti rambu penunjuk resmi menuju Pintu Masuk Timur Jolotundo Glamping & Edupark.",
    pills: ["BANDARA DHOHO KEDIRI", "JALUR PACE – LOCERET", "LERENG GUNUNG WILIS"]
  },
  {
    index: "03",
    spec: "ALUR KEDATANGAN & CHECK-IN",
    tag: "GERBANG TIMUR // RESEPSIONIS",
    title: "Pintu Masuk Utama, Parkir & Lobby Resepsionis.",
    desc: "Seluruh kendaraan masuk melalui Pintu Masuk di sisi Timur denah. Kendaraan roda dua langsung berbelok ke kanan menuju Parkir Motor (Utara), sedangkan mobil pribadi dan rombongan berbelok ke kiri menuju Parkir Mobil (Selatan). Setelah parkir, tamu langsung melakukan registrasi di gedung Resepsionis yang bersebelahan dengan Aula dan Mushola.",
    pills: ["PINTU MASUK TIMUR", "PARKIR MOTOR & MOBIL", "LOBBY RESEPSIONIS", "MUSHOLA & AULA"]
  },
  {
    index: "04",
    spec: "DISTRIBUSI ZONA DALAM KAWASAN",
    tag: "SEKTOR TIMUR & BARAT",
    title: "Orientasi Menuju Glamping, Resto & Tenda 01–100.",
    desc: "Dari Resepsionis, tamu Korean Glamping (Tenda 1–13), Indian Camp, Camping Ground, serta wahana Stable Kuda & Outbound cukup berjalan ke arah Utara di Sektor Timur. Tamu River Breeze, Indoor Cafe, dan 10 Riverside Cabin berjalan ke arah Selatan. Sedangkan tamu kavling Tenda 01–100 cukup menyeberangi Jembatan Utama pada poros Jalur Evakuasi menuju Sektor Barat.",
    pills: ["JEMBATAN UTAMA", "SEKTOR TIMUR (GLAMPING & RESTO)", "SEKTOR BARAT (TENDA 01–100)"]
  }
];
---

<Layout title="Lokasi, Rute & Denah Kawasan 2D | Jolotundo Glamping & Edupark">
  <Navbar />

  <main class="min-h-screen bg-[#f4efe6] text-[#141110] selection:bg-[#141110] selection:text-[#f4efe6]">
    
    <!-- ========================================================================= -->
    <!-- 1. CLEAN EDITORIAL HEADER (DI BAWAH NAVBAR — TANPA BACKGROUND GAMBAR)     -->
    <!-- ========================================================================= -->
    <header class="lokasi-hero-header w-full border-b border-[#141110]/15">
      <div class="max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-14 xl:px-20">
        
        <!-- Top Kicker & Coordinate Breadcrumb -->
        <div class="flex flex-wrap items-center justify-between gap-4 pb-5 mb-8 border-b border-[#141110]/15">
          <div class="flex items-center gap-3">
            <span class="inline-block w-5 h-[1.5px] bg-[#141110]"></span>
            <span class="text-xs font-mono-tag uppercase tracking-[0.25em] text-[#141110]/65">
              LOKASI &amp; ORIENTASI KAWASAN // BAJULAN, NGANJUK
            </span>
          </div>
          <div class="flex items-center gap-4 text-xs font-mono-tag uppercase tracking-[0.2em] text-[#141110]/55">
            <span>7°44'18.2"S 111°49'32.4"E</span>
            <span class="text-[#141110]/25">/</span>
            <span>LERENG GUNUNG WILIS ±800 MDPL</span>
          </div>
        </div>

        <!-- Main Editorial Typographic Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-end">
          <div class="lg:col-span-7">
            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-normal tracking-tight text-[#141110] leading-[1.02] font-sans">
              Denah Lokasi &amp;<br />
              Peta Masterplan 2D.
            </h1>
          </div>

          <div class="lg:col-span-5 flex flex-col justify-end lg:pb-1">
            <p class="text-sm sm:text-base text-[#141110]/75 leading-relaxed font-sans">
              Bentang alam Jolotundo Glamping &amp; Edupark terbelah secara alami oleh aliran <strong class="font-semibold text-[#141110]">Sungai Bajulan</strong> dari Barat Laut ke Tenggara—menghubungkan <strong class="font-semibold text-[#141110]">Sisi Barat</strong> (100 kavling tenda bernomor 01–100 &amp; Area Komunal) dengan <strong class="font-semibold text-[#141110]">Sisi Timur</strong> (Korean Glamping, Indian Camp, Camping Ground 1–100, Stable Kuda, Area Outbound, Aula, Pelataran, River Breeze, hingga 10 kabin kayu tepi sungai) melalui poros utama <strong class="font-semibold text-[#141110]">Jembatan &amp; Jalur Evakuasi</strong>.
            </p>
          </div>
        </div>

        <!-- Masterplan Spatial Index Strip -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 border border-[#141110]/20 divide-y sm:divide-y-0 sm:divide-x divide-[#141110]/15 mt-10 bg-transparent">
          <div class="p-4 sm:p-5">
            <span class="block text-[10px] font-mono-tag uppercase tracking-widest text-[#141110]/50 mb-1">SISI BARAT SUNGAI</span>
            <span class="block text-lg sm:text-xl font-bold tracking-tight text-[#141110]">Tenda 01 – 100</span>
            <span class="block text-[11px] font-mono-tag text-[#141110]/60 mt-0.5">8 Klaster + 3 Kamar Mandi</span>
          </div>
          <div class="p-4 sm:p-5">
            <span class="block text-[10px] font-mono-tag uppercase tracking-widest text-[#141110]/50 mb-1">KOREAN GLAMPING</span>
            <span class="block text-lg sm:text-xl font-bold tracking-tight text-[#141110]">Tenda 1 – 13</span>
            <span class="block text-[11px] font-mono-tag text-[#141110]/60 mt-0.5">2 Blok Tepi Sungai Timur</span>
          </div>
          <div class="p-4 sm:p-5">
            <span class="block text-[10px] font-mono-tag uppercase tracking-widest text-[#141110]/50 mb-1">SEKTOR UTARA TIMUR</span>
            <span class="block text-lg sm:text-xl font-bold tracking-tight text-[#141110]">Indian &amp; Ground</span>
            <span class="block text-[11px] font-mono-tag text-[#141110]/60 mt-0.5">Indian Camp + Grid 1–100</span>
          </div>
          <div class="p-4 sm:p-5">
            <span class="block text-[10px] font-mono-tag uppercase tracking-widest text-[#141110]/50 mb-1">TEPI SUNGAI TENGGARA</span>
            <span class="block text-lg sm:text-xl font-bold tracking-tight text-[#141110]">10 Unit Kabin</span>
            <span class="block text-[11px] font-mono-tag text-[#141110]/60 mt-0.5">Deret Chalet Kayu Selatan</span>
          </div>
          <div class="p-4 sm:p-5">
            <span class="block text-[10px] font-mono-tag uppercase tracking-widest text-[#141110]/50 mb-1">EDUPARK &amp; EVENT</span>
            <span class="block text-lg sm:text-xl font-bold tracking-tight text-[#141110]">Stable &amp; Outbound</span>
            <span class="block text-[11px] font-mono-tag text-[#141110]/60 mt-0.5">Kuda, Lapangan, Pelataran, Aula</span>
          </div>
          <div class="p-4 sm:p-5">
            <span class="block text-[10px] font-mono-tag uppercase tracking-widest text-[#141110]/50 mb-1">LOUNGE &amp; KULINER</span>
            <span class="block text-lg sm:text-xl font-bold tracking-tight text-[#141110]">3 Titik F&amp;B</span>
            <span class="block text-[11px] font-mono-tag text-[#141110]/60 mt-0.5">River Breeze, Indoor &amp; Bar Cafe</span>
          </div>
        </div>

      </div>
    </header>

    <!-- ========================================================================= -->
    <!-- 2. 100% PURE INTERACTIVE 2D SVG MASTERPLAN                                -->
    <!-- ========================================================================= -->
    <Masterplan2DMap />

    <!-- ========================================================================= -->
    <!-- 3. STICKY DESCRIPTION STACK: PANDUAN RUTE & AKSES (1:1 EVENT DETAIL STYLE)-->
    <!-- ========================================================================= -->
    <section class="py-20 sm:py-28 px-6 sm:px-10 lg:px-14 xl:px-20 max-w-[1680px] mx-auto border-t border-[#141110]/15 relative">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start relative">
        
        <!-- Left Column: Sticky Editorial Header + Direct Navigation Actions -->
        <div class="lg:col-span-5 space-y-4 lg:sticky lg:top-28 self-start">
          
          <span class="text-xs font-mono-tag text-[#141110]/50 tracking-[0.26em] uppercase block">
            — PANDUAN RUTE &amp; ORIENTASI
          </span>

          <h2 class="text-3xl sm:text-5xl lg:text-[52px] font-light tracking-tight text-[#141110] font-sans leading-[1.08]">
            Akses Langsung ke Gerbang Timur Kawasan.
          </h2>

          <span class="text-xs font-mono-tag tracking-widest text-[#141110]/50 uppercase block pt-1">
            EMPAT TAHAP MENUJU &amp; MENJELAJAHI JOLOTUNDO.
          </span>

          <p class="text-sm sm:text-base text-[#141110]/70 font-sans leading-relaxed max-w-md pt-2">
            Seluruh kendaraan tamu masuk melalui <strong class="font-semibold text-[#141110]">Pintu Masuk Timur</strong> yang terhubung langsung dengan kantong <strong class="font-semibold text-[#141110]">Parkir Motor</strong> (Utara) dan <strong class="font-semibold text-[#141110]">Parkir Mobil</strong> (Selatan), tepat di samping bangunan <strong class="font-semibold text-[#141110]">Resepsionis, Mushola, dan Aula</strong>.
          </p>

          <!-- Action Buttons (Black solid button + outline button) -->
          <div class="pt-4 flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center gap-3">
            <a
              href="https://maps.google.com/?q=Jolotundo+Glamping+Edupark+Bajulan+Nganjuk"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center justify-between gap-3 px-6 py-3.5 bg-[#141110] hover:bg-black text-[#f4efe6] font-mono-tag text-xs font-bold uppercase tracking-wider transition-all duration-200 border border-[#141110]"
            >
              <span>Buka Navigasi Google Maps</span>
              <span class="text-sm transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-0.5">↗</span>
            </a>
            <a
              href="https://wa.me/6282229500998?text=Halo%20Admin%20Jolotundo,%20mohon%20share%20pin%20lokasi%20dan%20panduan%20rute%20menuju%20Jolotundo%20Edupark."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-between gap-3 px-6 py-3.5 bg-transparent hover:bg-[#141110] text-[#141110] hover:text-[#f4efe6] border border-[#141110] font-mono-tag text-xs font-bold uppercase tracking-wider transition-all duration-200"
            >
              <span>Hubungi Concierge Rute</span>
              <span>↗</span>
            </a>
          </div>

          <div class="pt-4 hidden lg:flex items-center gap-2 text-xs font-mono-tag text-[#141110]/40 uppercase tracking-widest">
            <span class="inline-block w-1.5 h-1.5 bg-[#141110] animate-pulse"></span>
            <span>GULIR UNTUK MELIHAT STACK PANDUAN RUTE</span>
          </div>

        </div>

        <!-- Right Column: Sticky Stacking Description Cards Deck -->
        <div id="lokasi-stack-container" class="lg:col-span-7 relative flex flex-col pb-10">
          {routeStackItems.map((item, idx) => {
            const totalItems = routeStackItems.length;
            const isLast = idx === totalItems - 1;
            const spacingMb = '20vh';

            return (
              <div 
                id={`lokasi-stack-wrapper-${idx}`}
                class="lokasi-stack-wrapper w-full sticky will-change-transform"
                style={`top: calc(5.5rem + ${idx * 26}px); z-index: ${10 + idx}; margin-bottom: ${isLast ? '2rem' : spacingMb};`}
                data-index={idx}
              >
                <!-- Stacking Physical Card with Solid Warm Stone Background -->
                <article 
                  class="lokasi-stack-card relative w-full bg-[#f4efe6] border border-[#141110]/20 p-6 sm:p-9 lg:p-10 shadow-[0_-10px_35px_rgba(0,0,0,0.06)] transition-all duration-300 origin-top flex flex-col justify-between space-y-4 sm:space-y-5 select-none"
                >
                  <!-- Top Bar: Index & Tag Badge -->
                  <div class="flex items-center justify-between border-b border-[#141110]/10 pb-3">
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-mono-tag font-bold text-[#141110]/50 tracking-widest uppercase">
                        {item.index}
                      </span>
                      <span class="text-xs font-mono-tag text-[#141110]/30">•</span>
                      <span class="text-[10px] font-mono-tag tracking-wider text-[#141110]/60 uppercase">
                        {item.spec}
                      </span>
                    </div>

                    {item.tag && (
                      <span class="text-[10px] sm:text-[11px] font-mono-tag font-bold tracking-wider text-[#141110] uppercase bg-[#141110]/5 px-3 py-1 border border-[#141110]/15">
                        {item.tag}
                      </span>
                    )}
                  </div>

                  <!-- Editorial Heading & Description -->
                  <div class="space-y-2.5">
                    <h3 class="text-2xl sm:text-3xl font-medium tracking-tight text-[#141110] leading-snug font-sans">
                      {item.title}
                    </h3>
                    <p class="text-sm sm:text-base text-[#141110]/75 font-sans leading-relaxed">
                      {item.desc}
                    </p>
                  </div>

                  <!-- Feature Pills -->
                  {item.pills && (
                    <div class="pt-3 border-t border-[#141110]/10 flex flex-wrap items-center gap-2">
                      {item.pills.map((pill: string) => (
                        <span class="text-[11px] font-mono-tag text-[#141110]/70 bg-[#141110]/5 border border-[#141110]/15 px-3 py-1 uppercase tracking-wide">
                          {pill}
                        </span>
                      ))}
                    </div>
                  )}

                </article>
              </div>
            );
          })}
        </div>

      </div>

    </section>

  </main>

  <FooterCTA />
</Layout>

<style>
  /* Guaranteed Top Clearance below the Fixed Floating Pill Navbar */
  .lokasi-hero-header {
    padding-top: 6.75rem;
    padding-bottom: 2.75rem;
  }
  @media (min-width: 640px) {
    .lokasi-hero-header {
      padding-top: 8.75rem;
      padding-bottom: 3.5rem;
    }
  }
</style>

<script>
  function initLokasiStack() {
    const wrappers = document.querySelectorAll<HTMLElement>('.lokasi-stack-wrapper');
    if (wrappers.length === 0) return;

    function onScrollStack() {
      wrappers.forEach((wrapper, idx) => {
        if (idx === wrappers.length - 1) return;

        const nextWrapper = wrappers[idx + 1];
        if (!nextWrapper) return;

        const nextRect = nextWrapper.getBoundingClientRect();
        const wrapperRect = wrapper.getBoundingClientRect();
        const cardInner = wrapper.querySelector<HTMLElement>('.lokasi-stack-card');
        if (!cardInner) return;

        if (nextRect.top <= wrapperRect.bottom) {
          const overlap = wrapperRect.bottom - nextRect.top;
          const maxOverlap = wrapperRect.height;
          const progress = Math.max(0, Math.min(1, overlap / (maxOverlap * 0.75)));

          const scale = 1 - progress * 0.035;
          const brightness = 1 - progress * 0.12;

          cardInner.style.transform = `scale(${scale.toFixed(4)})`;
          cardInner.style.filter = `brightness(${brightness.toFixed(3)})`;
        } else {
          cardInner.style.transform = 'scale(1)';
          cardInner.style.filter = 'brightness(1)';
        }
      });
    }

    let isTicking = false;
    function handleScroll() {
      if (!isTicking) {
        requestAnimationFrame(() => {
          onScrollStack();
          isTicking = false;
        });
        isTicking = true;
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    onScrollStack();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLokasiStack);
  } else {
    initLokasiStack();
  }
</script>
