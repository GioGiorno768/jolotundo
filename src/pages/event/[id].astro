---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import FooterCTA from '../../components/FooterCTA.astro';
import EventPreviewGallery from '../../components/EventPreviewGallery.astro';
import eventDetails from '../../data/eventDetails.json';

export async function getStaticPaths() {
  return eventDetails.map((venue, idx) => {
    const prevVenue = idx > 0 ? eventDetails[idx - 1] : eventDetails[eventDetails.length - 1];
    const nextVenue = idx < eventDetails.length - 1 ? eventDetails[idx + 1] : eventDetails[0];
    return {
      params: { id: venue.id },
      props: { venue, prevVenue, nextVenue }
    };
  });
}

const { venue, prevVenue, nextVenue } = Astro.props;

// WhatsApp Booking URL
const waPhone = venue.contactWa || "6282249829998";
const waMessage = `Halo Admin Jolotundo Glamping & Culture, saya ingin konsultasi dan informasi ketersediaan untuk *${venue.name}*.`;
const waUrl = `https://wa.me/${waPhone}?text=${encodeURIComponent(waMessage)}`;

const ogImageMap: Record<string, string> = {
  "wedding": "/images/facilities/wedding-forest.jpg",
  "aula-hall": "/images/facilities/glass-hall-venue.jpg",
  "gathering-outbound": "/images/facilities/meeting-hall-pendopo.jpg"
};
const siteBase = (Astro.site ? Astro.site.toString() : 'https://jolotundo.vercel.app').replace(/\/$/, '');
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Beranda", "item": `${siteBase}/` },
    { "@type": "ListItem", "position": 2, "name": "Event & Gathering", "item": `${siteBase}/event` },
    { "@type": "ListItem", "position": 3, "name": venue.name, "item": `${siteBase}/event/${venue.id}` }
  ]
};
---

<Layout 
  title={`${venue.name} — Jolotundo Glamping & Culture`}
  description={`${venue.name} di Jolotundo Glamping & Culture, Bajulan, lereng Gunung Wilis. ${venue.tagline}. Mulai ${venue.priceStarting}.`}
  image={ogImageMap[venue.id] || "/images/facilities/event-hero.jpg"}
  schema={breadcrumbSchema}
>
  <!-- Floating Expanding Capsule Navbar -->
  <Navbar />

  <main class="min-h-screen bg-[#f4efe6] text-[#141110] selection:bg-[#141110] selection:text-white">

    <!-- ========================================================================= -->
    <!-- 1. FULLSCREEN EDITORIAL HERO (1:1 RIVER BREEZE STYLE)                     -->
    <!-- ========================================================================= -->
    <header 
      id="event-detail-hero" 
      class="relative h-screen h-[100dvh] min-h-[100dvh] w-full flex flex-col justify-between overflow-hidden bg-[#141110] text-[#f4efe6] select-none"
    >
      <!-- Parallax Translate-Y Background Layer -->
      <div 
        id="hero-parallax-layer" 
        class="absolute inset-x-0 w-full h-[125%] -top-[12.5%] will-change-transform pointer-events-none z-0"
        style="transform: translate3d(0, 0px, 0);"
      >
        <img 
          src={venue.heroImage} 
          alt={`${venue.name} - Jolotundo Glamping & Culture`}
          class="w-full h-full object-cover object-center scale-105"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
        <!-- Atmospheric Vignettes / Dual Scrim for Editorial Typography Contrast -->
        <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/40 to-black/90 pointer-events-none"></div>
        <div class="absolute inset-0 bg-black/20 pointer-events-none"></div>
      </div>

      <!-- Top Spacer to clear floating pill navbar -->
      <div class="h-20 sm:h-28 shrink-0"></div>

      <!-- Center Display Typography (Pure River Breeze Clean Luxury) -->
      <div class="relative z-10 flex flex-col items-center justify-center text-center px-5 max-w-4xl mx-auto my-auto w-full py-4 sm:py-8">
        
        <!-- Subtle Monospaced Eyebrow Kicker -->
        <span class="text-[10px] sm:text-xs font-mono-tag tracking-[0.2em] sm:tracking-[0.28em] text-[#d8c39e] uppercase mb-3 sm:mb-5 block">
          — {venue.category} · {venue.elevation}
        </span>

        <!-- Clean, Powerful & Elegant Title -->
        <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-normal tracking-[-0.03em] text-white leading-[1.02] sm:leading-[0.96] font-sans drop-shadow-lg">
          {venue.name}.
        </h1>

        <!-- Simple, Clean & Poetic Subtitle -->
        <p class="text-xs sm:text-base md:text-lg font-sans text-white/80 max-w-md sm:max-w-xl mx-auto mt-3 sm:mt-5 drop-shadow leading-relaxed font-light">
          {venue.tagline}
        </p>

        <!-- Clean Subtle Action Links -->
        <div class="flex items-center gap-3 sm:gap-6 mt-6 sm:mt-10 text-[11px] sm:text-xs font-mono-tag tracking-wider uppercase">
          <a 
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 sm:px-5 py-2.5 sm:py-3 bg-[#d8c39e] hover:bg-white text-[#141110] font-bold transition-colors shadow-md flex items-center gap-1.5"
          >
            <span>Konsultasi Venue</span>
            <span>↗</span>
          </a>
          <a 
            href="#venue-overview" 
            class="px-3 py-2 text-white/80 hover:text-white transition-colors border-b border-white/40 pb-0.5 flex items-center gap-1"
          >
            <span>Rincian & Fasilitas</span>
            <span>↓</span>
          </a>
        </div>
      </div>

      <!-- Bottom Metadata Bar: Clean Single Row on Mobile, Full on Desktop -->
      <div class="relative z-10 w-full px-5 sm:px-12 lg:px-16 pb-4 sm:pb-8 pt-3 border-t border-white/15 bg-gradient-to-t from-black/85 via-black/40 to-transparent shrink-0">
        <div class="max-w-[1680px] mx-auto flex items-center justify-between gap-2 text-[10px] sm:text-xs font-mono-tag tracking-wider sm:tracking-widest uppercase text-white/70">
          <div class="flex items-center gap-2 min-w-0">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
            <span class="text-white font-medium truncate">VENUE SEKTOR {venue.index}</span>
          </div>
          <div class="flex items-center gap-2 sm:gap-6 text-white/60 shrink-0">
            <span class="hidden sm:inline">{venue.setting}</span>
            <span class="hidden sm:inline">•</span>
            <span>BAJULAN · 800M</span>
            <span>•</span>
            <span class="text-[#d8c39e] font-bold">{venue.priceStarting}</span>
          </div>
        </div>
      </div>
    </header>

    <!-- ========================================================================= -->
    <!-- 2. THE OVERVIEW & SPECS (1:1 GOUNCHARTED TWO-COLUMN EDITORIAL SECTION)    -->
    <!-- ========================================================================= -->
    <section class="py-20 sm:py-28 px-6 sm:px-10 lg:px-14 xl:px-20 max-w-[1680px] mx-auto">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">
        
        <!-- Left Column: Kicker + Large Title + Narrative + Concierge Box (Sticky) -->
        <div class="lg:col-span-5 space-y-6 lg:sticky lg:top-28">
          
          <span class="text-xs font-mono-tag text-[#141110]/50 tracking-[0.26em] uppercase block">
            — {venue.kicker}
          </span>

          <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-normal tracking-tight text-[#141110] font-sans leading-[1.12]">
            {venue.headline}
          </h2>

          <p class="text-sm sm:text-base text-[#141110]/70 font-sans leading-relaxed">
            {venue.narrative}
          </p>

          <!-- Direct WhatsApp Concierge Card -->
          <div class="p-6 sm:p-7 border border-[#141110]/15 bg-[#eae4d8]/40 space-y-4 mt-8">
            <span class="text-[10px] font-mono-tag text-[#141110]/55 uppercase tracking-widest block">
              OFFICIAL CONCIERGE HOTLINE
            </span>
            <div class="text-xl sm:text-2xl font-bold font-mono-tag text-[#141110]">
              {venue.contactPhone}
            </div>
            <p class="text-xs text-[#141110]/65 font-sans leading-relaxed">
              {venue.contactType === "personal" 
                ? "Layanan reservasi wedding intimate, prewedding, arisan keluarga & kunjungan privat." 
                : "Layanan resmi instansi kedinasan, BUMN, komunitas, rapat kerja & rombongan besar."}
            </p>
            <a 
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between w-full px-5 py-3.5 bg-[#141110] hover:bg-black text-[#f4efe6] font-mono-tag text-xs font-bold uppercase tracking-wider transition-all duration-200 border border-[#141110]"
            >
              <span>Konsultasi & Reservasi WhatsApp</span>
              <span class="text-sm transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-0.5">↗</span>
            </a>
          </div>

        </div>

        <!-- Right Column: Hairline Structured Rows (GoUncharted Spec Table) -->
        <div class="lg:col-span-7">
          
          <div class="border-t border-[#141110] divide-y divide-[#141110]/15">
            {venue.specs.map((row) => (
              <div class="py-6 sm:py-7 grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-6 items-start group">
                
                <!-- Left Sub-col: Monospaced Label -->
                <div class="sm:col-span-4">
                  <span class="text-[11px] font-mono-tag tracking-widest text-[#141110]/55 uppercase block pt-0.5">
                    {row.label}
                  </span>
                </div>

                <!-- Right Sub-col: Title/Value + Subtitle Description -->
                <div class="sm:col-span-8 space-y-1.5">
                  <div class="flex flex-wrap items-baseline gap-2.5">
                    <h3 class="text-xl sm:text-2xl font-bold font-sans text-[#141110] tracking-tight leading-snug">
                      {row.value}
                    </h3>
                    {row.badge && (
                      <span class="px-2 py-0.5 bg-[#141110] text-[#d8c39e] text-[9px] font-mono-tag font-bold uppercase tracking-wider">
                        {row.badge}
                      </span>
                    )}
                  </div>
                  <p class="text-xs sm:text-sm text-[#141110]/70 font-light leading-relaxed font-sans">
                    {row.desc}
                  </p>
                </div>

              </div>
            ))}
          </div>

        </div>

      </div>

    </section>

    <!-- ========================================================================= -->
    <!-- 3. STICKY HORIZONTAL SCROLL PREVIEW GALLERY (1:1 GOUNCHARTED PREVIEW)     -->
    <!-- ========================================================================= -->
    <EventPreviewGallery venue={venue} />

    <!-- ========================================================================= -->
    <!-- 4. STICKY DESCRIPTION STACK (DUAL STICKY: HEADER + STACKING CARDS DECK)   -->
    <!-- ========================================================================= -->
    <section class="py-20 sm:py-28 px-6 sm:px-10 lg:px-14 xl:px-20 max-w-[1680px] mx-auto border-t border-[#141110]/15 relative">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start relative">
        
        <!-- Left Column: Sticky Editorial Header (Identik: — THE METHOD / How a place...) -->
        <div class="lg:col-span-5 space-y-4 lg:sticky lg:top-28 self-start">
          
          <span class="text-xs font-mono-tag text-[#141110]/50 tracking-[0.26em] uppercase block">
            — {venue.stackSection?.kicker || "THE METHOD"}
          </span>

          <h2 class="text-3xl sm:text-5xl lg:text-[52px] font-light tracking-tight text-[#141110] font-sans leading-[1.08] whitespace-pre-line">
            {venue.stackSection?.headline}
          </h2>

          <span class="text-xs font-mono-tag tracking-widest text-[#141110]/50 uppercase block pt-1">
            {venue.stackSection?.subKicker}
          </span>

          <p class="text-sm sm:text-base text-[#141110]/70 font-sans leading-relaxed max-w-md pt-2">
            {venue.stackSection?.narrative}
          </p>

          <div class="pt-4 hidden lg:flex items-center gap-2 text-xs font-mono-tag text-[#141110]/40 uppercase tracking-widest">
            <span class="inline-block w-1.5 h-1.5 bg-[#141110] animate-pulse"></span>
            <span>GULIR UNTUK MELIHAT STACK</span>
          </div>

        </div>

        <!-- Right Column: Sticky Stacking Description Cards Deck -->
        <div id="event-stack-container" class="lg:col-span-7 relative flex flex-col pb-10">
          {venue.stackSection?.items.map((item, idx) => {
            const totalItems = venue.stackSection.items.length;
            const isLast = idx === totalItems - 1;
            // Spacing between cards to allow smooth sliding overlay
            const spacingMb = totalItems <= 3 ? '24vh' : '18vh';

            return (
              <div 
                id={`event-stack-wrapper-${idx}`}
                class="event-stack-wrapper w-full sticky will-change-transform"
                style={`top: calc(5.5rem + ${idx * 26}px); z-index: ${10 + idx}; margin-bottom: ${isLast ? '2rem' : spacingMb};`}
                data-index={idx}
              >
                <!-- Stacking Physical Card with Solid Warm Stone Background -->
                <article 
                  class="event-stack-card relative w-full bg-[#f4efe6] border border-[#141110]/20 p-6 sm:p-9 lg:p-10 shadow-[0_-10px_35px_rgba(0,0,0,0.06)] transition-all duration-300 origin-top flex flex-col justify-between space-y-4 sm:space-y-5 select-none"
                >
                  <!-- Top Bar: Index & Tag Badge -->
                  <div class="flex items-center justify-between border-b border-[#141110]/10 pb-3">
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-mono-tag font-bold text-[#141110]/50 tracking-widest uppercase">
                        {item.index}
                      </span>
                      <span class="text-xs font-mono-tag text-[#141110]/30">•</span>
                      <span class="text-[10px] font-mono-tag tracking-wider text-[#141110]/60 uppercase">
                        SEKTOR {venue.index} // SPEC 0{idx + 1}
                      </span>
                    </div>

                    {item.tag && (
                      <span class="text-[10px] sm:text-[11px] font-mono-tag font-bold tracking-wider text-[#141110] uppercase bg-[#141110]/5 px-3 py-1 border border-[#141110]/15">
                        {item.tag}
                      </span>
                    )}
                  </div>

                  <!-- Editorial Heading & Description -->
                  <div class="space-y-2.5">
                    <h3 class="text-2xl sm:text-3xl font-medium tracking-tight text-[#141110] leading-snug font-sans">
                      {item.title}
                    </h3>
                    <p class="text-sm sm:text-base text-[#141110]/75 font-sans leading-relaxed">
                      {item.desc}
                    </p>
                  </div>

                  <!-- Feature Pills -->
                  {item.pills && (
                    <div class="pt-3 border-t border-[#141110]/10 flex flex-wrap items-center gap-2">
                      {item.pills.map((pill: string) => (
                        <span class="text-[11px] font-mono-tag text-[#141110]/70 bg-[#141110]/5 border border-[#141110]/15 px-3 py-1 uppercase tracking-wide">
                          {pill}
                        </span>
                      ))}
                    </div>
                  )}

                </article>
              </div>
            );
          })}
        </div>

      </div>

    </section>

    <!-- ========================================================================= -->
    <!-- 4. KETENTUAN & ANJURAN RESERVASI (CLEAN DIRECT-TO-POINT BANNER)           -->
    <!-- ========================================================================= -->
    <section class="py-12 sm:py-16 px-6 sm:px-10 lg:px-14 xl:px-20 max-w-[1680px] mx-auto border-t border-[#141110]/15">
      <div class="p-6 sm:p-8 border border-[#141110]/20 flex flex-col md:flex-row md:items-center justify-between gap-6 bg-transparent">
        <div class="space-y-2.5 max-w-2xl">
          <span class="text-xs font-mono-tag font-bold uppercase tracking-wider text-[#141110] block">
            ⓘ KETENTUAN & ANJURAN RESERVASI:
          </span>
          <ul class="space-y-1.5 text-xs text-[#141110]/75 font-sans">
            {venue.guidelines.map((rule: string) => (
              <li class="flex items-start gap-2.5">
                <span class="text-[#141110]/40 font-mono-tag mt-0.5">•</span>
                <span>{rule}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="shrink-0">
          <a 
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 px-6 py-3.5 bg-[#141110] hover:bg-black text-[#f4efe6] font-mono-tag text-xs font-bold uppercase tracking-wider transition-all duration-200 border border-[#141110]"
          >
            <span>Konsultasi Tanggal Sesi</span>
            <span class="text-sm transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-0.5">↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 5. PREVIOUS / NEXT VENUE NAVIGATION (1:1 GOUNCHARTED)                     -->
    <!-- ========================================================================= -->
    <nav class="border-t border-[#141110]/15 bg-[#141110] text-[#f4efe6] px-6 sm:px-10 lg:px-14 xl:px-20 py-10 sm:py-14 select-none">
      <div class="max-w-[1680px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 items-center">
        
        <!-- Prev Link -->
        <a 
          href={`/event/${prevVenue.id}`}
          class="group flex flex-col gap-2 p-5 sm:p-7 border border-white/10 hover:border-white/30 transition-all duration-300 bg-white/[0.02] hover:bg-white/[0.05]"
        >
          <div class="flex items-center gap-2 text-xs font-mono-tag text-white/50 uppercase tracking-widest">
            <span>←</span>
            <span>VENUE SEBELUMNYA</span>
          </div>
          <div>
            <span class="text-xs font-mono-tag text-[#d8c39e] uppercase block">{prevVenue.category}</span>
            <span class="text-xl sm:text-2xl font-bold font-sans uppercase tracking-tight text-white group-hover:text-[#d8c39e] transition-colors">
              {prevVenue.name}
            </span>
          </div>
        </a>

        <!-- Next Link -->
        <a 
          href={`/event/${nextVenue.id}`}
          class="group flex flex-col gap-2 p-5 sm:p-7 border border-white/10 hover:border-white/30 transition-all duration-300 bg-white/[0.02] hover:bg-white/[0.05] text-left md:text-right"
        >
          <div class="flex items-center md:justify-end gap-2 text-xs font-mono-tag text-white/50 uppercase tracking-widest">
            <span>VENUE BERIKUTNYA</span>
            <span>→</span>
          </div>
          <div>
            <span class="text-xs font-mono-tag text-[#d8c39e] uppercase block">{nextVenue.category}</span>
            <span class="text-xl sm:text-2xl font-bold font-sans uppercase tracking-tight text-white group-hover:text-[#d8c39e] transition-colors">
              {nextVenue.name}
            </span>
          </div>
        </a>

      </div>
    </nav>

  </main>

  <!-- Global Footer -->
  <FooterCTA />
</Layout>

<style>
  .font-mono-tag {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  }
</style>

<!-- ========================================================================= -->
<!-- PARALLAX TRANSLATE-Y ENGINE FOR HERO (GPU Hardware-Accelerated)          -->
<!-- ========================================================================= -->
<script is:inline>
  function initEventDetailHeroParallax() {
    const heroSection = document.getElementById('event-detail-hero');
    const parallaxLayer = document.getElementById('hero-parallax-layer');
    if (!heroSection || !parallaxLayer) return;

    let isTicking = false;

    function updateParallax() {
      const scrollY = window.scrollY;
      const heroHeight = heroSection.offsetHeight;

      if (scrollY <= heroHeight + 50) {
        const translateY = scrollY * 0.32;
        parallaxLayer.style.transform = `translate3d(0, ${translateY.toFixed(1)}px, 0)`;
      }
    }

    function handleScroll() {
      if (!isTicking) {
        requestAnimationFrame(() => {
          updateParallax();
          isTicking = false;
        });
        isTicking = true;
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    updateParallax();
  }

  function initAll() {
    initEventDetailHeroParallax();
    initEventCardStack();
  }

  // Tactile depth stacking controller for description cards
  function initEventCardStack() {
    const container = document.getElementById('event-stack-container');
    const wrappers = document.querySelectorAll('.event-stack-wrapper');
    if (!container || !wrappers.length) return;

    // Smooth click on any visible stacked header to scroll smoothly to that card
    wrappers.forEach((wrapper, idx) => {
      wrapper.addEventListener('click', (e) => {
        const isLink = e.target.closest('a');
        if (isLink) return;

        // @ts-ignore
        const lenis = window.__lenis;
        const targetTop = wrapper.offsetTop - (idx * 26) - 90;

        if (lenis) {
          lenis.scrollTo(wrapper, { offset: -(idx * 26) - 90, duration: 0.8 });
        } else {
          window.scrollTo({
            top: targetTop,
            behavior: 'smooth'
          });
        }
      });
    });

    // Tactile depth scroll handler: subtle scale & brightness on cards that are overlapped
    function onScrollStack() {
      wrappers.forEach((wrapper, idx) => {
        if (idx === wrappers.length - 1) return; // Don't scale the last card

        const nextWrapper = wrappers[idx + 1];
        if (!nextWrapper) return;

        const nextRect = nextWrapper.getBoundingClientRect();
        const wrapperRect = wrapper.getBoundingClientRect();
        const cardInner = wrapper.querySelector('.event-stack-card');
        if (!cardInner) return;

        if (nextRect.top <= wrapperRect.bottom) {
          const overlap = wrapperRect.bottom - nextRect.top;
          const maxOverlap = wrapperRect.height;
          const progress = Math.max(0, Math.min(1, overlap / (maxOverlap * 0.75)));

          const scale = 1 - progress * 0.035; // 1.0 -> 0.965
          const brightness = 1 - progress * 0.12; // 1.0 -> 0.88

          cardInner.style.transform = `scale(${scale.toFixed(4)})`;
          cardInner.style.filter = `brightness(${brightness.toFixed(3)})`;
        } else {
          cardInner.style.transform = 'scale(1)';
          cardInner.style.filter = 'brightness(1)';
        }
      });
    }

    let isTicking = false;
    function handleScroll() {
      if (!isTicking) {
        requestAnimationFrame(() => {
          onScrollStack();
          isTicking = false;
        });
        isTicking = true;
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    onScrollStack();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
</script>

