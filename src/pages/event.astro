---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import EventSectorGrid from '../components/EventSectorGrid.astro';
import FooterCTA from '../components/FooterCTA.astro';
---

<Layout 
  title="Event, Wedding & Gathering — Jolotundo Glamping & Culture"
  description="Layanan venue pernikahan alam terbuka, sewa aula kaca ber-AC, dan paket outbound gathering korporat di ketinggian 800 MDPL Gunung Wilis."
  image="/images/facilities/event-hero.jpg"
>
  <!-- Floating Expanding Pill Navbar (GoUncharted Standard) -->
  <Navbar />

  <!-- Main Canvas: Warm Stone Background -->
  <main class="min-h-screen bg-[#f4efe6] text-[#141110] selection:bg-[#141110] selection:text-white">

    <!-- ========================================================================= -->
    <!-- FULLSCREEN EDITORIAL HERO (1:1 RIVER BREEZE STYLE)                        -->
    <!-- ========================================================================= -->
    <header 
      id="event-hero" 
      class="relative h-screen h-[100dvh] min-h-[100dvh] w-full flex flex-col justify-between overflow-hidden bg-[#141110] text-[#f4efe6] select-none"
    >
      <!-- Parallax Translate-Y Background Layer -->
      <div 
        id="event-hero-parallax-layer"
        class="absolute inset-x-0 w-full h-[125%] -top-[12.5%] pointer-events-none will-change-transform z-0"
        style="transform: translate3d(0, 0px, 0);"
      >
        <img 
          src="/images/event/gathering/gathering2.avif" 
          alt="Jolotundo Event, Glasshouse Hall & Outdoor Wedding Venue" 
          class="w-full h-full object-cover object-center scale-105"
          fetchpriority="high"
          loading="eager"
        />
        <!-- Atmospheric Vignettes / Dual Scrim for Editorial Typography Contrast -->
        <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/40 to-black/90 pointer-events-none"></div>
        <div class="absolute inset-0 bg-black/20 pointer-events-none"></div>
      </div>

      <!-- Top Spacer to clear floating pill navbar -->
      <div class="h-20 sm:h-28 shrink-0"></div>

      <!-- Center Display Typography (Pure River Breeze Clean Luxury) -->
      <div class="relative z-10 flex flex-col items-center justify-center text-center px-5 max-w-4xl mx-auto my-auto w-full py-4 sm:py-8">
        
        <!-- Subtle Monospaced Eyebrow Kicker -->
        <span class="text-[10px] sm:text-xs font-mono-tag tracking-[0.2em] sm:tracking-[0.28em] text-[#d8c39e] uppercase mb-3 sm:mb-5 block">
          — VENUES & GATHERINGS
        </span>

        <!-- Clean, Powerful & Elegant Title -->
        <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-normal tracking-[-0.03em] text-white leading-[1.02] sm:leading-[0.96] font-sans drop-shadow-lg">
          Event & Wedding.
        </h1>

        <!-- Simple, Clean & Poetic Subtitle -->
        <p class="text-xs sm:text-base md:text-lg font-sans text-white/80 max-w-md sm:max-w-xl mx-auto mt-3 sm:mt-5 drop-shadow leading-relaxed font-light">
          Tiga latar istimewa untuk pernikahan sakral di alam terbuka, aula kaca ber-AC, dan sinergi outbound korporat di sejuknya lereng Wilis.
        </p>

        <!-- Clean Subtle Action Links -->
        <div class="flex items-center gap-3 sm:gap-6 mt-6 sm:mt-10 text-[11px] sm:text-xs font-mono-tag tracking-wider uppercase">
          <a 
            href="https://wa.me/6282249829998?text=Halo%20Admin%20Jolotundo%2C%20saya%20ingin%20konsultasi%20venue%20event%20%2F%20gathering%20%2F%20wedding."
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 sm:px-5 py-2.5 sm:py-3 bg-[#d8c39e] hover:bg-white text-[#141110] font-bold transition-colors shadow-md flex items-center gap-1.5"
          >
            <span>Konsultasi Venue</span>
            <span>↗</span>
          </a>
          <a 
            href="#event-sectors" 
            class="px-3 py-2 text-white/80 hover:text-white transition-colors border-b border-white/40 pb-0.5 flex items-center gap-1"
          >
            <span>Jelajahi 3 Sektor</span>
            <span>↓</span>
          </a>
        </div>
      </div>

      <!-- Bottom Metadata Bar: Clean Single Row on Mobile, Full on Desktop -->
      <div class="relative z-10 w-full px-5 sm:px-12 lg:px-16 pb-4 sm:pb-8 pt-3 border-t border-white/15 bg-gradient-to-t from-black/85 via-black/40 to-transparent shrink-0">
        <div class="max-w-[1680px] mx-auto flex items-center justify-center gap-2 text-[10px] sm:text-xs font-mono-tag tracking-wider sm:tracking-widest uppercase text-white/70">
          
          <div class="flex items-center gap-2 sm:gap-6 text-white/60 shrink-0">
            <span class="hidden sm:inline">KAPASITAS HINGGA 500 TAMU</span>
            <span class="hidden sm:inline">•</span>
            <span>ELEVASI ±800 MDPL</span>
            <span>•</span>
            <span class="text-[#d8c39e] font-bold">INDOOR & OUTDOOR</span>
          </div>
        </div>
      </div>
    </header>

    <!-- ========================================================================= -->
    <!-- 2. THE THREE EVENT SECTORS (1:1 GOUNCHARTED ASYMMETRIC ZIG-ZAG GRID)     -->
    <!-- ========================================================================= -->
    <EventSectorGrid />

    <!-- ========================================================================= -->
    <!-- 3. FOOTER CONCIERGE CTA                                                   -->
    <!-- ========================================================================= -->
    <FooterCTA />

  </main>
</Layout>

<style>
  /* Monospaced tag font helper */
  .font-mono-tag {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  }
</style>

<!-- ========================================================================= -->
<!-- JAVASCRIPT: HERO PARALLAX TRANSLATE-Y ENGINE                              -->
<!-- ========================================================================= -->
<script is:inline>
  function initEventHeroParallax() {
    const heroSection = document.getElementById('event-hero');
    const parallaxLayer = document.getElementById('event-hero-parallax-layer');
    if (!heroSection || !parallaxLayer) return;

    let isTicking = false;

    function updateHeroParallax() {
      const scrollY = window.scrollY;
      const heroHeight = heroSection.offsetHeight;

      if (scrollY <= heroHeight + 50) {
        const translateY = scrollY * 0.32;
        parallaxLayer.style.transform = `translate3d(0, ${translateY.toFixed(1)}px, 0)`;
      }
    }

    function handleScroll() {
      if (!isTicking) {
        requestAnimationFrame(() => {
          updateHeroParallax();
          isTicking = false;
        });
        isTicking = true;
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    updateHeroParallax();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEventHeroParallax);
  } else {
    initEventHeroParallax();
  }
</script>
