---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import FooterCTA from '../../components/FooterCTA.astro';
import CampPreviewGallery from '../../components/CampPreviewGallery.astro';
import accommodations from '../../data/accommodations.json';
import siteData from '../../data/siteData.json';

export async function getStaticPaths() {
  const paths = accommodations.map((camp, idx) => {
    const prevCamp = idx > 0 ? accommodations[idx - 1] : accommodations[accommodations.length - 1];
    const nextCamp = idx < accommodations.length - 1 ? accommodations[idx + 1] : accommodations[0];
    return {
      params: { id: camp.id },
      props: { camp, prevCamp, nextCamp }
    };
  });

  // Alias pinus-camp-plus so existing URLs or bookmarks render seamlessly
  const pinusCamp = accommodations.find(c => c.id === 'pinus-camp');
  if (pinusCamp) {
    const prevCamp = accommodations.find(c => c.id === 'river-camp') || accommodations[0];
    const nextCamp = accommodations.find(c => c.id === 'camping-ground') || accommodations[accommodations.length - 1];
    paths.push({
      params: { id: 'pinus-camp-plus' },
      props: { camp: pinusCamp, prevCamp, nextCamp }
    });
  }

  return paths;
}

const { camp, prevCamp, nextCamp } = Astro.props;

// Flag specific accommodation types for tailored presentation
const isPinus = camp.id === 'pinus-camp' || camp.id === 'pinus-camp-plus';
const isIndian = camp.id === 'indian-camp';

// Determine best background image for the hero
const heroImage = camp.editorialImage || camp.image;
const pills = camp.pills || [camp.setting, camp.elevation || "±800 MDPL", camp.tier, `Kapasitas ${camp.capacity}`];

// SEO: Map reliable .jpg Open Graph previews & handle alias canonical
const ogImageMap: Record<string, string> = {
  "deluxe-camp": "/images/accommodations/deluxe-camp-new.jpg",
  "superior-camp": "/images/accommodations/superior-camp-new.jpg",
  "korean-glamping": "/images/accommodations/korean-glamping-editorial.jpg",
  "indian-camp": "/images/hero.jpg",
  "river-camp": "/images/accommodations/river-camp-editorial.jpg",
  "pinus-camp": "/images/accommodations/pinus-camp-plus-new.jpg",
  "camping-ground": "/images/accommodations/camping-ground-new.jpg"
};
const isAliasRoute = Astro.params.id === 'pinus-camp-plus';
const siteBase = (Astro.site ? Astro.site.toString() : 'https://jolotundo.vercel.app').replace(/\/$/, '');
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Beranda", "item": `${siteBase}/` },
    { "@type": "ListItem", "position": 2, "name": "Akomodasi", "item": `${siteBase}/akomodasi` },
    { "@type": "ListItem", "position": 3, "name": camp.name, "item": `${siteBase}/akomodasi/${camp.id}` }
  ]
};
---

<Layout 
  title={`${camp.name} — Jolotundo Glamping & Edupark`}
  description={`${camp.name} di Jolotundo Glamping & Edupark. ${camp.headline || camp.tagline}. Kapasitas ${camp.capacity}, ${camp.setting}.`}
  image={ogImageMap[camp.id] || "/images/hero.jpg"}
  canonical={`/akomodasi/${camp.id}`}
  noindex={isAliasRoute}
  preloadHero={heroImage}
  schema={breadcrumbSchema}
>
  <!-- Floating Expanding Capsule Navbar -->
  <Navbar />

  <main class="min-h-screen bg-[#f4efe6] text-[#141110] selection:bg-[#141110] selection:text-white">

    <!-- ========================================================================= -->
    <!-- 1. GOUNCHARTED 1:1 CINEMATIC HERO (EDGE-TO-EDGE WITH PARALLAX TRANSLATE-Y)-->
    <!-- ========================================================================= -->
    <section 
      id="camp-hero" 
      class="relative w-full h-screen min-h-[640px] max-h-[1100px] overflow-hidden bg-[#141110] text-[#f4efe6] flex flex-col justify-between select-none"
    >
      
      <!-- Hardware-Accelerated Parallax Image Layer (Taller than viewport for smooth Translate-Y) -->
      <div 
        id="hero-parallax-layer" 
        class="absolute inset-x-0 w-full h-[135%] -top-[17.5%] will-change-transform pointer-events-none"
        style="transform: translate3d(0, 0px, 0);"
      >
        <img 
          src={heroImage} 
          alt={`${camp.name} - Jolotundo Glamping`}
          class="w-full h-full object-cover object-center"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Contrast Gradients (1:1 with GoUncharted: Soft upper vignette, clear deep lower gradient) -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-transparent pointer-events-none z-0"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/35 to-transparent pointer-events-none z-0"></div>

      <!-- Top Spacer for Navbar -->
      <div class="relative z-10 w-full pt-28 sm:pt-36"></div>

      <!-- CENTER DISPLAY TYPOGRAPHY (1:1 GoUncharted DENMARK / FAROE ISLANDS Style) -->
      <div class="relative z-10 flex flex-col items-center justify-center text-center px-6 max-w-6xl mx-auto my-auto w-full">
        
        <!-- Small Centered Eyebrow Kicker (DENMARK style) -->
        <span class="text-xs sm:text-sm md:text-base font-mono-tag tracking-[0.3em] sm:tracking-[0.4em] text-[#d8c39e] uppercase mb-4 sm:mb-6 drop-shadow-md">
          {camp.setting || "BAJULAN // ±800 MDPL"}
        </span>

        <!-- Giant Bold Display Headline (FAROE ISLANDS style) -->
        <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-[96px] font-extrabold uppercase tracking-tight text-white leading-none font-sans drop-shadow-2xl">
          {camp.name}
        </h1>

        <!-- Short Sub-tagline -->
        <p class="text-xs sm:text-base font-sans text-white/80 max-w-xl mx-auto mt-4 sm:mt-6 drop-shadow leading-relaxed font-light hidden sm:block">
          {camp.tagline}
        </p>
      </div>

      <!-- BOTTOM METADATA & CTA ROW (1:1 GoUncharted Hairline Divider + Specs + Action Button) -->
      <div class="relative z-10 w-full">
        
        <!-- Thin Hairline Divider Line (Exact GoUncharted divider) -->
        <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-14 xl:px-20">
          <div class="w-full border-t border-white/20"></div>
        </div>

        <!-- Metadata Columns + CTA Button -->
        <div class="max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-14 xl:px-20 py-6 sm:py-8 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
          
          <!-- Left Specs Group (SEASON, KAPASITAS, INDEX, ELEVASI) -->
          <div class="flex flex-wrap items-center gap-6 sm:gap-10 text-xs sm:text-sm font-mono-tag">
            
            <div class="flex items-center gap-2.5">
              <span class="text-white/50 uppercase tracking-widest text-[10px] sm:text-xs">SEASON</span>
              <span class="text-white font-bold tracking-wider">ALL YEAR</span>
            </div>

            <div class="flex items-center gap-2.5">
              <span class="text-white/50 uppercase tracking-widest text-[10px] sm:text-xs">KAPASITAS</span>
              <span class="text-white font-bold tracking-wider">{camp.capacity}</span>
            </div>

            <div class="flex items-center gap-2.5">
              <span class="text-white/50 uppercase tracking-widest text-[10px] sm:text-xs">INDEX</span>
              <span class="text-[#d8c39e] font-bold tracking-wider">{camp.index} // 07</span>
            </div>

            <div class="hidden md:flex items-center gap-2.5">
              <span class="text-white/50 uppercase tracking-widest text-[10px] sm:text-xs">ELEVASI</span>
              <span class="text-white font-bold tracking-wider">{camp.elevation || "±800 MDPL"}</span>
            </div>

            <div class="hidden lg:flex items-center gap-2.5">
              <span class="text-white/50 uppercase tracking-widest text-[10px] sm:text-xs">TIER</span>
              <span class="text-[#d8c39e] font-bold tracking-wider">{camp.tier}</span>
            </div>

          </div>

          <!-- Right Action Button: Pesan Tenda (Direct Online Booking) -->
          <div class="flex items-center gap-3">
            <a 
              href="https://jolotundo.netlify.app/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-between sm:justify-center gap-3 px-6 sm:px-8 py-3.5 bg-black/80 hover:bg-black text-[#f4efe6] backdrop-blur-md border border-white/25 font-mono-tag text-xs font-bold uppercase tracking-wider transition-all duration-200 hover:border-white shadow-2xl w-full sm:w-auto"
            >
              <span>Pesan Tenda Sekarang</span>
              <span>↗</span>
            </a>
          </div>

        </div>

      </div>

    </section>

    <!-- ========================================================================= -->
    <!-- 2. EDITORIAL OVERVIEW & ARCHITECTURAL SPECS (Split Layout)                -->
    <!-- ========================================================================= -->
    <section class="py-16 sm:py-24 px-6 sm:px-10 lg:px-14 xl:px-20 max-w-[1680px] mx-auto border-b border-[#141110]/15">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 xl:gap-20 items-start">
        
        <!-- Left Column: Big Narrative Statement & Description (7 Cols) -->
        <div class="lg:col-span-7 flex flex-col gap-6 sm:gap-8">
          
          <div class="flex items-center gap-2 text-xs font-mono-tag text-[#141110]/70 tracking-widest uppercase">
            <span class="w-1.5 h-1.5 bg-[#141110]"></span>
            <span>OVERVIEW // {camp.tier}</span>
          </div>

          <!-- Large Poetic Statement -->
          <blockquote class="text-2xl sm:text-3xl lg:text-4xl font-normal text-[#141110] leading-snug tracking-tight font-sans">
            "{camp.editorialTagline || camp.headline || camp.tagline}"
          </blockquote>

          <p class="text-sm sm:text-base text-[#141110]/80 font-sans leading-relaxed font-light">
            Dikelilingi oleh ribuan pohon pinus purba di lereng Gunung Wilis pada ketinggian {camp.elevation || "±800 MDPL"}, {camp.name} dirancang untuk memberikan ketenangan batin yang mendalam. Udara sejuk pegunungan, semilir angin pinus, serta alunan aliran air alami menciptakan suasana menginap yang eksklusif dan autentik.
          </p>

          <!-- 4 Key Specifications Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 py-6 border-y border-[#141110]/15">
            <div>
              <span class="text-[10px] font-mono-tag text-[#141110]/50 uppercase tracking-widest block mb-1">
                KAPASITAS
              </span>
              <span class="text-sm sm:text-base font-bold font-sans text-[#141110] block">
                {camp.capacity}
              </span>
            </div>

            <div>
              <span class="text-[10px] font-mono-tag text-[#141110]/50 uppercase tracking-widest block mb-1">
                SETTING ALAM
              </span>
              <span class="text-sm sm:text-base font-bold font-sans text-[#141110] block">
                {camp.setting}
              </span>
            </div>

            <div>
              <span class="text-[10px] font-mono-tag text-[#141110]/50 uppercase tracking-widest block mb-1">
                WAKTU CHECK-IN
              </span>
              <span class="text-sm sm:text-base font-bold font-sans text-[#141110] block">
                {camp.checkIn || "14.00 WIB"}
              </span>
            </div>

            <div>
              <span class="text-[10px] font-mono-tag text-[#141110]/50 uppercase tracking-widest block mb-1">
                WAKTU CHECK-OUT
              </span>
              <span class="text-sm sm:text-base font-bold font-sans text-[#141110] block">
                {camp.checkOut || "12.00 WIB"}
              </span>
            </div>
          </div>

          <!-- Tag Pills -->
          <div class="flex flex-wrap gap-2">
            {pills.map((pill) => (
              <span class="text-xs font-mono-tag px-3 py-1 bg-[#141110]/5 border border-[#141110]/15 text-[#141110] uppercase tracking-wider">
                {pill}
              </span>
            ))}
          </div>

        </div>

        <!-- Right Column: Pricing & Concierge Booking Card (5 Cols) -->
        <div class="lg:col-span-5 bg-[#141110] text-[#f4efe6] p-6 sm:p-8 lg:p-10 border border-[#141110] shadow-2xl flex flex-col justify-between gap-6 lg:top-28">
          
          <div>
            <div class="flex items-center justify-between pb-4 border-b border-white/15 text-xs font-mono-tag">
              <span class="text-[#d8c39e] tracking-widest uppercase font-bold">[ TARIF MENGINAP ]</span>
              <span class="text-white/60 uppercase">RESMI JOLOTUNDO</span>
            </div>

            <!-- Price Breakdown (Conditional Multi-Tier for Pinus & Indian, Default for Others) -->
            {isPinus ? (
              <div class="flex flex-col gap-4 py-5 border-b border-white/15">
                <!-- Option 1: Pinus Camp Reguler -->
                <div class="p-3.5 bg-white/[0.04] border border-white/10 flex flex-col gap-2">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-mono-tag text-white font-bold tracking-wider uppercase">01. PINUS CAMP (REGULER)</span>
                    <span class="text-[10px] font-mono-tag text-white/50 uppercase tracking-widest px-2 py-0.5 bg-white/10">Hutan Pinus</span>
                  </div>
                  <div class="grid grid-cols-2 gap-3 pt-1 border-t border-white/10">
                    <div>
                      <span class="text-[10px] font-mono-tag text-white/50 uppercase block">WEEKDAY (SEN–KAM)</span>
                      <span class="text-lg sm:text-xl font-bold font-mono-tag text-white tracking-tight">Rp 250.000</span>
                      <span class="text-[9px] font-mono-tag text-white/40 block">/ malam</span>
                    </div>
                    <div>
                      <span class="text-[10px] font-mono-tag text-[#d8c39e] uppercase block font-semibold">WEEKEND (JUM–MIN)</span>
                      <span class="text-lg sm:text-xl font-bold font-mono-tag text-[#d8c39e] tracking-tight">Rp 350.000</span>
                      <span class="text-[9px] font-mono-tag text-[#d8c39e]/50 block">/ malam</span>
                    </div>
                  </div>
                </div>

                <!-- Option 2: Pinus Camp Plus -->
                <div class="p-3.5 bg-white/[0.04] border border-[#d8c39e]/40 flex flex-col gap-2">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-mono-tag text-[#d8c39e] font-bold tracking-wider uppercase">02. PINUS CAMP PLUS</span>
                    <span class="text-[10px] font-mono-tag text-[#d8c39e] uppercase tracking-widest px-2 py-0.5 bg-[#d8c39e]/15 border border-[#d8c39e]/30">Tepi Sungai</span>
                  </div>
                  <p class="text-[11px] text-white/70 font-sans leading-tight">
                    Tenda 40–51 tepat di sempadan aliran sungai kecil dengan alunan gemericik air alami.
                  </p>
                  <div class="grid grid-cols-2 gap-3 pt-1 border-t border-white/10">
                    <div>
                      <span class="text-[10px] font-mono-tag text-white/50 uppercase block">WEEKDAY (SEN–KAM)</span>
                      <span class="text-lg sm:text-xl font-bold font-mono-tag text-white tracking-tight">Rp 300.000</span>
                      <span class="text-[9px] font-mono-tag text-white/40 block">/ malam</span>
                    </div>
                    <div>
                      <span class="text-[10px] font-mono-tag text-[#d8c39e] uppercase block font-semibold">WEEKEND (JUM–MIN)</span>
                      <span class="text-lg sm:text-xl font-bold font-mono-tag text-[#d8c39e] tracking-tight">Rp 400.000</span>
                      <span class="text-[9px] font-mono-tag text-[#d8c39e]/50 block">/ malam</span>
                    </div>
                  </div>
                </div>
                
                <span class="text-[10px] font-mono-tag text-white/50 italic tracking-tight">
                  *Fasilitas & benefit keduanya identik, perbedaan terletak pada lokasi tepi aliran sungai.
                </span>
              </div>
            ) : isIndian ? (
              <div class="flex flex-col gap-4 py-5 border-b border-white/15">
                <!-- Option 1: Kapasitas 3 Orang -->
                <div class="p-3.5 bg-white/[0.04] border border-white/10 flex flex-col gap-2">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-mono-tag text-white font-bold tracking-wider uppercase">KAPASITAS 3 ORANG</span>
                    <span class="text-[10px] font-mono-tag text-white/50 uppercase tracking-widest px-2 py-0.5 bg-white/10">3 Tamu</span>
                  </div>
                  <div class="flex items-baseline justify-between pt-1 border-t border-white/10">
                    <div>
                      <span class="text-[10px] font-mono-tag text-white/50 uppercase block">TARIF SEMUA HARI</span>
                      <span class="text-2xl sm:text-3xl font-bold font-mono-tag text-white tracking-tight">Rp 600.000</span>
                    </div>
                    <span class="text-xs font-mono-tag text-white/40 uppercase">/ Malam</span>
                  </div>
                </div>

                <!-- Option 2: Kapasitas 6 Orang -->
                <div class="p-3.5 bg-white/[0.04] border border-[#d8c39e]/40 flex flex-col gap-2">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-mono-tag text-[#d8c39e] font-bold tracking-wider uppercase">KAPASITAS 6 ORANG</span>
                    <span class="text-[10px] font-mono-tag text-[#d8c39e] uppercase tracking-widest px-2 py-0.5 bg-[#d8c39e]/15 border border-[#d8c39e]/30">6 Tamu</span>
                  </div>
                  <div class="flex items-baseline justify-between pt-1 border-t border-white/10">
                    <div>
                      <span class="text-[10px] font-mono-tag text-[#d8c39e] uppercase block font-semibold">TARIF SEMUA HARI</span>
                      <span class="text-2xl sm:text-3xl font-bold font-mono-tag text-[#d8c39e] tracking-tight">Rp 900.000</span>
                    </div>
                    <span class="text-xs font-mono-tag text-white/40 uppercase">/ Malam</span>
                  </div>
                </div>

                <div class="flex items-center justify-between text-[10px] font-mono-tag text-white/60 pt-1">
                  <span>IN: 14.00 WIB — OUT: 12.00 WIB</span>
                  <span class="italic text-white/40">*Belum termasuk pajak</span>
                </div>
              </div>
            ) : (
              <div class="flex flex-col gap-4 py-6 border-b border-white/15">
                <div class="flex items-baseline justify-between">
                  <div>
                    <span class="text-xs font-mono-tag text-white/50 uppercase block">WEEKDAY (SEN–KAM)</span>
                    <span class="text-2xl sm:text-3xl font-bold font-mono-tag text-white tracking-tight">
                      {camp.priceWeekday}
                    </span>
                  </div>
                  <span class="text-[11px] font-mono-tag text-white/40 uppercase">/ Malam</span>
                </div>

                <div class="flex items-baseline justify-between pt-2">
                  <div>
                    <span class="text-xs font-mono-tag text-[#d8c39e] uppercase block font-semibold">WEEKEND (JUM–MIN)</span>
                    <span class="text-2xl sm:text-3xl font-bold font-mono-tag text-[#d8c39e] tracking-tight">
                      {camp.priceWeekend}
                    </span>
                  </div>
                  <span class="text-[11px] font-mono-tag text-white/40 uppercase">/ Malam</span>
                </div>
              </div>
            )}

            <!-- Perks Summary -->
            <ul class="flex flex-col gap-2 py-4 text-xs font-mono-tag text-white/75">
              <li class="flex items-center gap-2">
                <span class="text-emerald-400">✓</span>
                <span>Termasuk tiket masuk wisata & parkir kendaraan</span>
              </li>
              {isIndian ? (
                <>
                  <li class="flex items-center gap-2">
                    <span class="text-emerald-400">✓</span>
                    <span>Termasuk kompor, cooking set, kettle & panggang BBQ</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="text-emerald-400">✓</span>
                    <span>Set meja, kursi santai outdoor & lampu hias gantung</span>
                  </li>
                </>
              ) : (
                <>
                  <li class="flex items-center gap-2">
                    <span class="text-emerald-400">✓</span>
                    <span>Termasuk sarapan pagi (breakfast)</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="text-emerald-400">✓</span>
                    <span>Akses 24 jam ke fasilitas umum & resto</span>
                  </li>
                </>
              )}
            </ul>
          </div>

          <!-- Direct Booking Action: Redirect ke https://jolotundo.netlify.app/ -->
          <div class="flex flex-col gap-2.5">
            <a 
              href="https://jolotundo.netlify.app/"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-4 bg-[#f4efe6] hover:bg-white text-[#141110] font-mono-tag text-xs font-bold uppercase tracking-wider text-center transition-all duration-200 border border-[#f4efe6] hover:shadow-[0_10px_25px_rgba(244,239,230,0.25)] flex items-center justify-center gap-2"
            >
              <span>Pesan Tenda Sekarang (Online)</span>
              <span>↗</span>
            </a>
            
            <a 
              href={`https://wa.me/${siteData.brand.whatsapp}?text=${encodeURIComponent(
                isPinus
                  ? `Halo Admin Jolotundo, saya ingin konsultasi ketersediaan dan reservasi *Pinus Camp / Pinus Camp Plus*.`
                  : isIndian
                  ? `Halo Admin Jolotundo, saya ingin konsultasi ketersediaan dan reservasi *Indian Camp* (Kapasitas 3 / 6 Orang).`
                  : `Halo Admin Jolotundo, saya ingin konsultasi ketersediaan dan reservasi *${camp.name}*.`
              )}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[11px] font-mono-tag text-white/60 hover:text-[#d8c39e] text-center tracking-wider underline underline-offset-4 py-1 transition-colors block"
            >
              Atau konsultasi via WhatsApp Concierge ↗
            </a>
            
            <span class="text-[10px] font-mono-tag text-white/40 text-center tracking-wider block">
              [ SISTEM RESERVASI ONLINE RESMI JOLOTUNDO ]
            </span>
          </div>

        </div>

      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 3. STICKY HORIZONTAL SCROLL PREVIEW GALLERY (1:1 GoUncharted Slider)      -->
    <!-- ========================================================================= -->
    <CampPreviewGallery camp={camp} />

    <!-- ========================================================================= -->
    <!-- 4. FASILITAS & AMENITIES (1:1 GOUNCHARTED "WHAT'S ON THE GROUND" STYLE)   -->
    <!-- ========================================================================= -->
    <section id="fasilitas" class="py-20 sm:py-28 px-6 sm:px-10 lg:px-14 xl:px-20 max-w-[1680px] mx-auto border-b border-[#141110]/15">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 xl:gap-24 items-start">
        
        <!-- Left Column: 1:1 GoUncharted Kicker + Headline + Narrative (5 Cols) -->
        <div class="lg:col-span-5 flex flex-col gap-5 sm:gap-6 lg:top-28">
          
          <!-- Top Kicker (1:1 with "— WHAT'S ON THE GROUND") -->
          <div class="flex items-center gap-2 text-xs font-mono-tag text-[#141110]/70 tracking-[0.2em] uppercase">
            <span class="text-[#141110] font-bold">—</span>
            <span>WHAT'S ON THE GROUND</span>
          </div>

          <!-- Main Headline (1:1 with "Everything on the ground.") -->
          <h2 class="text-3xl sm:text-5xl lg:text-[52px] font-bold tracking-tight text-[#141110] font-sans leading-[1.08]">
