---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import AboutManifesto from '../components/AboutManifesto.astro';
import AccommodationTeaser from '../components/AccommodationTeaser.astro';
import ActivitiesSticky from '../components/ActivitiesSticky.astro';
import FacilitiesSticky from '../components/FacilitiesSticky.astro';
import ReviewsGoogle from '../components/ReviewsGoogle.astro';
import FaqSection from '../components/FaqSection.astro';
import FooterCTA from '../components/FooterCTA.astro';
---

<Layout title="Jolotundo Glamping & Edupark — Ekowisata Pegunungan Nganjuk">
	<!-- Floating Expanding Pill Navbar (GoUncharted Model) -->
	<Navbar />

	<main class="relative z-0">
		<!-- Hero Section with Sinking Parallax -->
		<Hero />

		<!-- Section 01: About & Manifesto (GoUncharted Editorial Style + BUMN Partner Rail) -->
		<AboutManifesto />

		<!-- Section 02: Koleksi Akomodasi Unggulan (Asymmetric Editorial Grid, Zero Rounded) -->
		<AccommodationTeaser />

		<!-- Section 03: Wana Wisata & Edupark (Full-Width Sticky Scrollytelling, GoUncharted 1:1) -->
		<ActivitiesSticky />

		<!-- Section 04: Fasilitas & Kuliner Pegunungan (Sticky Split-Scroll 1:1 GoUncharted) -->
		<FacilitiesSticky />

		<!-- Section 05: Ulasan Pengunjung Google Maps (Verified 4.9 Rating & Social Proof) -->
		<ReviewsGoogle />

		<!-- Section 06: Questions, Answered (GoUncharted 1:1 Luxury Editorial FAQ) -->
		<FaqSection />
	</main>

	<!-- Section 07: Final CTA & Luxury Editorial Footer with Pure Translate-Y Parallax -->
	<FooterCTA />
</Layout>
